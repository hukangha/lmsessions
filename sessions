#!/usr/bin/env python3
"""List, remove or dump coding-agent sessions (Claude Code, Codex) for the current working directory.

To support another agent, subclass `Agent` and add an instance to `AGENTS`.
"""

import argparse
import json
import os
import select
import shutil
import sqlite3
import sys
import termios
import tty
from dataclasses import dataclass
from datetime import datetime
from fnmatch import fnmatch
from pathlib import Path


@dataclass
class Session:
    agent: str
    id: str
    mtime: float
    size: int
    msgs: int
    title: str
    path: Path


Turn = tuple[str, str, str]  # (role, timestamp, body)


def file_stats(path: Path) -> tuple[int, int]:
    """(size, line count) of a transcript file; zeros if it is missing."""
    try:
        size = path.stat().st_size
        with path.open("rb") as fh:
            return size, sum(1 for _ in fh)
    except FileNotFoundError:
        return 0, 0


def read_jsonl(path: Path):
    with path.open() as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                yield json.loads(line)
            except json.JSONDecodeError:
                continue


def tool_marker(name: str, inp: dict) -> str:
    for k in ("description", "command", "file_path", "prompt", "query", "pattern", "cmd", "input"):
        v = inp.get(k)
        if v:
            v = " ".join(str(v).split())
            if len(v) > 100:
                v = v[:100] + "…"
            return f"    → {name}: {v}"
    return f"    → {name}"


class Agent:
    name: str

    def sessions(self, cwd: Path) -> list[Session]:
        raise NotImplementedError

    def remove(self, s: Session) -> None:
        raise NotImplementedError

    def transcript(self, s: Session) -> list[Turn]:
        """User text, assistant text and one-line tool markers, in order."""
        raise NotImplementedError


class ClaudeAgent(Agent):
    name = "claude"

    def sessions(self, cwd: Path) -> list[Session]:
        project_dir = Path.home() / ".claude" / "projects" / str(cwd).replace("/", "-")
        out = []
        for f in project_dir.glob("*.jsonl"):
            size, msgs = file_stats(f)
            out.append(Session(self.name, f.stem, f.stat().st_mtime, size, msgs, self.title(f), f))
        return out

    @staticmethod
    def title(path: Path) -> str:
        """Latest title for a session: a /rename custom title wins over the AI one."""
        custom = ai = ""
        for entry in read_jsonl(path):
            typ = entry.get("type")
            if typ == "custom-title":
                custom = entry.get("customTitle", "") or custom
            elif typ == "ai-title":
                ai = entry.get("aiTitle", "") or ai
        return custom or ai

    def remove(self, s: Session) -> None:
        s.path.unlink()

    def transcript(self, s: Session) -> list[Turn]:
        turns = []
        for rec in read_jsonl(s.path):
            typ = rec.get("type")
            if typ not in ("user", "assistant"):
                continue
            ts = (rec.get("timestamp") or "")[:19].replace("T", " ")
            msg = rec.get("message", {})
            if typ == "user":
                body = self.user_text(msg)
                if body:
                    turns.append(("USER", ts, body))
            else:
                lines = self.assistant_lines(msg)
                if lines:
                    turns.append(("ASSISTANT", ts, "\n".join(lines)))
        return turns

    @staticmethod
    def user_text(msg: dict) -> str:
        c = msg.get("content")
        if isinstance(c, str):
            return c.strip()
        parts = []
        for b in c or []:
            if isinstance(b, dict) and b.get("type") == "text":
                parts.append(b.get("text", ""))
        return "\n".join(parts).strip()

    @staticmethod
    def assistant_lines(msg: dict) -> list[str]:
        out = []
        for b in msg.get("content") or []:
            if not isinstance(b, dict):
                continue
            if b.get("type") == "text":
                t = b.get("text", "").strip()
                if t:
                    out.append(t)
            elif b.get("type") == "tool_use":
                out.append(tool_marker(b.get("name", "?"), b.get("input", {}) or {}))
        return out


class CodexAgent(Agent):
    name = "codex"

    def __init__(self):
        home = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex")).expanduser()
        self.db = home / "state_5.sqlite"

    def sessions(self, cwd: Path) -> list[Session]:
        if not self.db.exists():
            return []
        conn = sqlite3.connect(self.db)
        try:
            rows = conn.execute(
                "SELECT id, name, title, updated_at, updated_at_ms, rollout_path"
                " FROM threads WHERE cwd = ?",
                (str(cwd),),
            ).fetchall()
        finally:
            conn.close()
        out = []
        for sid, name, title, updated_at, updated_at_ms, rollout in rows:
            path = Path(rollout)
            mtime = updated_at_ms / 1000 if updated_at_ms is not None else updated_at
            size, msgs = file_stats(path)
            title = " ".join((name or title or "").split())
            out.append(Session(self.name, sid, mtime, size, msgs, title, path))
        return out

    def remove(self, s: Session) -> None:
        conn = sqlite3.connect(self.db)
        try:
            cur = conn.cursor()
            tables = [r[0] for r in cur.execute(
                "SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'"
            )]
            for table in tables:
                if table == "threads":
                    continue
                quoted = '"' + table.replace('"', '""') + '"'
                columns = {r[1] for r in cur.execute(f"PRAGMA table_info({quoted})")}
                for column in ("thread_id", "parent_thread_id", "child_thread_id"):
                    if column in columns:
                        cur.execute(f"DELETE FROM {quoted} WHERE {column} = ?", (s.id,))
            cur.execute("DELETE FROM threads WHERE id = ?", (s.id,))
            conn.commit()
        finally:
            conn.close()
        s.path.unlink(missing_ok=True)

    def transcript(self, s: Session) -> list[Turn]:
        if not s.path.is_file():
            return []
        turns = []
        for rec in read_jsonl(s.path):
            ts = (rec.get("timestamp") or "")[:19].replace("T", " ")
            p = rec.get("payload") or {}
            typ = p.get("type")
            if rec.get("type") == "event_msg" and typ == "user_message":
                body = (p.get("message") or "").strip()
                if body:
                    turns.append(("USER", ts, body))
            elif rec.get("type") != "response_item":
                continue
            elif typ == "message" and p.get("role") == "assistant":
                text = "\n".join(
                    b.get("text", "") for b in p.get("content") or [] if b.get("type") == "output_text"
                ).strip()
                if text:
                    turns.append(("ASSISTANT", ts, text))
            elif typ == "function_call":
                try:
                    args = json.loads(p.get("arguments") or "{}")
                except json.JSONDecodeError:
                    args = {}
                turns.append(("ASSISTANT", ts, tool_marker(p.get("name", "?"), args if isinstance(args, dict) else {})))
            elif typ == "custom_tool_call":
                turns.append(("ASSISTANT", ts, tool_marker(p.get("name", "?"), {"input": p.get("input")})))
            elif typ == "web_search_call":
                turns.append(("ASSISTANT", ts, tool_marker("web_search", (p.get("action") or {}))))
        return turns


AGENTS: list[Agent] = [ClaudeAgent(), CodexAgent()]


HEADER = f"{'AGENT':6}  {'SESSION ID':38}  {'MODIFIED':19}  {'SIZE':>10}  {'MSGS':>5}  TITLE"


def all_sessions(cwd: Path) -> list[Session]:
    """Sessions of every agent for cwd, oldest first."""
    return sorted((s for a in AGENTS for s in a.sessions(cwd)), key=lambda s: s.mtime)


def agent_of(s: Session) -> Agent:
    return next(a for a in AGENTS if a.name == s.agent)


def format_row(s: Session) -> str:
    mtime = datetime.fromtimestamp(s.mtime).strftime("%Y-%m-%d %H:%M:%S")
    return f"{s.agent:6}  {s.id:38}  {mtime:19}  {s.size:>10}  {s.msgs:>5}  {s.title}"


def list_sessions(cwd: Path) -> int:
    rows = all_sessions(cwd)
    if not rows:
        print(f"No sessions for {cwd}")
        return 0
    print(HEADER)
    for row in rows:
        print(format_row(row))
    return 0


def dump_session(cwd: Path, session_id: str, out_path: Path | None) -> int:
    """Write a clean, readable dump of a session transcript.

    Keeps real user-typed text, assistant text, and compact one-line tool
    markers. Drops thinking/reasoning and raw tool results. Groups
    consecutive assistant records into a single response block.
    """
    s = next((s for s in all_sessions(cwd) if s.id == session_id), None)
    if s is None:
        print(f"Session not found: {session_id}", file=sys.stderr)
        return 1
    out = out_path or Path(f"{session_id}.txt")

    # Merge consecutive ASSISTANT turns into one block (keep first ts).
    merged = []
    for role, ts, body in agent_of(s).transcript(s):
        if merged and role == "ASSISTANT" and merged[-1][0] == "ASSISTANT":
            merged[-1] = (role, merged[-1][1], merged[-1][2] + "\n" + body)
        else:
            merged.append((role, ts, body))

    with out.open("w") as o:
        for role, ts, body in merged:
            o.write(f"\n{'─'*6} [{ts}] {role} {'─'*6}\n{body}\n")

    print(f"{len(merged)} turns written to {out}")
    return 0


def confirm_remove(rows: list[Session], cwd: Path) -> int:
    print(HEADER)
    for row in rows:
        print(format_row(row))
    ans = input(f"Remove {len(rows)} session(s) for {cwd}? [y/N] ").strip().lower()
    if ans != "y":
        print("Aborted.")
        return 0
    for row in rows:
        agent_of(row).remove(row)
    print(f"Removed {len(rows)} session(s).")
    return 0


def remove_matching(cwd: Path, patterns: list[str]) -> int:
    """Each pattern is an id, an id prefix, or a glob ('*' = every session)."""
    rows = all_sessions(cwd)
    matched = []
    for pat in patterns:
        hits = [r for r in rows if fnmatch(r.id, pat) or r.id.startswith(pat)]
        if not hits:
            print(f"No sessions match: {pat}", file=sys.stderr)
        matched += [h for h in hits if h not in matched]
    if not matched:
        return 1
    if len(matched) == 1 and matched[0].id in patterns:
        agent_of(matched[0]).remove(matched[0])
        print(f"Removed {matched[0].agent} session {matched[0].id}")
        return 0
    return confirm_remove(matched, cwd)


def read_key(fd: int) -> str:
    ch = os.read(fd, 1)
    if ch != b"\x1b":
        return ch.decode(errors="replace")
    # A bare Esc has nothing following it; arrow keys arrive as ESC [ A / ESC O A.
    if select.select([fd], [], [], 0.025)[0]:
        seq = os.read(fd, 8)
        return {b"[A": "up", b"OA": "up", b"[B": "down", b"OB": "down"}.get(seq, "")
    return "esc"


def pick_sessions(rows: list[Session]) -> list[int] | None:
    """Inline picker drawn below the cursor; returns marked row indexes, or None on q/Esc."""
    fd = sys.stdin.fileno()
    out = sys.stdout
    term = shutil.get_terminal_size()
    width = term.columns - 1
    body = min(len(rows), max(1, term.lines - 3))
    total = body + 2  # header + rows + footer
    cur = top = 0
    marks: list[int] = []  # in mark order, so `u` undoes the latest
    footer = "j/k move   d mark   u undo   Enter confirm   q/Esc cancel"

    old = termios.tcgetattr(fd)
    tty.setcbreak(fd)
    out.write("\n" * total + f"\x1b[{total}A")  # make room below the cursor
    try:
        while True:
            if cur < top:
                top = cur
            elif cur >= top + body:
                top = cur - body + 1
            lines = [f"\x1b[1m   {HEADER}\x1b[0m"]
            for i in range(top, top + body):
                mark = "D" if i in marks else " "
                line = f" {mark} {format_row(rows[i])}"[:width]
                lines.append(f"\x1b[7m{line}\x1b[0m" if i == cur else line)
            lines.append(footer)
            out.write("".join(f"\r\x1b[K{line}\n" for line in lines) + f"\x1b[{total}A")
            out.flush()
            key = read_key(fd)
            if key in ("j", "down"):
                cur = min(cur + 1, len(rows) - 1)
            elif key in ("k", "up"):
                cur = max(cur - 1, 0)
            elif key == "d":
                if cur not in marks:
                    marks.append(cur)
            elif key == "u":
                if marks:
                    marks.pop()
            elif key in ("\r", "\n"):
                return marks
            elif key in ("q", "esc"):
                return None
    except KeyboardInterrupt:
        return None
    finally:
        out.write("\r\x1b[J")  # erase the picker
        out.flush()
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


def interactive_remove(cwd: Path) -> int:
    if not sys.stdin.isatty():
        print("Interactive removal needs a terminal; pass a pattern to -r.", file=sys.stderr)
        return 1
    rows = all_sessions(cwd)
    if not rows:
        print(f"No sessions for {cwd}")
        return 0
    marks = pick_sessions(rows)
    if marks is None:
        print("Cancelled.")
        return 0
    if not marks:
        print("Nothing selected.")
        return 0
    return confirm_remove([rows[i] for i in sorted(marks)], cwd)


def main() -> int:
    parser = argparse.ArgumentParser(
        description="List, remove or dump "
        + "/".join(a.name for a in AGENTS)
        + " sessions for the current working directory.",
    )
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("-l", action="store_true", help="list sessions for $PWD")
    group.add_argument(
        "-r",
        metavar="PATTERN",
        nargs="*",
        help="remove sessions matching id/prefix/glob ('*' = all, quote it); "
        "with no argument, pick interactively",
    )
    group.add_argument(
        "-d",
        metavar="SESSION_ID",
        help="dump a session's conversation to SESSION_ID.txt (or -o FILE)",
    )
    parser.add_argument(
        "-o",
        metavar="FILE",
        help="output file for -d (default: SESSION_ID.txt in the current dir)",
    )
    args = parser.parse_args()

    cwd = Path(os.getcwd()).resolve()

    if args.l:
        return list_sessions(cwd)
    if args.d:
        out_path = Path(args.o) if args.o else None
        return dump_session(cwd, args.d, out_path)
    if args.r:
        return remove_matching(cwd, args.r)
    return interactive_remove(cwd)


if __name__ == "__main__":
    sys.exit(main())

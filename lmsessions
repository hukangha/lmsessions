class ViewBuilder:
    """Viewer text plus the 1-based (start, end) line ranges to fold."""

    def __init__(self):
        self.lines: list[str] = []
        self.folds: list[tuple[int, int]] = []
        self.spills = 0

    def section(self, header: str, body: list[str]) -> None:
        start = len(self.lines) + 1
        self.lines.append(header)
        self.lines.extend(body)
        if body:
            self.folds.append((start, len(self.lines)))
        self.lines.append("")


def record_ts(rec: dict) -> str:
    ts = rec.get("timestamp")
    return ts[:19].replace("T", " ") if isinstance(ts, str) else ""


def text_preview(text: str) -> str:
    """The first two sentences or 100 characters, whichever ends first, on one line."""
    flat = " ".join(text.split())
    end = len(flat)
    sentences = 0
    for i, char in enumerate(flat):
        if char in ".!?。！？":
            sentences += 1
            if sentences == 2:
                end = i + 1
                break
    end = min(end, 100)
    return flat[:end].rstrip() + ("…" if end < len(flat) else "")


def content_blocks(rec: dict) -> list[dict]:
    """The record's content blocks when content is a list (Claude's usual shape)."""
    message = rec.get("message")
    content = message.get("content") if isinstance(message, dict) else None
    return [b for b in content if isinstance(b, dict)] if isinstance(content, list) else []


def text_of(content) -> str:
    """Readable text of a tool_result content value (a string or a list of blocks)."""
    if isinstance(content, str):
        return content
    if not isinstance(content, list):
        return "" if content is None else str(content)
    parts = []
    for block in content:
        if not isinstance(block, dict):
            continue
        if block.get("type") == "text":
            parts.append(block.get("text", ""))
        elif block.get("type") == "image":
            parts.append("[image]")
        else:
            parts.append(json.dumps(block, ensure_ascii=False))
    return "\n".join(parts)


def structured_patch(tur: dict) -> str:
    """A unified diff from an Edit/Write toolUseResult, or ''."""
    patch = tur.get("structuredPatch")
    if not isinstance(patch, list) or not patch:
        return ""
    path = tur.get("filePath") or ""
    out = [f"--- {path}", f"+++ {path}"] if path else []
    for hunk in patch:
        if not isinstance(hunk, dict):
            continue
        out.append(
            f"@@ -{hunk.get('oldStart')},{hunk.get('oldLines')}"
            f" +{hunk.get('newStart')},{hunk.get('newLines')} @@"
        )
        out.extend(str(line) for line in hunk.get("lines") or [])
    return "\n".join(out)


def tool_text(rec: dict, block: dict) -> str:
    """Prefer the structured toolUseResult over the model-visible tool_result text."""
    fallback = text_of(block.get("content"))
    tur = rec.get("toolUseResult")
    if tur is None:
        return fallback
    if isinstance(tur, str):
        return tur
    if not isinstance(tur, dict):
        return fallback or json.dumps(tur, ensure_ascii=False)
    patch = structured_patch(tur)
    if patch:
        return patch
    if "stdout" in tur or "stderr" in tur:
        parts = []
        if tur.get("interrupted"):
            parts.append("[interrupted]")
        if tur.get("stderr"):
            parts.append(str(tur["stderr"]).rstrip())
        if tur.get("stdout"):
            parts.append(str(tur["stdout"]).rstrip())
        return "\n".join(parts) or fallback or "(no output)"
    if isinstance(tur.get("result"), str):
        return tur["result"]
    file = tur.get("file")
    if isinstance(file, dict) and isinstance(file.get("content"), str):
        return file["content"]
    return fallback or json.dumps(tur, ensure_ascii=False)


def input_lines(inp) -> list[str]:
    """A tool_use input as readable key/value lines, keeping multi-line strings multi-line."""
    if not isinstance(inp, dict) or not inp:
        return ["(none)"]
    out = []
    for key, value in inp.items():
        if isinstance(value, str) and "\n" in value:
            out.append(f"{key}:")
            out.extend(value.splitlines())
        else:
            out.append(f"{key}: {json.dumps(value, ensure_ascii=False)}")
    return out


def spill_lines(view: ViewBuilder, text: str, tmpdir: Path) -> list[str]:
    """The first CLAUDE_VIEW_LINES lines; a longer text is written whole to a file for gf."""
    lines = text.splitlines()
    if len(lines) <= CLAUDE_VIEW_LINES:
        return lines or ["(no output)"]
    view.spills += 1
    path = tmpdir / f"output-{view.spills:03d}.txt"
    path.write_text(text.rstrip("\n") + "\n", encoding="utf-8")
    return lines[:CLAUDE_VIEW_LINES] + [f"full output ({len(lines)} lines): {path}"]


def call_entry(block: dict, ts: str, tag: str) -> dict:
    inp = block.get("input")
    return {
        "kind": "call",
        "id": block.get("id"),
        "name": block.get("name") or "?",
        "input": inp if isinstance(inp, dict) else {"input": inp},
        "ts": ts,
        "tag": tag,
    }


def add_thinking(view, entry) -> None:
    view.section(
        f"{entry['ts']} {entry.get('tag', '')}{entry['label']}",
        entry["text"].splitlines() or ["(no text)"],
    )


def add_call(view, entry, results, tmpdir) -> None:
    block, rec = results.get(entry["id"], (None, None))
    failed = bool(block and block.get("is_error"))
    denied = rec.get("toolDenialKind") if rec else None
    mark = "✗ " if failed or denied else ""
    header = f"{entry['ts']} {entry.get('tag', '')}{mark}{tool_marker(entry['name'], entry['input']).strip()}"
    body = ["input:"]
    body.extend(input_lines(entry["input"]))
    if block is None:
        body.append("(no result)")
    else:
        if denied:
            body.append(f"denied: {denied}")
        body.append("result:")
        body.extend(spill_lines(view, tool_text(rec, block), tmpdir))
    view.section(header, body)


def attachment_text(rec: dict) -> str:
    rendered = rec.get("rendered")
    if isinstance(rendered, str):
        return rendered.strip()
    if isinstance(rendered, dict):
        rendered = [rendered]
    if not isinstance(rendered, list):
        return ""
    parts = []
    for item in rendered:
        if isinstance(item, dict) and isinstance(item.get("content"), str):
            parts.append(item["content"])
        elif isinstance(item, str):
            parts.append(item)
    return "\n".join(parts).strip()


def head_tail(lines: list[str], n: int) -> list[str]:
    """The first and last n lines, with the elided middle replaced by six dots."""
    return lines if len(lines) <= 2 * n else lines[:n] + ["......"] + lines[-n:]


def message_summary(message: dict) -> str:
    """One line naming a request message and enough text to place it."""
    if not isinstance(message, dict):
        return "?: (not an object)"
    role = message.get("role") or "?"
    content = message.get("content")
    if isinstance(content, str):
        text = content
    elif isinstance(content, list):
        parts = []
        for block in content:
            if not isinstance(block, dict):
                continue
            kind = block.get("type")
            if kind == "text":
                parts.append(block.get("text", ""))
            elif kind == "tool_use":
                parts.append(f"[tool_use {block.get('name') or '?'}]")
            elif kind == "tool_result":
                snippet = " ".join(text_of(block.get("content")).split())[:80]
                parts.append(f"[tool_result {snippet}]" if snippet else "[tool_result]")
            elif kind == "thinking":
                parts.append("[thinking]")
            else:
                parts.append(f"[{kind or 'block'}]")
        text = " ".join(parts)
    else:
        text = str(content or "")
    text = " ".join(text.split()) or "(empty)"
    return f"{role}: {text[:160]}{'…' if len(text) > 160 else ''}"


def render_request(view, rec, blobs, shapes, by_id) -> None:
    """One folded section for an API request: shape plus the head/tail of its content."""

    def messages(hashes):
        if not isinstance(hashes, list):
            return []
        return [blobs[h] for h in hashes if h in blobs]

    def first_messages(request_id):
        """The earliest content in the request's base chain, so the range is visible."""
        chain, seen, cur = [], set(), request_id
        while cur and cur in by_id and cur not in seen:
            chain.append(cur)
            seen.add(cur)
            cur = by_id[cur].get("base")
        for item in reversed(chain):
            found = messages(by_id[item].get("tail"))
            if found:
                return found
        return []

    params = rec.get("params")
    params = params if isinstance(params, dict) else {}
    tail = messages(rec.get("tail"))
    base = rec.get("base")
    base = base if isinstance(base, str) else None
    head = first_messages(base) if base else []
    body = ["params:"]
    body.extend(json.dumps(params, ensure_ascii=False, indent=2).splitlines())
    shape_hash = rec.get("shapeHash")
    shape = shapes.get(shape_hash) if isinstance(shape_hash, str) else None
    shape = shape if isinstance(shape, dict) else {}
    system = shape.get("system") or []
    tools = shape.get("tools") or []
    body.append(
        f"shape {(shape_hash or '')[:8]}:" f" system={len(system)} tool(s)={len(tools)}"
    )
    system_text = "\n".join(
        block.get("text", "") for block in system if isinstance(block, dict)
    )
    if system_text.strip():
        body.append("system:")
        body.extend(head_tail(system_text.splitlines(), 5))
    if tools:
        names = [tool.get("name") or "?" for tool in tools if isinstance(tool, dict)]
        body.append("tools: " + ", ".join(names))
    if head and tail:
        body.append("content from the first request to this one:")
        body.extend(message_summary(message) for message in head[:3])
        body.append("......")
        body.extend(message_summary(message) for message in tail[-3:])
    elif head:
        body.append("content (carried over; no new messages):")
        body.extend(message_summary(message) for message in head[:3])
        body.append("......")
    elif tail:
        body.append("content:")
        if len(tail) > 6:
            body.extend(message_summary(message) for message in tail[:3])
            body.append("......")
            body.extend(message_summary(message) for message in tail[-3:])
        else:
            body.extend(message_summary(message) for message in tail)
    else:
        body.append("content: (none)")
    base_label = f" base={(base or '')[:8]}" if base else ""
    view.section(
        f"{record_ts(rec)} API request model={params.get('model', '?')}"
        f"{base_label} tail={len(tail)}",
        body,
    )


def render_item(view, item, results, tmpdir, final) -> None:
    """Render one loop item; the final assistant text is left for render_turn."""
    if item is final:
        return
    kind = item["kind"]
    if kind == "thinking":
        add_thinking(view, item)
    elif kind == "call":
        add_call(view, item, results, tmpdir)
    elif kind == "text":
        view.section(
            f"{item['ts']} {item['tag']}ASSISTANT: {text_preview(item['text'])}",
            item["text"].splitlines(),
        )
    else:  # note
        view.section(item["header"], item["body"])


def render_loop(view, loop, results, tmpdir, blobs, shapes, by_id, final) -> None:
    """One API-request/thinking/tool-call loop, folded as a block."""
    requests = loop["requests"]
    items = loop["items"]
    thinking = sum(1 for item in items if item["kind"] == "thinking")
    calls = sum(1 for item in items if item["kind"] == "call")
    parts = ["API request" if len(requests) == 1 else f"{len(requests)} API requests"]
    if thinking:
        parts.append(f"{thinking} thinking")
    if calls:
        parts.append(f"{calls} tool call{'s' if calls != 1 else ''}")
    ts = record_ts(requests[0]) if requests else ""
    start = len(view.lines) + 1
    view.lines.append(f"{ts} LOOP: " + " · ".join(parts))
    for rec in requests:
        render_request(view, rec, blobs, shapes, by_id)
    for item in items:
        render_item(view, item, results, tmpdir, final)
    if len(view.lines) > start:
        view.folds.append((start, len(view.lines)))
    view.lines.append("")


def render_turn(view, turn, results, tmpdir, blobs, shapes, by_id, final) -> None:
    """USER, its repeated loops (one PROCEDURE fold), then the final ASSISTANT text."""
    user = turn["user"]
    if user is not None:
        view.section(
            f"{user['ts']} {user['tag']}{user['label']}: {text_preview(user['text'])}",
            user["text"].splitlines(),
        )
    pre = turn["pre"]
    loops = turn["loops"]
    if len(loops) > 1 or (loops and pre):
        start = len(view.lines) + 1
        ts = record_ts(loops[0]["requests"][0]) if loops and loops[0]["requests"] else ""
        count = len(loops)
        view.lines.extend(
            [f"{ts} PROCEDURE ({count} loop{'s' if count != 1 else ''})", ""]
        )
        for item in pre:
            render_item(view, item, results, tmpdir, final)
        for loop in loops:
            render_loop(view, loop, results, tmpdir, blobs, shapes, by_id, final)
        view.folds.append((start, len(view.lines)))
        view.lines.append("")
    else:
        for item in pre:
            render_item(view, item, results, tmpdir, final)
        for loop in loops:
            render_loop(view, loop, results, tmpdir, blobs, shapes, by_id, final)
    if final is not None:
        render_item(view, final, results, tmpdir, None)


def claude_active_uuids(records: list[dict]) -> set[str] | None:
    """UUIDs on the live branch.

    A rewind leaves the abandoned branch in the jsonl, but its records are not
    ancestors of the newest conversation record. Follow parentUuid back to the
    root, using logicalParentUuid to cross a compaction boundary."""
    by_uuid = {r["uuid"]: r for r in records if isinstance(r.get("uuid"), str)}
    conv = [
        (i, r)
        for i, r in enumerate(records)
        if isinstance(r.get("uuid"), str)
        and not r.get("isSidechain")
        and r.get("type") in ("user", "assistant", "system", "attachment")
    ]
    if not conv or not by_uuid:
        return None
    last_index, last = conv[-1]
    leaf = last["uuid"]
    prompt_index = None
    prompt_leaf = None
    for i, rec in enumerate(records):
        if rec.get("type") == "last-prompt" and isinstance(rec.get("leafUuid"), str):
            prompt_index, prompt_leaf = i, rec["leafUuid"]
    # A rewind without a new message makes last-prompt the newest record; its
    # leafUuid is then the live end, not the abandoned record after it.
    if prompt_index is not None and prompt_index > last_index and prompt_leaf in by_uuid:
        leaf = prompt_leaf
    active: set[str] = set()
    cur = leaf
    while cur in by_uuid and cur not in active:
        active.add(cur)
        rec = by_uuid[cur]
        cur = rec.get("parentUuid") or rec.get("logicalParentUuid")
    return active or None


def claude_active_requests(records: list[dict], active: set[str] | None) -> set[int]:
    """Indexes of api-request records that belong to the live branch.

    An api-request has no uuid; it is logged just before the conversation record
    it serves, so keep it when the next meaningful record is on the live branch."""
    if active is None:
        return {i for i, rec in enumerate(records) if rec.get("type") == "api-request"}
    next_conv: list[dict | None] = [None] * (len(records) + 1)
    following: dict | None = None
    for i in range(len(records) - 1, -1, -1):
        next_conv[i] = following
        rec = records[i]
        if not isinstance(rec.get("uuid"), str) or rec.get("isSidechain"):
            continue
        if rec.get("type") not in ("user", "assistant", "system", "attachment"):
            continue
        if rec.get("type") == "user":
            if rec.get("isMeta"):
                continue
            text = ClaudeAgent.user_text(rec.get("message") or {})
            if text.startswith(("<local-command", "<command-name", "<command-message")):
                continue
        following = rec
    live: set[int] = set()
    for i, rec in enumerate(records):
        if rec.get("type") != "api-request":
            continue
        following = next_conv[i]
        if following is None or following["uuid"] in active:
            live.add(i)
    return live


def claude_view(s: Session, view: ViewBuilder, tmpdir: Path) -> None:
    """Render a Claude session into view.

    Shows user/assistant text, thinking, grouped tool calls with their results,
    system notes, selected injected attachments and API requests. Raw tool
    results, thinking and attachments are what transcript() drops."""
    records = list(read_jsonl(s.path))
    active = claude_active_uuids(records)
    live_requests = claude_active_requests(records, active)

    def rewound(rec: dict) -> bool:
        uuid = rec.get("uuid")
        return (
            active is not None
            and isinstance(uuid, str)
            and not rec.get("isSidechain")
            and uuid not in active
        )

    blobs: dict[str, dict] = {}
    shapes: dict[str, dict] = {}
    requests_by_id: dict[str, dict] = {}
    results: dict[str, tuple[dict, dict]] = {}
    for i, rec in enumerate(records):
        kind = rec.get("type")
        if kind == "api-request-blob":
            if isinstance(rec.get("hash"), str) and isinstance(rec.get("message"), dict):
                blobs[rec["hash"]] = rec["message"]
        elif kind == "api-request-shape":
            if isinstance(rec.get("shapeHash"), str) and isinstance(rec.get("shape"), dict):
                shapes[rec["shapeHash"]] = rec["shape"]
        elif kind == "api-request":
            if i in live_requests:
                request_id = rec.get("id")
                if isinstance(request_id, str):
                    requests_by_id[request_id] = rec
        elif kind == "user":
            if rewound(rec):
                continue
            for block in content_blocks(rec):
                if block.get("type") == "tool_result":
                    results[block.get("tool_use_id")] = (block, rec)

    title = " ".join((s.title or "").split()) or s.id
    view.lines.extend(
        [
            title,
            f"claude · {s.id} · {s.cwd}",
            "fold: za/zo/zc or click the fold column · full output: gf on its path",
            "",
        ]
    )
    def new_turn() -> dict:
        return {"user": None, "pre": [], "loops": [], "last_text": None}

    turn = new_turn()
    loop: dict | None = None

    def add_item(item: dict) -> None:
        if loop is not None:
            loop["items"].append(item)
        else:
            turn["pre"].append(item)

    def add_note(header: str, body: list[str]) -> None:
        add_item({"kind": "note", "header": header, "body": body})

    def add_thinking_item(ts: str, tag: str, label: str, text: str) -> None:
        add_item({"kind": "thinking", "ts": ts, "tag": tag, "label": label, "text": text})

    def add_call_item(block: dict, ts: str, tag: str) -> None:
        add_item(call_entry(block, ts, tag))

    def add_text_item(ts: str, tag: str, text: str) -> None:
        item = {"kind": "text", "ts": ts, "tag": tag, "text": text}
        add_item(item)
        turn["last_text"] = item

    def start_loop(rec: dict) -> None:
        nonlocal loop
        if loop is None or loop["items"]:
            loop = {"requests": [], "items": []}
            turn["loops"].append(loop)
        loop["requests"].append(rec)

    def final_text_for(turn: dict) -> dict | None:
        """The last assistant text with no tool call or later loop after it."""
        last = turn["last_text"]
        if last is None:
            return None

        def call_after(items: list[dict]) -> bool:
            seen = False
            for item in items:
                if item is last:
                    seen = True
                elif seen and item["kind"] == "call":
                    return True
            return False

        if any(item is last for item in turn["pre"]):
            return None if turn["loops"] or call_after(turn["pre"]) else last
        for index, loop in enumerate(turn["loops"]):
            if any(item is last for item in loop["items"]):
                if call_after(loop["items"]):
                    return None
                if any(later["requests"] or later["items"] for later in turn["loops"][index + 1:]):
                    return None
                return last
        return None

    def flush_turn() -> None:
        nonlocal turn, loop
        empty = (
            turn["user"] is None
            and not turn["pre"]
            and not turn["loops"]
            and turn["last_text"] is None
        )
        if not empty:
            final = final_text_for(turn)
            render_turn(view, turn, results, tmpdir, blobs, shapes, requests_by_id, final)
        turn = new_turn()
        loop = None

    for i, rec in enumerate(records):
        kind = rec.get("type")
        if kind == "api-request":
            if i in live_requests:
                start_loop(rec)
            continue
        if rewound(rec):
            continue
        ts = record_ts(rec)
        tag = "[subagent] " if rec.get("isSidechain") else ""
        if kind == "api-request":
            start_loop(rec)
            continue
        if kind == "user":
            if rec.get("isMeta"):
                continue
            msg = rec.get("message")
            msg = msg if isinstance(msg, dict) else {}
            text = ClaudeAgent.user_text(msg)
            synthetic = text.startswith(
                ("<local-command", "<command-name", "<command-message")
            )
            if text and not synthetic:
                carried = None
                if turn["loops"]:
                    trailing = turn["loops"][-1]
                    last_ts = record_ts(trailing["requests"][-1]) if trailing["requests"] else ""
                    if not trailing["items"] and last_ts and last_ts == ts:
                        # The request for this user turn is logged just before it.
                        carried = turn["loops"].pop()
                flush_turn()
                label = "CONTEXT SUMMARY" if rec.get("isCompactSummary") else "USER"
                turn["user"] = {"ts": ts, "tag": tag, "label": label, "text": text}
                if carried is not None:
                    for request in list(carried["requests"]):
                        start_loop(request)
            if rec.get("interruptedMessageId"):
                add_note(f"{ts} {tag}user interrupted", [])
            continue
        if kind == "assistant":
            msg = rec.get("message")
            msg = msg if isinstance(msg, dict) else {}
            blocks = content_blocks(rec)
            if rec.get("isApiErrorMessage"):
                text = ClaudeAgent.user_text(msg) or json.dumps(msg, ensure_ascii=False)
                add_note(f"{ts} {tag}API error", text.splitlines())
                continue
            for block in blocks:
                typ = block.get("type")
                if typ == "text":
                    text = (block.get("text") or "").strip()
                    if text:
                        add_text_item(ts, tag, text)
                elif typ == "thinking":
                    text = (block.get("thinking") or "").strip()
                    label = "thinking"
                    if rec.get("thinkingDisplay") == "summarized":
                        label += " (summarized)"
                    add_thinking_item(ts, tag, label, text)
                elif typ == "tool_use":
                    add_call_item(block, ts, tag)
                elif typ == "image":
                    add_note(f"{ts} {tag}image", ["[image]"])
                else:
                    add_note(
                        f"{ts} {tag}{typ or 'block'}",
                        [json.dumps(block, ensure_ascii=False)],
                    )
            if not blocks:
                text = ClaudeAgent.user_text(msg).strip()
                if text:
                    add_text_item(ts, tag, text)
            if rec.get("error") or rec.get("apiErrorStatus"):
                add_note(
                    f"{ts} {tag}API error",
                    [str(rec.get("error") or rec.get("apiErrorStatus"))],
                )
            continue
        if kind == "system":
            subtype = rec.get("subtype")
            if subtype == "turn_duration":
                continue
            content = rec.get("content")
            if subtype == "compact_boundary":
                body = [str(content)] if content else []
                meta = rec.get("compactMetadata")
                if isinstance(meta, dict) and meta:
                    body.append(json.dumps(meta, ensure_ascii=False))
                add_note(f"{ts} {tag}context compacted", body or ["Conversation compacted"])
            elif content:
                level = rec.get("level") or "info"
                labels = {
                    "away_summary": "away summary",
                    "local_command": "command",
                    "informational": "warning" if level == "warning" else f"info ({level})",
                    "bridge_status": "bridge",
                }
                label = labels.get(subtype, f"system/{subtype}")
                if subtype == "local_command":
                    match = re.search(r"<command-name>([^<]+)</command-name>", str(content))
                    if match:
                        label = f"command {match.group(1)}"
                add_note(f"{ts} {tag}{label}", str(content).splitlines())
            continue
        if kind == "attachment":
            attachment = rec.get("attachment")
            if (
                not isinstance(attachment, dict)
                or attachment.get("type") not in VIEW_ATTACHMENTS
            ):
                continue
            text = attachment_text(rec)
            if text:
                add_note(
                    f"{ts} {tag}attachment: {attachment.get('type')}",
                    text.splitlines(),
                )
            continue
    flush_turn()


def vim_viewer_script(folds: list[tuple[int, int]]) -> str:
    """Vimscript that folds each range and starts with every fold closed.

    Manual folds must be made innermost-first: creating an outer range first
    makes Vim raise that whole fold's level for each range nested in it."""
    setup = [
        "set nomodeline",
        "set mouse=a",
        "setlocal foldmethod=manual",
        "setlocal foldenable",
        "setlocal foldminlines=0",
        "setlocal foldcolumn=1",
        "setlocal nobuflisted",
        "setlocal noswapfile",
        "setlocal wrap",
        "setlocal linebreak",
    ]
    create = [
        f"{start},{end}fold"
        for start, end in sorted(folds, key=lambda fold: fold[1] - fold[0])
    ]
    finish = [
        "normal! zM",
        "setlocal nomodifiable",
        "setlocal readonly",
        "nnoremap <buffer> <silent> <2-LeftMouse> za",
    ]
    return "\n".join(setup + create + finish) + "\n"


def view_session(s: Session) -> None:
    """Render a Claude session and open it in vim with every section folded."""
    vim = shutil.which("vim") or shutil.which("nvim")
    if vim is None:
        print("vim not found; cannot open the viewer", file=sys.stderr)
        return
    tmpdir = Path(tempfile.mkdtemp(prefix="lmsessions-"))
    try:
        view = ViewBuilder()
        try:
            claude_view(s, view, tmpdir)
        except OSError as e:  # the transcript vanished or the spill file cannot be written
            print(f"Cannot read {s.path}: {e}", file=sys.stderr)
            return
        name = re.sub(r"[^\w.-]", "_", s.id)
        content = tmpdir / f"{name}.txt"
        content.write_text("\n".join(view.lines) + "\n", encoding="utf-8")
        script = tmpdir / "view.vim"
        script.write_text(vim_viewer_script(view.folds), encoding="utf-8")
        # Switch modelines off after the vimrc and before :edit, so a transcript
        # line that happens to look like one cannot run as an option command.
        try:
            subprocess.run(
                [
                    vim,
                    "-N",
                    "--cmd",
                    "set nomodeline",
                    "-c",
                    "set nomodeline",
                    "-c",
                    f"edit {content}",
                    "-S",
                    str(script),
                ]
            )
        except OSError as e:
            print(f"Cannot run {vim}: {e}", file=sys.stderr)
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)


def interactive_menu(cwd: Path | None) -> int:
    if not sys.stdin.isatty():
        print("The interactive menu needs a terminal; pass -l to list sessions.", file=sys.stderr)
        return 1
    rows = all_sessions(cwd)
    if not rows:
        print(f"No sessions for {where(cwd)}")
        return 0
    cw = cwd_width(rows, cwd)
    marks: list[int] = []
    hits: dict[tuple[str, str], list[Hit]] | None = None
    filters: list[re.Pattern] = []
    history: list[tuple[
        list[Session], dict[tuple[str, str], list[Hit]] | None, int, list[re.Pattern], list[int]
    ]] = []
    focus: Session | None = None
    sort: tuple[str, bool] | None = None  # kept across pages: backing out restores the order

    def rebuild_rows() -> list[Session]:
        """Every session, in the order rows are shown now; unseen ones last.

        A fresh all_sessions() is oldest-first, so re-sorting it by key can put
        ties in a different order than the list the user was looking at."""
        seen = {(s.agent, s.id): i for i, s in enumerate(rows)}
        return sorted(all_sessions(cwd), key=lambda s: seen.get((s.agent, s.id), len(seen)))

    while True:
        result = pick_sessions(rows, cw, marks, hits, focus, sort)
        if result is None:
            print("Cancelled.")
            return 0
        kind, payload, focus, sort = result
        if kind == "back":  # Esc on a search page: back to the page searched from
            if history:
                rows, hits, cw, filters, marks = history.pop()
            else:  # no page left (e.g. after a removal): drop all filters
                rows = rebuild_rows()
                hits, filters, marks = None, [], []
                cw = cwd_width(rows, cwd)
            continue
        if kind == "search":
            try:
                rx = re.compile(payload, re.IGNORECASE)
            except re.error as e:
                print(f"Bad pattern {payload!r}: {e}")
                continue
            found = [(s, h) for s in rows if (h := find_hits(s, rx))]
            if not found:
                print(f"No sessions match: {payload}")
                continue
            history.append((rows, hits, cw, list(filters), list(marks)))
            filters = filters + [rx]
            rows = [s for s, _ in found]
            hits = {(s.agent, s.id): h for s, h in found}
            cw = cwd_width(rows, cwd)
            marks = []
            continue
        if kind == "view":
            view_session(payload)
            continue
        if isinstance(payload, Session):
            return resume_session(payload)
        targets = [rows[i] for i in sorted(payload)] or [focus]
        if kind == "dump":
            if not dump_selected(targets):  # backed out of the dump prompt
                marks = payload  # back to the picker, selection kept
                continue
            marks = []
            continue
        result = confirm_remove(targets, cwd)
        if result == "back":
            marks = payload  # Esc at the confirmation: back to the picker, selection kept
            continue
        # Removed: pick again from what is left instead of exiting.
        history = []  # its pages may point at removed sessions
        here = next((i for i, s in enumerate(rows) if s is focus), 0)  # keep the highlight's row
        rows = [s for s in rebuild_rows() if all(find_hits(s, rx) for rx in filters)]
        hits = (
            {(s.agent, s.id): find_hits(s, filters[-1]) for s in rows} if filters else None
        )
        if not rows:
            print("No matching sessions left." if filters else f"No sessions left for {where(cwd)}")
            return 0
        cw = cwd_width(rows, cwd)
        marks = []
        focus = rows[min(here, len(rows) - 1)]


def main() -> int:
    parser = argparse.ArgumentParser(
        description="List, search, remove, dump or resume "
        + "/".join(a.name for a in AGENTS)
        + " sessions; with no arguments, open the interactive menu "
        "(-l lists them; -a covers every directory).",
    )
    parser.add_argument(
        "-l", "--list", dest="l", action="store_true", help="list sessions for $PWD"
    )
    parser.add_argument(
        "-a",
        "--all",
        action="store_true",
        help="apply to sessions in every directory, not just $PWD",
    )
    args = parser.parse_args()
    cwd = None if args.all else Path(os.getcwd()).resolve()
    return list_sessions(cwd) if args.l else interactive_menu(cwd)


if __name__ == "__main__":
    sys.exit(main())

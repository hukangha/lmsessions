#!/usr/bin/env python3
"""List, search, remove, dump or resume coding-agent sessions (Claude Code,
Codex, OpenCode). With no arguments, open the interactive menu; -l lists them
instead; -a covers every directory, not just $PWD. Press / in the menu to search.

To support another agent, subclass `Agent` and add an instance to `AGENTS`.
"""

import argparse
import base64
import json
import os
import re
import select
import shutil
import signal
import sqlite3
import subprocess
import sys
import tempfile
import termios
import tty
from dataclasses import dataclass
from datetime import datetime
from pathlib import Path

try:  # Codex compresses old rollouts to .zst; the stdlib reader arrived in 3.14
    from compression import zstd
except ImportError:  # pragma: no cover - depends on the Python version
    try:
        import zstandard as zstd
    except ImportError:
        zstd = None


@dataclass
class Session:
    agent: str
    id: str
    mtime: float
    size: int
    prompts: int
    title: str
    path: Path
    cwd: str


Turn = tuple[str, str, str]  # (role, timestamp, body)
Hit = tuple[str, int, int]  # (snippet text, match start, match end within the snippet)


def file_size(path: Path) -> int:
    """Size of a transcript file, decompressed when it is stored as .zst; zero if it is missing."""
    try:
        if path.suffix == ".zst":
            data = path.read_bytes()
            return len(zstd.decompress(data)) if zstd else len(data)
        return path.stat().st_size
    except FileNotFoundError:
        return 0


def read_jsonl(path: Path):
    """The transcript's JSON objects, decompressing a .zst rollout on the fly."""
    if path.suffix == ".zst":
        if zstd is None:
            return
        stream = zstd.open(path, "rt", encoding="utf-8", errors="replace")
    else:
        stream = path.open(errors="replace")
    with stream:
        for line in stream:
            line = line.strip()
            if not line:
                continue
            try:
                yield json.loads(line)
            except json.JSONDecodeError:
                continue


def tool_marker(name: str, inp: dict) -> str:
    for k in ("description", "command", "file_path", "path", "prompt", "query", "pattern", "cmd", "input"):
        v = inp.get(k)
        if v:
            v = " ".join(str(v).split())
            if len(v) > 100:
                v = v[:100] + "…"
            return f"    → {name}: {v}"
    return f"    → {name}"


def exec_agent(s: Session, argv: list[str]) -> None:
    """Replace this process with the agent tool, continuing session s in its directory."""
    if s.cwd and Path(s.cwd).is_dir():
        os.chdir(s.cwd)
    os.execvp(argv[0], argv)


class Agent:
    name: str

    def sessions(self, cwd: Path | None) -> list[Session]:
        """Sessions started in cwd, or in any directory if cwd is None."""
        raise NotImplementedError

    def remove(self, s: Session) -> None:
        raise NotImplementedError

    def resume(self, s: Session) -> None:
        raise NotImplementedError

    def transcript(self, s: Session) -> list[Turn]:
        """User text, assistant text and one-line tool markers, in order."""
        raise NotImplementedError


class ClaudeAgent(Agent):
    name = "claude"

    def sessions(self, cwd: Path | None) -> list[Session]:
        projects = Path.home() / ".claude" / "projects"
        if cwd is None:
            files = projects.glob("*/*.jsonl")
        else:
            files = (projects / self.project_name(cwd)).glob("*.jsonl")
        out = []
        target = os.path.realpath(cwd) if cwd is not None else None
        for f in files:
            size = file_size(f)
            title, scwd, prompts = self.title_and_cwd(f)
            # Distinct paths can share one project dir ("a_b" and "a.b" both become
            # "a-b"), so keep only sessions actually started in cwd.
            if target and scwd and os.path.realpath(scwd) != target:
                continue
            out.append(Session(self.name, f.stem, f.stat().st_mtime, size, prompts, title, f, scwd or str(cwd or "")))
        return out

    @staticmethod
    def project_name(cwd: Path) -> str:
        """Claude Code's project dir name for cwd: every non-alphanumeric char becomes '-'."""
        return re.sub(r"[^a-zA-Z0-9]", "-", str(cwd))

    @staticmethod
    def title_and_cwd(path: Path) -> tuple[str, str, int]:
        """Latest title (a /rename custom title wins over the AI one), or the first
        user prompt when the session has neither; the session's cwd; and how many
        prompts the user typed. Rewound records are ignored."""
        records = list(read_jsonl(path))
        active = claude_active_uuids(records)
        custom = ai = cwd = first = ""
        prompts = 0
        for entry in records:
            if (
                active is not None
                and isinstance(entry.get("uuid"), str)
                and not entry.get("isSidechain")
                and entry["uuid"] not in active
            ):
                continue
            typ = entry.get("type")
            if typ == "custom-title":
                custom = entry.get("customTitle", "") or custom
            elif typ == "ai-title":
                ai = entry.get("aiTitle", "") or ai
            elif typ == "user" and not entry.get("isMeta"):
                text = " ".join(ClaudeAgent.user_text(entry.get("message") or {}).split())
                # Skip the synthetic records Claude Code writes for slash commands.
                if text and not text.startswith(("<local-command", "<command-name", "<command-message")):
                    prompts += 1
                    first = first or text
            cwd = cwd or entry.get("cwd", "")
        title = custom or ai or (first[:60] + "…" if len(first) > 60 else first)
        return title, cwd, prompts

    def remove(self, s: Session) -> None:
        s.path.unlink()

    def resume(self, s: Session) -> None:
        exec_agent(s, ["claude", "--resume", s.id])

    def transcript(self, s: Session) -> list[Turn]:
        records = list(read_jsonl(s.path))
        active = claude_active_uuids(records)
        turns = []
        for rec in records:
            if (
                active is not None
                and isinstance(rec.get("uuid"), str)
                and not rec.get("isSidechain")
                and rec["uuid"] not in active
            ):
                continue
            typ = rec.get("type")
            if typ not in ("user", "assistant"):
                continue
            ts = (rec.get("timestamp") or "")[:19].replace("T", " ")
            msg = rec.get("message", {})
            if typ == "user":
                body = self.user_text(msg)
                if body:
                    turns.append(("USER", ts, body))
            else:
                lines = self.assistant_lines(msg)
                if lines:
                    turns.append(("ASSISTANT", ts, "\n".join(lines)))
        return turns

    @staticmethod
    def user_text(msg: dict) -> str:
        c = msg.get("content")
        if isinstance(c, str):
            return c.strip()
        parts = []
        for b in c or []:
            if isinstance(b, dict) and b.get("type") == "text":
                parts.append(b.get("text", ""))
        return "\n".join(parts).strip()

    @staticmethod
    def assistant_lines(msg: dict) -> list[str]:
        out = []
        for b in msg.get("content") or []:
            if not isinstance(b, dict):
                continue
            if b.get("type") == "text":
                t = b.get("text", "").strip()
                if t:
                    out.append(t)
            elif b.get("type") == "tool_use":
                out.append(tool_marker(b.get("name", "?"), b.get("input", {}) or {}))
        return out


class CodexAgent(Agent):
    name = "codex"

    def __init__(self):
        home = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex")).expanduser()
        self.db = home / "state_5.sqlite"

    def sessions(self, cwd: Path | None) -> list[Session]:
        if not self.db.exists():
            return []
        query = "SELECT id, name, title, updated_at, updated_at_ms, rollout_path, cwd FROM threads"
        conn = sqlite3.connect(self.db)
        try:
            if cwd is None:
                rows = conn.execute(query).fetchall()
            else:
                rows = conn.execute(query + " WHERE cwd = ?", (str(cwd),)).fetchall()
        finally:
            conn.close()
        out = []
        for sid, name, title, updated_at, updated_at_ms, rollout, scwd in rows:
            path = Path(rollout)
            if not path.is_file() and Path(f"{rollout}.zst").is_file():
                path = Path(f"{rollout}.zst")  # Codex compresses old rollouts
            mtime = updated_at_ms / 1000 if updated_at_ms is not None else updated_at
            size = file_size(path)
            title = " ".join((name or title or "").split())
            out.append(Session(self.name, sid, mtime, size, self.user_prompts(path), title, path, scwd))
        return out

    # Records newer Codex versions inject as user messages that the user never typed.
    SYNTHETIC = ("<environment_context", "<user_instructions", "<external_codex_apps_open_page")

    @staticmethod
    def modern_prompt(rec: dict) -> str:
        """Text of a newer Codex user message (`response_item`/`message`/`user`), else ''."""
        p = rec.get("payload") or {}
        if rec.get("type") != "response_item" or p.get("type") != "message" or p.get("role") != "user":
            return ""
        text = "".join(
            b.get("text", "") for b in p.get("content") or []
            if isinstance(b, dict) and b.get("type") in ("input_text", "text")
        ).strip()
        return "" if text.startswith(CodexAgent.SYNTHETIC) else text

    @staticmethod
    def old_prompt(rec: dict) -> str:
        """Text of an older Codex user message (`event_msg`/`user_message`), else ''."""
        p = rec.get("payload") or {}
        if rec.get("type") == "event_msg" and p.get("type") == "user_message":
            return (p.get("message") or "").strip()
        return ""

    @staticmethod
    def user_prompts(path: Path) -> int:
        """Prompts the user typed: the newer record kind when the rollout has any,
        else the older kind, so a rollout carrying both is not counted twice."""
        if not path.is_file():
            return 0
        modern = old = 0
        for rec in read_jsonl(path):
            if CodexAgent.modern_prompt(rec):
                modern += 1
            elif CodexAgent.old_prompt(rec):
                old += 1
        return modern or old

    def remove(self, s: Session) -> None:
        conn = sqlite3.connect(self.db)
        try:
            cur = conn.cursor()
            tables = [r[0] for r in cur.execute(
                "SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'"
            )]
            for table in tables:
                if table == "threads":
                    continue
                quoted = '"' + table.replace('"', '""') + '"'
                columns = {r[1] for r in cur.execute(f"PRAGMA table_info({quoted})")}
                for column in ("thread_id", "parent_thread_id", "child_thread_id"):
                    if column in columns:
                        cur.execute(f"DELETE FROM {quoted} WHERE {column} = ?", (s.id,))
            cur.execute("DELETE FROM threads WHERE id = ?", (s.id,))
            conn.commit()
        finally:
            conn.close()
        s.path.unlink(missing_ok=True)

    def resume(self, s: Session) -> None:
        exec_agent(s, ["codex", "resume", s.id])

    def transcript(self, s: Session) -> list[Turn]:
        if not s.path.is_file():
            return []
        # Same rule as user_prompts: take one kind of user record, never both.
        modern = any(self.modern_prompt(rec) for rec in read_jsonl(s.path))
        turns = []
        for rec in read_jsonl(s.path):
            ts = (rec.get("timestamp") or "")[:19].replace("T", " ")
            p = rec.get("payload") or {}
            typ = p.get("type")
            body = self.modern_prompt(rec) if modern else self.old_prompt(rec)
            if body:
                turns.append(("USER", ts, body))
            elif rec.get("type") != "response_item":
                continue
            elif typ == "message" and p.get("role") == "assistant":
                text = "\n".join(
                    b.get("text", "") for b in p.get("content") or [] if b.get("type") == "output_text"
                ).strip()
                if text:
                    turns.append(("ASSISTANT", ts, text))
            elif typ == "function_call":
                try:
                    args = json.loads(p.get("arguments") or "{}")
                except json.JSONDecodeError:
                    args = {}
                turns.append(("ASSISTANT", ts, tool_marker(p.get("name", "?"), args if isinstance(args, dict) else {})))
            elif typ == "custom_tool_call":
                turns.append(("ASSISTANT", ts, tool_marker(p.get("name", "?"), {"input": p.get("input")})))
            elif typ == "web_search_call":
                turns.append(("ASSISTANT", ts, tool_marker("web_search", (p.get("action") or {}))))
        return turns


class OpenCodeAgent(Agent):
    name = "opencode"

    def __init__(self):
        data_home = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local" / "share")
        self.db = (data_home / "opencode" / "opencode.db").expanduser()

    def connect(self, readonly: bool = True) -> sqlite3.Connection:
        if readonly:
            return sqlite3.connect(self.db.resolve().as_uri() + "?mode=ro", uri=True, timeout=5)
        return sqlite3.connect(self.db, timeout=10)

    def sessions(self, cwd: Path | None) -> list[Session]:
        if not self.db.is_file():
            return []
        query = (
            "SELECT s.id, s.directory, s.title, s.slug, s.time_updated,"
            " COALESCE(m.size, 0), COALESCE(m.prompts, 0)"
            " FROM session_v2 AS s LEFT JOIN ("
            " SELECT session_id, SUM(length(CAST(data AS BLOB))) AS size,"
            " SUM(CASE WHEN type = 'user' THEN 1 ELSE 0 END) AS prompts"
            " FROM session_message GROUP BY session_id"
            ") AS m ON m.session_id = s.id"
        )
        params: tuple[str, ...] = ()
        if cwd is not None:
            query += " WHERE s.directory = ?"
            params = (str(cwd),)
        try:
            conn = self.connect()
            try:
                rows = conn.execute(query, params).fetchall()
            finally:
                conn.close()
        except sqlite3.DatabaseError:
            return []
        out = []
        for sid, directory, title, slug, updated, size, prompts in rows:
            title = " ".join((title or slug or "").split())
            out.append(Session(self.name, sid, updated / 1000, size, prompts, title, self.db, directory))
        return out

    def remove(self, s: Session) -> None:
        if not self.db.is_file():
            return
        conn = self.connect(readonly=False)
        try:
            conn.execute("PRAGMA foreign_keys = ON")
            conn.execute("DELETE FROM session_v2 WHERE id = ?", (s.id,))
            conn.commit()
        finally:
            conn.close()

    def resume(self, s: Session) -> None:
        exec_agent(s, ["opencode", "--session", s.id])

    def transcript(self, s: Session) -> list[Turn]:
        if not self.db.is_file():
            return []
        try:
            conn = self.connect()
            try:
                rows = conn.execute(
                    "SELECT type, data FROM session_message WHERE session_id = ? ORDER BY seq",
                    (s.id,),
                ).fetchall()
            finally:
                conn.close()
        except sqlite3.DatabaseError:
            return []
        turns = []
        for typ, raw in rows:
            try:
                data = json.loads(raw)
            except json.JSONDecodeError:
                continue
            ts = self.timestamp(data.get("time") or {})
            if typ == "user":
                body = (data.get("text") or "").strip()
                if body:
                    turns.append(("USER", ts, body))
            elif typ == "assistant":
                lines = []
                for part in data.get("content") or []:
                    if not isinstance(part, dict):
                        continue
                    if part.get("type") == "text":
                        text = (part.get("text") or "").strip()
                        if text:
                            lines.append(text)
                    elif part.get("type") == "tool":
                        state = part.get("state") or {}
                        inp = state.get("input") if isinstance(state, dict) else {}
                        name = part.get("name") or part.get("tool") or "?"
                        lines.append(tool_marker(name, inp if isinstance(inp, dict) else {}))
                if lines:
                    turns.append(("ASSISTANT", ts, "\n".join(lines)))
        return turns

    @staticmethod
    def timestamp(time: dict) -> str:
        created = time.get("created")
        if not isinstance(created, (int, float)):
            return ""
        return datetime.fromtimestamp(created / 1000).strftime("%Y-%m-%d %H:%M:%S")


AGENTS: list[Agent] = [ClaudeAgent(), CodexAgent(), OpenCodeAgent()]
AGENT_WIDTH = max(len(a.name) for a in AGENTS)


def all_sessions(cwd: Path | None) -> list[Session]:
    """Sessions of every agent for cwd (None = every directory), oldest first."""
    return sorted((s for a in AGENTS for s in a.sessions(cwd)), key=lambda s: s.mtime)


def where(cwd: Path | None) -> str:
    return str(cwd) if cwd else "any directory"


def cwd_width(rows: list[Session], cwd: Path | None) -> int:
    """Width of the CWD column: shown only when listing every directory."""
    return max((len(r.cwd) for r in rows), default=0) if cwd is None else 0


COLUMNS = (
    ("AGENT", AGENT_WIDTH, "agent", "<"),
    ("SESSION ID", 38, "id", "<"),
    ("MODIFIED", 19, "mtime", "<"),
    ("SIZE", 10, "size", ">"),
    ("PROMPTS", 7, "prompts", ">"),
)


def columns(cw: int = 0) -> list[tuple[str, int, str, str]]:
    """(label, width, sort attribute, alignment) of the header columns, CWD last when shown."""
    return list(COLUMNS) + ([("CWD", cw, "cwd", "<")] if cw else [])


def header(cw: int = 0, sort_attr: str | None = None, reverse: bool = False) -> str:
    """Header line; the sorted column is highlighted and shows its direction."""
    arrow = "↓" if reverse else "↑"
    line = ""
    for label, width, attr, align in columns(cw):
        cell = f"{label:{align}{width}}"
        gap = "  "
        if attr == sort_attr:
            if len(label) + 1 <= width:  # room for the arrow inside the column
                text = label + arrow
                pad = " " * (width - len(text))
                cell = pad + f"\x1b[7m{text}\x1b[27m" if align == ">" else f"\x1b[7m{text}\x1b[27m" + pad
            else:  # no room (PROMPTS is labelled to its full width): use the gap
                cell = f"\x1b[7m{label:{align}{width}}{arrow}\x1b[27m"
                gap = " "
        line += cell + gap
    title = "TITLE" + arrow if sort_attr == "title" else "TITLE"
    return line + (f"\x1b[7m{title}\x1b[27m" if sort_attr == "title" else title)


def header_spans(cw: int = 0) -> list[tuple[int, int, str]]:
    """(start, end, sort attribute) of each clickable header column."""
    spans, x = [], 0
    for _, width, attr, _ in columns(cw):
        spans.append((x, x + width, attr))
        x += width + 2
    spans.append((x, 1 << 30, "title"))
    return spans


def sort_key(attr: str):
    """Sort key for a column; text sorts case-insensitively."""
    def key(s: Session):
        v = getattr(s, attr)
        return v.lower() if isinstance(v, str) else v
    return key


def agent_of(s: Session) -> Agent:
    return next(a for a in AGENTS if a.name == s.agent)


def format_row(s: Session, cw: int = 0) -> str:
    mtime = datetime.fromtimestamp(s.mtime).strftime("%Y-%m-%d %H:%M:%S")
    col = f"{s.cwd:{cw}}  " if cw else ""
    return f"{s.agent:{AGENT_WIDTH}}  {s.id:38}  {mtime:19}  {s.size:>10}  {s.prompts:>7}  {col}{s.title}"


def list_sessions(cwd: Path | None) -> int:
    rows = all_sessions(cwd)
    if not rows:
        print(f"No sessions for {where(cwd)}")
        return 0
    cw = cwd_width(rows, cwd)
    print(header(cw))
    for row in rows:
        print(format_row(row, cw))
    return 0


def snippet(line: str, m: re.Match, width: int = 120) -> Hit:
    """The part of line around match m, at most about width chars, and the match span in it."""
    start = max(0, m.start() - (width - (m.end() - m.start())) // 2)
    end = start + width
    text = line[start:end]
    lead = 1 if start else 0
    return (
        "…" * lead + text + ("…" if end < len(line) else ""),
        lead + m.start() - start,
        lead + min(m.end(), end) - start,
    )


def terminal_color(ps: int) -> tuple[int, int, int] | None:
    """Terminal colour ps (10 foreground, 11 background) as 8-bit RGB; None if unanswered."""
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return None
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    tty.setcbreak(fd)
    try:
        sys.stdout.write(f"\x1b]{ps};?\x1b\\")
        sys.stdout.flush()
        reply = b""
        while not reply.endswith((b"\x07", b"\x1b\\")) and select.select([fd], [], [], 0.1)[0]:
            reply += os.read(fd, 64)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
    m = re.search(rb"rgb:([0-9a-fA-F]+)/([0-9a-fA-F]+)/([0-9a-fA-F]+)", reply)
    if not m:
        return None
    return tuple(int(c, 16) * 255 // (16 ** len(c) - 1) for c in m.groups())


def shade_codes() -> tuple[str, str, str]:
    """Background escapes: (row highlight, keyword highlight, current row when marked).

    The first two sit slightly off the terminal bg; the last is the midpoint between
    the terminal bg and fg."""
    bg = terminal_color(11)
    if bg is None:
        return "\x1b[48;5;236m", "\x1b[48;5;240m", "\x1b[48;5;236m"
    step = 20 if sum(bg) < 3 * 128 else -20
    r, g, b = (min(255, max(0, c + step)) for c in bg)
    r2, g2, b2 = (min(255, max(0, c + 2 * step)) for c in bg)
    fg = terminal_color(10)
    if fg is None:
        return f"\x1b[48;2;{r};{g};{b}m", f"\x1b[48;2;{r2};{g2};{b2}m", f"\x1b[48;2;{r};{g};{b}m"
    r3, g3, b3 = ((c + s) // 2 for c, s in zip(bg, fg))
    return (
        f"\x1b[48;2;{r};{g};{b}m",
        f"\x1b[48;2;{r2};{g2};{b2}m",
        f"\x1b[48;2;{r3};{g3};{b3}m",
    )


def find_hits(s: Session, rx: re.Pattern) -> list[Hit]:
    """Snippet, with the match span, of each distinct matching line in the session."""
    lines = [s.title] + [l for _, _, body in agent_of(s).transcript(s) for l in body.splitlines()]
    return list(dict.fromkeys(snippet(l.strip(), m) for l in lines if (m := rx.search(l.strip()))))


def dump_session(s: Session, out: Path) -> None:
    """Write a clean, readable dump of a session transcript to out.

    Keeps real user-typed text, assistant text, and compact one-line tool
    markers. Drops thinking/reasoning and raw tool results. Groups
    consecutive assistant records into a single response block.
    """
    # Merge consecutive ASSISTANT turns into one block (keep first ts).
    merged = []
    for role, ts, body in agent_of(s).transcript(s):
        if merged and role == "ASSISTANT" and merged[-1][0] == "ASSISTANT":
            merged[-1] = (role, merged[-1][1], merged[-1][2] + "\n" + body)
        else:
            merged.append((role, ts, body))

    with out.open("w") as o:
        for role, ts, body in merged:
            o.write(f"\n{'─'*6} [{ts}] {role} {'─'*6}\n{body}\n")

    print(f"{len(merged)} turns written to {out}")


def confirm_remove(rows: list[Session], cwd: Path | None) -> str:
    """Confirm then remove rows; returns 'removed', or 'back' if Esc was pressed."""
    cw = cwd_width(rows, cwd)
    print(header(cw))
    for row in rows:
        print(format_row(row, cw))
    if not ask_enter(
        f"Remove {len(rows)} session(s) for {where(cwd)}? [Enter/Esc] "
    ):
        return "back"
    for row in rows:
        agent_of(row).remove(row)
    print(f"Removed {len(rows)} session(s).")
    return "removed"


def copy_to_clipboard(text: str) -> bool:
    """Put text on the system clipboard; True if a native tool (not just the terminal) took it.

    Prefers wl-copy/xclip/xsel, setting both CLIPBOARD and PRIMARY since
    Shift+Insert pastes either depending on the terminal. Falls back to OSC 52,
    which works over SSH but is ignored by some terminals (e.g. Konsole 23.08).
    """
    if os.environ.get("WAYLAND_DISPLAY") and shutil.which("wl-copy"):
        cmds = (["wl-copy"], ["wl-copy", "--primary"])
    elif os.environ.get("DISPLAY") and shutil.which("xclip"):
        cmds = (["xclip", "-selection", "clipboard"], ["xclip", "-selection", "primary"])
    elif os.environ.get("DISPLAY") and shutil.which("xsel"):
        cmds = (["xsel", "--clipboard", "--input"], ["xsel", "--primary", "--input"])
    else:
        cmds = ()
    native = False
    for cmd in cmds:
        try:
            subprocess.run(cmd, input=text.encode(), check=True, timeout=5)
            native = True
        except (OSError, subprocess.SubprocessError):
            continue
    if not native:
        sys.stdout.write(f"\x1b]52;c;{base64.b64encode(text.encode()).decode()}\x07")
        sys.stdout.flush()
    return native


_pending = b""  # input bytes cursor_row read while waiting for the terminal's reply


def read_byte(fd: int) -> bytes:
    global _pending
    if _pending:
        byte, _pending = _pending[:1], _pending[1:]
        return byte
    return os.read(fd, 1)


def cursor_row(fd: int) -> int | None:
    """The terminal's cursor row (1-based), asked for with DSR; None if it doesn't answer."""
    global _pending
    sys.stdout.write("\x1b[6n")
    sys.stdout.flush()
    reply = b""
    while len(reply) < 24 and select.select([fd], [], [], 0.2)[0]:
        reply += os.read(fd, 1)
        if re.search(rb"\x1b\[(\d+);\d+R", reply):
            break
    m = re.search(rb"\x1b\[(\d+);\d+R", reply)
    if m is None:
        _pending += reply  # keys typed while we waited: give them back
        return None
    _pending += reply[:m.start()] + reply[m.end():]
    return int(m.group(1))


def read_key(fd: int) -> str | tuple[int, int, int]:
    ch = read_byte(fd)
    if ch != b"\x1b":
        return ch.decode(errors="replace")
    # A bare Esc has nothing following it; keys arrive as CSI/SS3 sequences:
    # ESC [ A / ESC O A (up), ESC [ 1 ; 2 A (shift-up), ESC [ a (rxvt shift-up),
    # ESC [ C / ESC [ D (right/left), ESC [ 3 ~ (Delete),
    # ESC [ < button ; x ; y M (SGR mouse press).
    seq = b""
    while _pending or select.select([fd], [], [], 0.025)[0]:
        seq += read_byte(fd)
        if len(seq) > 1 and seq[-1:] in b"ABCDMmab~":
            break
    if not seq:
        return "esc"
    mouse = re.fullmatch(rb"\[<(\d+);(\d+);(\d+)M", seq)
    if mouse:
        return int(mouse.group(1)), int(mouse.group(2)), int(mouse.group(3))
    return {
        b"[A": "up", b"OA": "up", b"[B": "down", b"OB": "down",
        b"[C": "right", b"OC": "right", b"[D": "left", b"OD": "left",
        b"[1;2A": "shift-up", b"[1;2B": "shift-down",
        b"[a": "shift-up", b"[b": "shift-down",
        b"[3~": "delete",
    }.get(seq, "")


def pick_sessions(
    rows: list[Session],
    cw: int,
    marks: list[int] | None = None,
    hits: dict[tuple[str, str], list[Hit]] | None = None,
    focus: Session | None = None,
    sort: tuple[str, bool] | None = None,
) -> tuple[str, list[int] | Session | str | None, Session, tuple[str, bool]] | None:
    """Inline picker drawn below the cursor.

    hits maps (agent, id) to matched snippets; when given, snippets are shown
    under each session (all of them for the current or a marked row). focus is
    the session to highlight on start. sort is the (attribute, reverse) the list
    was last shown in; rows are re-sorted to it when given. Returns
    (action, payload, current, sort) where action is 'remove'|'dump' (the marked
    row indexes, possibly empty) on Delete/d, 'resume' (session) on Enter,
    'view' (session) on v, 'search' (pattern) on / + Enter, 'back' (None) on Esc
    from a search page, or None on q/Esc at the top level."""
    sort_attr, reverse = sort or ("mtime", False)  # the list starts out oldest first
    if sort is not None:  # rows may not carry the order the caller was shown
        rows.sort(key=sort_key(sort_attr), reverse=reverse)
    fd = sys.stdin.fileno()
    out = sys.stdout
    term = shutil.get_terminal_size()
    width = term.columns - 1
    body = max(1, term.lines - 3)
    total = body + 2  # header + body + footer
    cur = top = 0
    marks = list(marks or [])  # row indexes
    if marks:  # resumed after Esc at the confirmation: start at the first mark
        cur = min(marks)
    if focus is not None:  # resumes after backing out of dump/removal/search
        cur = next(
            (i for i, r in enumerate(rows) if (r.agent, r.id) == (focus.agent, focus.id)), cur
        )
    quit_hint = "quit:q back:Esc" if hits is not None else "quit:q/Esc"
    footer = (
        "move:j/k,↓/↑ search:/ page:Ctrl+f/b top/bottom:g/G title:←→/Tab sort:s toggle:Shift+j/k,Space"
        f" copy-id:y dump:d view:v delete:del goto:Enter {quit_hint}"
    )
    status = ""  # footer message, e.g. after yanking an id
    shift_dir: int | None = None  # direction of the current Shift+j/k run
    shade, match_shade, both_shade = shade_codes()
    spans = header_spans(cw)
    cwd_span = next(((start, end) for start, end, attr in spans if attr == "cwd"), None)

    def content(i: int) -> list[Hit]:
        """Matched snippets shown under row i: all when current or marked, else the first."""
        if hits is None:
            return []
        found = hits.get((rows[i].agent, rows[i].id), [])
        return found if i == cur or i in marks else found[:1]

    def height(i: int) -> int:
        return 1 + len(content(i))

    def toggle(i: int) -> None:
        if i in marks:
            marks.remove(i)
        else:
            marks.append(i)

    def sort_rows(attr: str) -> None:
        """Sort by attr, keeping marks and the cursor on the same sessions."""
        nonlocal cur, marks
        marked = [rows[i] for i in marks]
        here = rows[cur]
        rows.sort(key=sort_key(attr), reverse=reverse)
        marks = [i for i, r in enumerate(rows) if any(r is m for m in marked)]
        cur = next((i for i, r in enumerate(rows) if r is here), 0)

    def content_line(hit: Hit, current: bool, marked: bool) -> str:
        """One snippet line, with the matched keyword in a second highlight colour."""
        prefix = "        │ "
        text, start, end = hit
        text = text[:max(0, width - len(prefix))]
        start, end = min(start, len(text)), min(end, len(text))
        if start < end and (current or marked):
            if current and marked:
                back = both_shade
            elif current:
                back = "\x1b[7m"
            else:
                back = shade
            text = f"{text[:start]}\x1b[0m{match_shade}{text[start:end]}\x1b[0m{back}{text[end:]}"
        return prefix + text

    def frame(footer_line: str) -> list[tuple[int, bool]]:
        """Draw a frame; returns (row index, is the session row) for each body line."""
        nonlocal top
        if cur < top:
            top = cur
        while top < cur and sum(height(i) for i in range(top, cur + 1)) > body:
            top += 1
        lines = [f"\x1b[1m   {header(cw, sort_attr, reverse)}\x1b[0m"]
        row_map = []
        used = 0
        i = top
        while i < len(rows) and used < body:
            current = i == cur
            marked = i in marks
            entry = [f"   {format_row(rows[i], cw)}"[:width]] + [
                content_line(h, current, marked) for h in content(i)
            ]
            entry = entry[:body - used]
            for j, line in enumerate(entry):
                if current and marked:
                    line = f"{both_shade}{line}\x1b[0m"
                elif current:
                    line = f"\x1b[7m{line}\x1b[0m"
                elif marked:
                    line = f"{shade}{line}\x1b[0m"
                lines.append(line)
                row_map.append((i, j == 0))
            used += len(entry)
            i += 1
        lines.append(footer_line[:width])
        lines += [""] * (total - len(lines))
        out.write("".join(f"\r\x1b[K{line}\n" for line in lines) + f"\x1b[{total}A")
        out.flush()
        return row_map

    def bottom_top() -> int:
        """The lowest top can reach: the list's tail fills the body."""
        used, i = 0, len(rows)
        while i > 0 and used + height(i - 1) <= body:
            i -= 1
            used += height(i)
        return i

    def wheel(button: int, trackpad: bool) -> None:
        """Scroll one row per wheel notch (button 64 up, 65 down).

        A mouse notch drags the highlight and leaves the scrolling to frame(),
        which slides the list once the highlight would leave the body. A
        trackpad event pushes the list instead, the highlight keeping its row
        on screen, and the list stops dead at either end so the highlight
        never drifts there."""
        nonlocal cur, top
        step = -1 if button == 64 else 1
        if not trackpad:
            cur = min(max(cur + step, 0), len(rows) - 1)
        elif step < 0:
            if top > 0:  # top <= cur after frame(), so cur keeps its offset
                top -= 1
                cur -= 1
        elif top < bottom_top() and cur < len(rows) - 1:
            top += 1
            cur += 1

    def next_key(timeout: float | None = None) -> str | tuple[int, int, int] | None:
        """read_key, but returns 'resize' when a SIGWINCH arrives instead, and
        None when timeout seconds pass without input."""
        if _pending:
            return read_key(fd)
        ready = select.select([fd, resize_r], [], [], timeout)[0]
        if not ready:
            return None
        if fd in ready:
            return read_key(fd)
        try:  # one redraw per burst of resizes: drain the wakeup bytes
            while os.read(resize_r, 64):
                pass
        except BlockingIOError:
            pass
        return "resize"

    def resize() -> None:
        """Re-measure after a resize and drop the frame drawn at the old size."""
        nonlocal width, body, total, picker_top
        term = shutil.get_terminal_size()
        width, body = term.columns - 1, max(1, term.lines - 3)
        total = body + 2
        out.write("\x1b[J")  # the old frame may be wider or taller than the new one
        out.flush()
        if picker_top is not None:
            picker_top = cursor_row(fd)  # the frame moved: clicks need the new row

    old = termios.tcgetattr(fd)
    tty.setcbreak(fd)
    # A resize must wake the blocked key read: Python retries the interrupted
    # read, so SIGWINCH writes a byte to a pipe and next_key() watches both.
    resize_r, resize_w = os.pipe()
    for pipe_fd in (resize_r, resize_w):
        os.set_blocking(pipe_fd, False)
    old_winch = signal.signal(signal.SIGWINCH, lambda *_: None)
    old_wakeup = signal.set_wakeup_fd(resize_w, warn_on_full_buffer=False)
    # Autowrap off: a line wider than the terminal would take two rows and
    # break the fixed cursor-up count, leaving stale lines behind. Hide the
    # cursor too: it would otherwise blink at the frame's top-left corner.
    out.write("\x1b[?25l\x1b[?7l" + "\n" * total + f"\x1b[{total}A")  # make room below the cursor
    out.flush()
    picker_top = None
    mouse = False
    try:
        # Clicks arrive with absolute coordinates, so remember the header row.
        picker_top = cursor_row(fd)
        if picker_top is not None:
            out.write("\x1b[?1000h\x1b[?1006h")  # report clicks in SGR form
            mouse = True
        held_wheel: int | None = None  # a wheel notch, held until we know its kind
        held_trackpad = False  # the held notch belongs to a run already judged a trackpad
        gap = 0.03  # how long to wait for a companion before calling a notch a mouse's
        while True:
            row_map = frame(status or footer)
            key = next_key(gap if held_wheel is not None else None)
            if key is None:  # no companion came: the held notch was a mouse wheel
                wheel(held_wheel, held_trackpad)
                held_wheel, held_trackpad = None, False
                continue
            if key == "resize":
                resize()
                continue
            status = ""
            if key not in ("J", "K", "shift-down", "shift-up"):
                shift_dir = None  # any other key ends the current shift run
            wheel_key = isinstance(key, tuple) and key[0] in (64, 65)
            if held_wheel is not None and not wheel_key:  # the run ended after all
                wheel(held_wheel, held_trackpad)
                held_wheel, held_trackpad = None, False
            if wheel_key:
                # A trackpad floods in wheel events a few ms apart where a mouse
                # wheel sends one notch at a time, so hold each notch for one
                # gap: a companion arriving first makes it a trackpad event, the
                # timeout makes it a mouse notch.
                if held_wheel is not None:
                    wheel(held_wheel, True)
                    held_trackpad = True
                held_wheel = key[0]
                continue
            if isinstance(key, tuple):
                button, x, y = key
                col = x - 1  # 0-based screen column; the rows start three chars in
                row = y - picker_top - 1 if picker_top is not None else -1
                hit = next((attr for start, end, attr in spans
                            if 3 + start <= col < 3 + end), None)
                if button == 0 and y == picker_top and hit:
                    if hit == sort_attr:
                        reverse = not reverse
                    else:
                        sort_attr, reverse = hit, False
                    sort_rows(hit)
                elif button == 0 and 0 <= row < len(row_map):
                    cur, on_session_row = row_map[row]
                    s = rows[cur]
                    if on_session_row and cwd_span and s.cwd and 3 + cwd_span[0] <= col < 3 + cwd_span[1]:
                        target = s.cwd
                    else:
                        target = str(s.path.parent)
                    status = f"Copied {target}" if copy_to_clipboard(target) else f"OSC 52 only: {target}"
                continue
            if key in ("j", "down"):
                cur = min(cur + 1, len(rows) - 1)
            elif key in ("k", "up"):
                cur = max(cur - 1, 0)
            elif key == "\x06":  # Ctrl+f
                cur = min(cur + body, len(rows) - 1)
            elif key == "\x02":  # Ctrl+b
                cur = max(cur - body, 0)
            elif key == "g":
                cur = 0
            elif key == "G":
                cur = len(rows) - 1
            elif key in ("\t", "right", "left"):
                # Cycle the sort through the header columns, TITLE included.
                attrs = [attr for _, _, attr in spans]
                i = next((n for n, attr in enumerate(attrs) if attr == sort_attr), -1)
                step = -1 if key == "left" else 1
                sort_attr = attrs[(i + step) % len(attrs)]
                sort_rows(sort_attr)
            elif key == "s":
                reverse = not reverse
                sort_rows(sort_attr)
            elif key in ("J", "K", "shift-down", "shift-up"):
                # Toggle the row you step onto, plus the row you are leaving
                # when the direction changes (or a run starts): holding the
                # key toggles a run of rows, reversing un-toggles it back.
                step = 1 if key in ("J", "shift-down") else -1
                nxt = min(max(cur + step, 0), len(rows) - 1)
                if step != shift_dir:
                    toggle(cur)
                if nxt != cur:
                    toggle(nxt)
                    cur = nxt
                shift_dir = step
            elif key == " ":
                toggle(cur)
            elif key == "y":
                sid = rows[cur].id
                status = f"Copied {sid}" if copy_to_clipboard(sid) else f"OSC 52 only: {sid}"
            elif key == "/":
                pattern = ""
                while True:
                    frame(f"/{pattern}")
                    key = next_key()
                    if key == "resize":
                        resize()
                        continue
                    if key in ("\r", "\n"):
                        if pattern:
                            return "search", pattern, rows[cur], (sort_attr, reverse)
                        break
                    if key in ("esc", "\x0f"):  # Ctrl+O
                        break
                    if key in ("\x7f", "\b"):
                        pattern = pattern[:-1]
                    elif key == "\x15":  # Ctrl+U
                        pattern = ""
                    elif isinstance(key, str) and len(key) == 1 and key.isprintable():
                        pattern += key
            elif key == "v":
                if rows[cur].agent != "claude":
                    status = "The vim viewer supports Claude sessions only"
                else:
                    return "view", rows[cur], rows[cur], (sort_attr, reverse)
            elif key == "d":
                return "dump", marks, rows[cur], (sort_attr, reverse)
            elif key == "delete":
                return "remove", marks, rows[cur], (sort_attr, reverse)
            elif key in ("\r", "\n"):
                return "resume", rows[cur], rows[cur], (sort_attr, reverse)
            elif key == "esc" and hits is not None:
                return "back", None, rows[cur], (sort_attr, reverse)
            elif key in ("q", "esc"):
                return None
    except KeyboardInterrupt:
        return None
    finally:
        signal.set_wakeup_fd(old_wakeup)
        signal.signal(signal.SIGWINCH, old_winch)
        os.close(resize_r)
        os.close(resize_w)
        if mouse:
            out.write("\x1b[?1006l\x1b[?1000l")  # give mouse back to the terminal
        out.write("\r\x1b[J\x1b[?7h\x1b[?25h")  # erase the picker, restore autowrap and cursor
        out.flush()
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


def resume_session(s: Session) -> int:
    try:
        agent_of(s).resume(s)
    except OSError as e:
        print(f"Cannot resume {s.agent} session {s.id}: {e}", file=sys.stderr)
        return 1
    return 0


def ask_enter(prompt: str) -> bool:
    """Wait for Enter (True); Esc, Ctrl+O or Ctrl+C backs out (False)."""
    out = sys.stdout
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    tty.setcbreak(fd)
    try:
        out.write(prompt)
        out.flush()
        while True:
            key = read_key(fd)
            if key in ("\r", "\n"):
                return True
            if key in ("esc", "\x0f"):  # Ctrl+O
                return False
    except KeyboardInterrupt:
        return False
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        out.write("\r\x1b[K")
        out.flush()


def rename_dump(names: list[str]) -> list[str] | None:
    """Rename each dump file on its own line; None if Esc or Ctrl+O backs out.

    Up/Down pick a file, Left/Right move the cursor within it, Enter dumps."""
    names = list(names)
    pos = [len(n) for n in names]  # cursor position, one per name
    sel = 0
    out = sys.stdout
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    tty.setcbreak(fd)
    height = len(names) + 2
    try:
        while True:
            lines = [f"Dump {len(names)} session(s) as:"]
            for i, name in enumerate(names):
                if i == sel:
                    c = pos[i]
                    name = f"{name[:c]}\x1b[7m{name[c:c + 1] or ' '}\x1b[0m{name[c + 1:]}"
                lines.append(f"{'>' if i == sel else ' '} {name}")
            lines.append("[Enter/Esc]")
            out.write("".join(f"\r\x1b[K{line}\n" for line in lines) + f"\x1b[{height}A")
            out.flush()
            key = read_key(fd)
            if key in ("\r", "\n"):
                return names
            if key in ("esc", "\x0f"):  # Ctrl+O
                return None
            if key in ("up", "down"):
                sel = min(max(sel + (1 if key == "down" else -1), 0), len(names) - 1)
            elif key == "left":
                pos[sel] = max(0, pos[sel] - 1)
            elif key == "right":
                pos[sel] = min(len(names[sel]), pos[sel] + 1)
            elif key in ("\x7f", "\b"):
                if pos[sel]:
                    names[sel] = names[sel][:pos[sel] - 1] + names[sel][pos[sel]:]
                    pos[sel] -= 1
            elif key == "\x15":  # Ctrl+U
                names[sel], pos[sel] = "", 0
            elif isinstance(key, str) and len(key) == 1 and key.isprintable():
                names[sel] = names[sel][:pos[sel]] + key + names[sel][pos[sel]:]
                pos[sel] += 1
    except KeyboardInterrupt:
        return None
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        out.write("\r\x1b[J")
        out.flush()


def dump_selected(rows: list[Session]) -> bool:
    """Dump sessions into the current directory; False if the prompt was backed out of."""
    suffix = ".txt" if len(rows) == 1 else "_dump.txt"
    names = rename_dump([f"{s.id}{suffix}" for s in rows])
    if names is None:
        return False
    for s, name in zip(rows, names):
        dump_session(s, Path(name.strip() or f"{s.id}{suffix}"))
    return True



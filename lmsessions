@dataclass
class Session:
    agent: str
    id: str
    mtime: float
    size: int
    prompts: int
    title: str
    path: Path
    cwd: str


Turn = tuple[str, str, str]  # (role, timestamp, body)
Hit = tuple[str, int, int]  # (snippet text, match start, match end within the snippet)


NORMAL_PARTS = (
    "user", "assistant", "system", "thinking", "tool", "note", "attachment",
    "api", "loop", "procedure",
    "compaction",
)
NORMAL_LABELS = (
    ("user", "user (用户输入与上下文摘要)"),
    ("assistant", "assistant (模型回复正文)"),
    ("system", "system (API 请求中的系统提示词)"),
    ("thinking", "thinking (模型思考或思考摘要)"),
    ("tool", "tool calls (模型工具调用及工具返回结果)"),
    ("note", "notes (压缩边界、错误、中断等运行日志)"),
    ("attachment", "attachments (指令、文件等注入上下文)"),
    ("api", "API requests (重建的模型请求、参数及正文)"),
    ("loop", "loops (单次模型响应的分组折叠)"),
    ("procedure", "procedures (一个用户回合内多次响应的分组折叠)"),
)


def normal_view_labels(agent: str) -> tuple[tuple[str, str], ...]:
    """Only offer sections supported by the selected agent's normal renderer."""
    if agent == "claude":
        return NORMAL_LABELS
    labels = dict(NORMAL_LABELS)
    if agent == "codex":
        keys = ("user", "assistant", "system", "thinking", "tool", "note", "loop", "procedure")
        labels["user"] = "user (用户输入)"
        labels["system"] = "context (system/developer 指令及注入的用户上下文)"
        labels["thinking"] = "reasoning (推理摘要与已记录的原始思考)"
        labels["note"] = "notes (错误、流错误与用户中断)"
    else:  # OpenCode
        keys = ("user", "assistant", "thinking", "tool", "compaction", "system", "loop", "procedure")
        labels["user"] = "user (用户消息正文)"
        labels["thinking"] = "reasoning (assistant 消息中的推理内容)"
        labels["system"] = "system (会话中的系统消息)"
        labels["compaction"] = "compaction (上下文压缩摘要及触发原因)"
    return tuple((key, labels[key]) for key in keys)


@dataclass
class ViewOptions:
    """Settings for the viewer, edited before vim opens."""
    max_messages: int = 6  # -1 = every API request message, 0 = none
    normal_parts: tuple[str, ...] = NORMAL_PARTS
    raw: bool = False


def file_size(path: Path) -> int:
    """Size of a transcript file, decompressed when it is stored as .zst; zero if it is missing."""
    try:
        if path.suffix == ".zst":
            data = path.read_bytes()
            return len(zstd.decompress(data)) if zstd else len(data)
        return path.stat().st_size
    except FileNotFoundError:
        return 0


def read_jsonl(path: Path):
    """The transcript's JSON objects, decompressing a .zst rollout on the fly."""
    if path.suffix == ".zst":
        if zstd is None:
            return
        stream = zstd.open(path, "rt", encoding="utf-8", errors="replace")
    else:
        stream = path.open(errors="replace")
    with stream:
        for line in stream:
            line = line.strip()
            if not line:
                continue
            try:
                yield json.loads(line)
            except json.JSONDecodeError:
                continue


def tool_marker(name: str, inp: dict) -> str:
    for k in ("description", "command", "file_path", "path", "prompt", "query", "pattern", "cmd", "input"):
        v = inp.get(k)
        if v:
            v = " ".join(str(v).split())
            if len(v) > 100:
                v = v[:100] + "…"
            return f"    → {name}: {v}"
    return f"    → {name}"


def exec_agent(s: Session, argv: list[str]) -> None:
    """Replace this process with the agent tool, continuing session s in its directory."""
    if s.cwd and Path(s.cwd).is_dir():
        os.chdir(s.cwd)
    os.execvp(argv[0], argv)


class Agent:
    name: str
    removable = True
    viewable = True

    def sessions(self, cwd: Path | None) -> list[Session]:
        """Sessions started in cwd, or in any directory if cwd is None."""
        raise NotImplementedError

    def remove(self, s: Session) -> None:
        raise NotImplementedError

    def move(self, s: Session, directory: Path) -> None:
        """Change workspace metadata while leaving transcript storage in place."""
        raise NotImplementedError

    def resume(self, s: Session) -> None:
        raise NotImplementedError

    def transcript(self, s: Session) -> list[Turn]:
        """User text, assistant text and one-line tool markers, in order."""
        raise NotImplementedError

    def view(self, s: Session, view: "ViewBuilder", tmpdir: Path, options: ViewOptions) -> None:
        """Render s into the viewer's buffer as folded sections."""
        raise NotImplementedError


class ClaudeAgent(Agent):
    name = "claude"

    def sessions(self, cwd: Path | None) -> list[Session]:
        projects = Path.home() / ".claude" / "projects"
        # A workspace change updates metadata, not the transcript's storage
        # bucket. Inspect cwd even when the file lives in another project dir.
        files = projects.glob("*/*.jsonl")
        out = []
        target = os.path.realpath(cwd) if cwd is not None else None
        for f in files:
            size = file_size(f)
            title, scwd, prompts = self.title_and_cwd(f)
            # Distinct paths can share one project dir ("a_b" and "a.b" both become
            # "a-b"), so keep only sessions actually started in cwd.
            if target and scwd and os.path.realpath(scwd) != target:
                continue
            if target and not scwd and f.parent.name != self.project_name(cwd):
                continue
            out.append(Session(self.name, f.stem, f.stat().st_mtime, size, prompts, title, f, scwd or str(cwd or "")))
        return out

    @staticmethod
    def project_name(cwd: Path) -> str:
        """Claude Code's project dir name for cwd: every non-alphanumeric char becomes '-'."""
        return re.sub(r"[^a-zA-Z0-9]", "-", str(cwd))

    @staticmethod
    def title_and_cwd(path: Path) -> tuple[str, str, int]:
        """Latest title (a /rename custom title wins over the AI one), or the first
        user prompt when the session has neither; the session's cwd; and how many
        prompts the user typed. Rewound records are ignored."""
        records = list(read_jsonl(path))
        active = claude_active_uuids(records)
        custom = ai = cwd = first = ""
        prompts = 0
        for entry in records:
            if (
                active is not None
                and isinstance(entry.get("uuid"), str)
                and not entry.get("isSidechain")
                and entry["uuid"] not in active
            ):
                continue
            typ = entry.get("type")
            if typ == "custom-title":
                custom = entry.get("customTitle", "") or custom
            elif typ == "ai-title":
                ai = entry.get("aiTitle", "") or ai
            elif typ == "user" and not entry.get("isMeta"):
                text = " ".join(ClaudeAgent.user_text(entry.get("message") or {}).split())
                # Skip the synthetic records Claude Code writes for slash commands.
                if text and not text.startswith(("<local-command", "<command-name", "<command-message")):
                    prompts += 1
                    first = first or text
            cwd = cwd or entry.get("cwd", "")
        title = custom or ai or (first[:60] + "…" if len(first) > 60 else first)
        return title, cwd, prompts

    def remove(self, s: Session) -> None:
        s.path.unlink()

    def move(self, s: Session, directory: Path) -> None:
        original = s.path.stat()
        lines = []
        changed = False
        for line in s.path.read_bytes().splitlines(keepends=True):
            try:
                record = json.loads(line)
            except (ValueError, UnicodeDecodeError):
                lines.append(line)
                continue
            if isinstance(record, dict) and "cwd" in record:
                record["cwd"] = str(directory)
                line = (json.dumps(record, ensure_ascii=False) + "\n").encode()
                changed = True
            lines.append(line)
        if not changed:
            lines.insert(0, (json.dumps({"type": "lmsessions-workspace", "cwd": str(directory)}) + "\n").encode())
        # Replace atomically, preserve session ordering/permissions, and refuse
        # to overwrite a transcript that changed while we were editing it.
        fd, name = tempfile.mkstemp(prefix=".workspace-", dir=s.path.parent)
        temp = Path(name)
        try:
            with os.fdopen(fd, "wb") as stream:
                stream.writelines(lines)
            os.chmod(temp, original.st_mode & 0o777)
            os.utime(temp, ns=(original.st_atime_ns, original.st_mtime_ns))
            current = s.path.stat()
            if (current.st_ino, current.st_size, current.st_mtime_ns) != (original.st_ino, original.st_size, original.st_mtime_ns):
                raise OSError("Session changed during move; try again")
            os.replace(temp, s.path)
        finally:
            temp.unlink(missing_ok=True)

    def resume(self, s: Session) -> None:
        exec_agent(s, ["claude", "--resume", s.id])

    def view(self, s: Session, view: "ViewBuilder", tmpdir: Path, options: ViewOptions) -> None:
        claude_view(s, view, tmpdir, options)

    def transcript(self, s: Session) -> list[Turn]:
        records = list(read_jsonl(s.path))
        active = claude_active_uuids(records)
        turns = []
        for rec in records:
            if (
                active is not None
                and isinstance(rec.get("uuid"), str)
                and not rec.get("isSidechain")
                and rec["uuid"] not in active
            ):
                continue
            typ = rec.get("type")
            if typ not in ("user", "assistant"):
                continue
            ts = (rec.get("timestamp") or "")[:19].replace("T", " ")
            msg = rec.get("message", {})
            if typ == "user":
                body = self.user_text(msg)
                if body:
                    turns.append(("USER", ts, body))
            else:
                lines = self.assistant_lines(msg)
                if lines:
                    turns.append(("ASSISTANT", ts, "\n".join(lines)))
        return turns

    @staticmethod
    def user_text(msg: dict) -> str:
        c = msg.get("content")
        if isinstance(c, str):
            return c.strip()
        parts = []
        for b in c or []:
            if isinstance(b, dict) and b.get("type") == "text":
                parts.append(b.get("text", ""))
        return "\n".join(parts).strip()

    @staticmethod
    def assistant_lines(msg: dict) -> list[str]:
        out = []
        for b in msg.get("content") or []:
            if not isinstance(b, dict):
                continue
            if b.get("type") == "text":
                t = b.get("text", "").strip()
                if t:
                    out.append(t)
            elif b.get("type") == "tool_use":
                out.append(tool_marker(b.get("name", "?"), b.get("input", {}) or {}))
        return out


class CodexAgent(Agent):
    name = "codex"

    def __init__(self):
        home = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex")).expanduser()
        self.db = home / "state_5.sqlite"

    def sessions(self, cwd: Path | None) -> list[Session]:
        if not self.db.exists():
            return []
        query = "SELECT id, name, title, updated_at, updated_at_ms, rollout_path, cwd FROM threads"
        conn = sqlite3.connect(self.db)
        try:
            if cwd is None:
                rows = conn.execute(query).fetchall()
            else:
                rows = conn.execute(query + " WHERE cwd = ?", (str(cwd),)).fetchall()
        finally:
            conn.close()
        out = []
        for sid, name, title, updated_at, updated_at_ms, rollout, scwd in rows:
            path = Path(rollout)
            if not path.is_file() and Path(f"{rollout}.zst").is_file():
                path = Path(f"{rollout}.zst")  # Codex compresses old rollouts
            mtime = updated_at_ms / 1000 if updated_at_ms is not None else updated_at
            size = file_size(path)
            title = " ".join((name or title or "").split())
            out.append(Session(self.name, sid, mtime, size, self.user_prompts(path), title, path, scwd))
        return out

    # Records newer Codex versions inject as user messages that the user never typed.
    SYNTHETIC = (
        "<environment_context", "<user_instructions", "<external_codex_apps_open_page",
        "# AGENTS.md instructions for ", "<turn_aborted>", "<subagent_notification",
    )

    @staticmethod
    def modern_prompt(rec: dict) -> str:
        """Text of a newer Codex user message (`response_item`/`message`/`user`), else ''."""
        p = rec.get("payload") or {}
        if rec.get("type") != "response_item" or p.get("type") != "message" or p.get("role") != "user":
            return ""
        text = "".join(
            b.get("text", "") for b in p.get("content") or []
            if isinstance(b, dict) and b.get("type") in ("input_text", "text")
        ).strip()
        return text if content_source("user", p.get("content"), p) == "user" else ""

    @staticmethod
    def old_prompt(rec: dict) -> str:
        """Text of an older Codex user message (`event_msg`/`user_message`), else ''."""
        p = rec.get("payload") or {}
        if rec.get("type") == "event_msg" and p.get("type") == "user_message":
            text = (p.get("message") or "").strip()
            return text if content_source("user", text, p) == "user" else ""
        return ""

    @staticmethod
    def user_prompts(path: Path) -> int:
        """Prompts the user typed: the newer record kind when the rollout has any,
        else the older kind, so a rollout carrying both is not counted twice."""
        if not path.is_file():
            return 0
        modern = old = 0
        for rec in read_jsonl(path):
            if CodexAgent.modern_prompt(rec):
                modern += 1
            elif CodexAgent.old_prompt(rec):
                old += 1
        return modern or old

    def remove(self, s: Session) -> None:
        conn = sqlite3.connect(self.db)
        try:
            cur = conn.cursor()
            tables = [r[0] for r in cur.execute(
                "SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'"
            )]
            for table in tables:
                if table == "threads":
                    continue
                quoted = '"' + table.replace('"', '""') + '"'
                columns = {r[1] for r in cur.execute(f"PRAGMA table_info({quoted})")}
                for column in ("thread_id", "parent_thread_id", "child_thread_id"):
                    if column in columns:
                        cur.execute(f"DELETE FROM {quoted} WHERE {column} = ?", (s.id,))
            cur.execute("DELETE FROM threads WHERE id = ?", (s.id,))
            conn.commit()
        finally:
            conn.close()
        s.path.unlink(missing_ok=True)

    def move(self, s: Session, directory: Path) -> None:
        conn = sqlite3.connect(self.db, timeout=10)
        try:
            with conn:
                if conn.execute("UPDATE threads SET cwd = ? WHERE id = ?", (str(directory), s.id)).rowcount != 1:
                    raise ValueError("Session no longer exists")
        finally:
            conn.close()

    def resume(self, s: Session) -> None:
        exec_agent(s, ["codex", "resume", s.id])

    def view(self, s: Session, view: "ViewBuilder", tmpdir: Path, options: ViewOptions) -> None:
        codex_view(s, view, tmpdir, options)

    def transcript(self, s: Session) -> list[Turn]:
        if not s.path.is_file():
            return []
        # Same rule as user_prompts: take one kind of user record, never both.
        modern = any(self.modern_prompt(rec) for rec in read_jsonl(s.path))
        turns = []
        for rec in read_jsonl(s.path):
            ts = (rec.get("timestamp") or "")[:19].replace("T", " ")
            p = rec.get("payload") or {}
            typ = p.get("type")
            body = self.modern_prompt(rec) if modern else self.old_prompt(rec)
            if body:
                turns.append(("USER", ts, body))
            elif rec.get("type") != "response_item":
                continue
            elif typ == "message" and p.get("role") == "assistant":
                text = "\n".join(
                    b.get("text", "") for b in p.get("content") or [] if b.get("type") == "output_text"
                ).strip()
                if text:
                    turns.append(("ASSISTANT", ts, text))
            elif typ == "function_call":
                try:
                    args = json.loads(p.get("arguments") or "{}")
                except json.JSONDecodeError:
                    args = {}
                turns.append(("ASSISTANT", ts, tool_marker(p.get("name", "?"), args if isinstance(args, dict) else {})))
            elif typ == "custom_tool_call":
                turns.append(("ASSISTANT", ts, tool_marker(p.get("name", "?"), {"input": p.get("input")})))
            elif typ == "web_search_call":
                turns.append(("ASSISTANT", ts, tool_marker("web_search", (p.get("action") or {}))))
        return turns


class OpenCodeAgent(Agent):
    name = "opencode"

    def __init__(self):
        data_home = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local" / "share")
        self.db = (data_home / "opencode" / "opencode.db").expanduser()

    def connect(self, readonly: bool = True) -> sqlite3.Connection:
        if readonly:
            return sqlite3.connect(self.db.resolve().as_uri() + "?mode=ro", uri=True, timeout=5)
        return sqlite3.connect(self.db, timeout=10)

    def sessions(self, cwd: Path | None) -> list[Session]:
        if not self.db.is_file():
            return []
        query = (
            "SELECT s.id, s.directory, s.title, s.slug, s.time_updated,"
            " COALESCE(m.size, 0), COALESCE(m.prompts, 0)"
            " FROM session_v2 AS s LEFT JOIN ("
            " SELECT session_id, SUM(length(CAST(data AS BLOB))) AS size,"
            " SUM(CASE WHEN type = 'user' THEN 1 ELSE 0 END) AS prompts"
            " FROM session_message GROUP BY session_id"
            ") AS m ON m.session_id = s.id"
        )
        params: tuple[str, ...] = ()
        if cwd is not None:
            query += " WHERE s.directory = ?"
            params = (str(cwd),)
        try:
            conn = self.connect()
            try:
                rows = conn.execute(query, params).fetchall()
            finally:
                conn.close()
        except sqlite3.DatabaseError:
            return []
        out = []
        for sid, directory, title, slug, updated, size, prompts in rows:
            title = " ".join((title or slug or "").split())
            out.append(Session(self.name, sid, updated / 1000, size, prompts, title, self.db, directory))
        return out

    def remove(self, s: Session) -> None:
        if not self.db.is_file():
            return
        conn = self.connect(readonly=False)
        try:
            conn.execute("PRAGMA foreign_keys = ON")
            conn.execute("DELETE FROM session_v2 WHERE id = ?", (s.id,))
            conn.commit()
        finally:
            conn.close()

    def resume(self, s: Session) -> None:
        exec_agent(s, ["opencode", "--session", s.id])

    def move(self, s: Session, directory: Path) -> None:
        conn = self.connect(readonly=False)
        try:
            with conn:
                if conn.execute("UPDATE session_v2 SET directory = ? WHERE id = ?", (str(directory), s.id)).rowcount != 1:
                    raise ValueError("Session no longer exists")
        finally:
            conn.close()

    def view(self, s: Session, view: "ViewBuilder", tmpdir: Path, options: ViewOptions) -> None:
        opencode_view(self, s, view, tmpdir, options)

    def messages(self, s: Session) -> list[tuple[str, dict]]:
        """The session's (type, data) messages in seq order; empty when the db is unavailable."""
        if not self.db.is_file():
            return []
        try:
            conn = self.connect()
            try:
                rows = conn.execute(
                    "SELECT type, data FROM session_message WHERE session_id = ? ORDER BY seq",
                    (s.id,),
                ).fetchall()
            finally:
                conn.close()
        except sqlite3.DatabaseError:
            return []
        out = []
        for typ, raw in rows:
            try:
                out.append((typ, json.loads(raw)))
            except json.JSONDecodeError:
                continue
        return out

    def transcript(self, s: Session) -> list[Turn]:
        turns = []
        for typ, data in self.messages(s):
            ts = self.timestamp(data.get("time") or {})
            if typ == "user":
                body = (data.get("text") or "").strip()
                if body:
                    turns.append(("USER", ts, body))
            elif typ == "assistant":
                lines = []
                for part in data.get("content") or []:
                    if not isinstance(part, dict):
                        continue
                    if part.get("type") == "text":
                        text = (part.get("text") or "").strip()
                        if text:
                            lines.append(text)
                    elif part.get("type") == "tool":
                        state = part.get("state") or {}
                        inp = state.get("input") if isinstance(state, dict) else {}
                        name = part.get("name") or part.get("tool") or "?"
                        lines.append(tool_marker(name, inp if isinstance(inp, dict) else {}))
                if lines:
                    turns.append(("ASSISTANT", ts, "\n".join(lines)))
        return turns

    @staticmethod
    def timestamp(time: dict) -> str:
        created = time.get("created")
        if not isinstance(created, (int, float)):
            return ""
        return datetime.fromtimestamp(created / 1000).strftime("%Y-%m-%d %H:%M:%S")


class AgyAgent(Agent):
    """Google Antigravity CLI (`agy`).

    Conversation metadata lives in one SQLite summary table; each conversation's
    full transcript is a JSONL log under brain/<id>/ (the per-conversation .db
    is the fallback when that log is missing). The vim viewer is not implemented
    yet."""

    name = "agy"
    viewable = False

    def __init__(self):
        self.home = Path.home() / ".gemini" / "antigravity-cli"
        self.db = self.home / "conversation_summaries.db"
        self.conversations = self.home / "conversations"
        self.brain = self.home / "brain"

    def sessions(self, cwd: Path | None) -> list[Session]:
        if not self.db.is_file():
            return []
        try:
            conn = sqlite3.connect(self.db.resolve().as_uri() + "?mode=ro", uri=True, timeout=5)
            try:
                rows = conn.execute(
                    "SELECT conversation_id, title, preview, last_modified_time, workspace_uris"
                    " FROM conversation_summaries"
                ).fetchall()
            finally:
                conn.close()
        except sqlite3.DatabaseError:
            return []
        target = os.path.realpath(cwd) if cwd is not None else None
        out = []
        for sid, title, preview, modified, uris in rows:
            scwd = self.workspace(uris)
            if target and scwd and os.path.realpath(scwd) != target:
                continue
            log = self.log_path(sid)
            path = log if log.is_file() else self.conversations / f"{sid}.db"
            fallback, prompts = self.title_and_prompts(log)
            mtime = self.epoch(modified)
            if mtime <= 0:  # Antigravity stores a zero time as year 1
                mtime = path.stat().st_mtime if path.exists() else 0.0
            title = " ".join((title or preview or fallback).split())
            out.append(Session(self.name, sid, mtime, file_size(path), prompts, title, path, scwd))
        return out

    def log_path(self, sid: str) -> Path:
        return self.brain / sid / ".system_generated" / "logs" / "transcript.jsonl"

    def move(self, s: Session, directory: Path) -> None:
        conn = sqlite3.connect(self.db, timeout=10)
        try:
            with conn:
                row = conn.execute("SELECT workspace_uris FROM conversation_summaries WHERE conversation_id = ?", (s.id,)).fetchone()
                if row is None:
                    raise ValueError("Session no longer exists")
                workspaces = json.loads(row[0] or "[]")
                if not isinstance(workspaces, list):
                    raise ValueError("Invalid workspace_uris: expected a list")
                workspaces = [directory.as_uri()] + workspaces[1:]
                conn.execute("UPDATE conversation_summaries SET workspace_uris = ? WHERE conversation_id = ?",
                             (json.dumps(workspaces, ensure_ascii=False), s.id))
        finally:
            conn.close()

    @staticmethod
    def workspace(uris: str) -> str:
        """Path of the conversation's primary workspace from its JSON URI list."""
        try:
            items = json.loads(uris or "")
        except (json.JSONDecodeError, TypeError):
            return ""
        for uri in items if isinstance(items, list) else []:
            if isinstance(uri, str):
                parsed = urlparse(uri)
                return unquote(parsed.path) if parsed.scheme == "file" else uri
        return ""

    @staticmethod
    def epoch(stamp: str) -> float:
        """Seconds since the epoch from the summary's ISO timestamp (UTC); 0 if unusable."""
        m = re.match(r"(\d{4}-\d\d-\d\d)[T ](\d\d:\d\d:\d\d)(?:\.(\d+))?", stamp or "")
        if not m:
            return 0.0
        try:
            dt = datetime.strptime(f"{m.group(1)} {m.group(2)}", "%Y-%m-%d %H:%M:%S")
        except ValueError:
            return 0.0
        fraction = int((m.group(3) or "0")[:6].ljust(6, "0")) / 1e6
        return dt.replace(tzinfo=timezone.utc).timestamp() + fraction

    @staticmethod
    def user_request(content: str) -> str:
        """The text the user typed, without the metadata Antigravity appends to it."""
        m = re.search(r"<USER_REQUEST>(.*?)</USER_REQUEST>", content or "", re.S)
        return (m.group(1) if m else content).strip()

    @classmethod
    def title_and_prompts(cls, path: Path) -> tuple[str, int]:
        """First user prompt (as a fallback title) and how many prompts the session has."""
        if not path.is_file():
            return "", 0
        first = ""
        prompts = 0
        for rec in read_jsonl(path):
            if rec.get("type") != "USER_INPUT":
                continue
            text = " ".join(cls.user_request(rec.get("content") or "").split())
            if text:
                prompts += 1
                first = first or text
        title = first[:60] + "…" if len(first) > 60 else first
        return title, prompts

    def remove(self, s: Session) -> None:
        """Delete the summary row and the conversation's own brain/, conversation
        db and annotation files."""
        if self.db.is_file():
            conn = sqlite3.connect(self.db, timeout=10)
            try:
                conn.execute("DELETE FROM conversation_summaries WHERE conversation_id = ?", (s.id,))
                conn.commit()
            finally:
                conn.close()
        shutil.rmtree(self.brain / s.id, ignore_errors=True)
        for suffix in ("", "-shm", "-wal"):
            (self.conversations / f"{s.id}.db{suffix}").unlink(missing_ok=True)
        (self.home / "annotations" / f"{s.id}.pbtxt").unlink(missing_ok=True)

    def resume(self, s: Session) -> None:
        exec_agent(s, ["agy", "--conversation", s.id])

    def transcript(self, s: Session) -> list[Turn]:
        log = self.log_path(s.id)
        if not log.is_file():
            return []
        turns = []
        for rec in read_jsonl(log):
            typ = rec.get("type")
            ts = (rec.get("created_at") or "")[:19].replace("T", " ")
            if typ == "USER_INPUT":
                body = self.user_request(rec.get("content") or "")
                if body:
                    turns.append(("USER", ts, body))
            elif typ == "PLANNER_RESPONSE":
                lines = []
                text = (rec.get("content") or "").strip()
                if text:
                    lines.append(text)
                lines.extend(self.marker(c) for c in rec.get("tool_calls") or [] if isinstance(c, dict))
                if lines:
                    turns.append(("ASSISTANT", ts, "\n".join(lines)))
        return turns

    # The log JSON-encodes every tool argument, and Antigravity's argument names
    # differ from the ones tool_marker() knows.
    ARG_KEYS = {
        "commandline": "command",
        "absolutepath": "file_path",
        "path": "file_path",
        "targetfile": "file_path",
        "directorypath": "path",
        "query": "query",
        "prompt": "prompt",
        "message": "input",
        "action": "input",
    }

    @classmethod
    def marker(cls, call: dict) -> str:
        args = {}
        raw = call.get("args")
        for key, value in (raw.items() if isinstance(raw, dict) else ()):
            if isinstance(value, str):
                try:
                    value = json.loads(value)
                except json.JSONDecodeError:
                    pass
            args.setdefault(cls.ARG_KEYS.get(key.lower(), key.lower()), value)
        return tool_marker(call.get("name") or "?", args)


AGENTS: list[Agent] = [ClaudeAgent(), CodexAgent(), OpenCodeAgent(), AgyAgent()]
AGENT_WIDTH = max(len(a.name) for a in AGENTS)


def all_sessions(cwd: Path | None) -> list[Session]:
    """Sessions of every agent for cwd (None = every directory), oldest first."""
    return sorted((s for a in AGENTS for s in a.sessions(cwd)), key=lambda s: s.mtime)


def where(cwd: Path | None) -> str:
    return str(cwd) if cwd else "any directory"


def cwd_width(rows: list[Session], cwd: Path | None) -> int:
    """Width of the CWD column: shown only when listing every directory."""
    return max((len(r.cwd) for r in rows), default=0) if cwd is None else 0


COLUMNS = (
    ("AGENT", AGENT_WIDTH, "agent", "<"),
    ("SESSION ID", 38, "id", "<"),
    ("MODIFIED", 19, "mtime", "<"),
    ("SIZE", 10, "size", ">"),
    ("PROMPTS", 7, "prompts", ">"),
)


def columns(cw: int = 0) -> list[tuple[str, int, str, str]]:
    """(label, width, sort attribute, alignment) of the header columns, CWD last when shown."""
    return list(COLUMNS) + ([("CWD", cw, "cwd", "<")] if cw else [])


def header(cw: int = 0, sort_attr: str | None = None, reverse: bool = False) -> str:
    """Header line; the sorted column is highlighted and shows its direction."""
    arrow = "↓" if reverse else "↑"
    line = ""
    for label, width, attr, align in columns(cw):
        cell = f"{label:{align}{width}}"
        gap = "  "
        if attr == sort_attr:
            if len(label) + 1 <= width:  # room for the arrow inside the column
                text = label + arrow
                pad = " " * (width - len(text))
                cell = pad + f"\x1b[7m{text}\x1b[27m" if align == ">" else f"\x1b[7m{text}\x1b[27m" + pad
            else:  # no room (PROMPTS is labelled to its full width): use the gap
                cell = f"\x1b[7m{label:{align}{width}}{arrow}\x1b[27m"
                gap = " "
        line += cell + gap
    title = "TITLE" + arrow if sort_attr == "title" else "TITLE"
    return line + (f"\x1b[7m{title}\x1b[27m" if sort_attr == "title" else title)


def header_spans(cw: int = 0) -> list[tuple[int, int, str]]:
    """(start, end, sort attribute) of each clickable header column."""
    spans, x = [], 0
    for _, width, attr, _ in columns(cw):
        spans.append((x, x + width, attr))
        x += width + 2
    spans.append((x, 1 << 30, "title"))
    return spans


def sort_key(attr: str):
    """Sort key for a column; text sorts case-insensitively."""
    def key(s: Session):
        v = getattr(s, attr)
        return v.lower() if isinstance(v, str) else v
    return key


def agent_of(s: Session) -> Agent:
    return next(a for a in AGENTS if a.name == s.agent)


def format_row(s: Session, cw: int = 0) -> str:
    mtime = datetime.fromtimestamp(s.mtime).strftime("%Y-%m-%d %H:%M:%S")
    col = f"{s.cwd:{cw}}  " if cw else ""
    return f"{s.agent:{AGENT_WIDTH}}  {s.id:38}  {mtime:19}  {s.size:>10}  {s.prompts:>7}  {col}{s.title}"


def list_sessions(cwd: Path | None) -> int:
    rows = all_sessions(cwd)
    if not rows:
        print(f"No sessions for {where(cwd)}")
        return 0
    cw = cwd_width(rows, cwd)
    print(header(cw))
    for row in rows:
        print(format_row(row, cw))
    return 0


def snippet(line: str, m: re.Match, width: int = 120) -> Hit:
    """The part of line around match m, at most about width chars, and the match span in it."""
    start = max(0, m.start() - (width - (m.end() - m.start())) // 2)
    end = start + width
    text = line[start:end]
    lead = 1 if start else 0
    return (
        "…" * lead + text + ("…" if end < len(line) else ""),
        lead + m.start() - start,
        lead + min(m.end(), end) - start,
    )


def terminal_color(ps: int) -> tuple[int, int, int] | None:
    """Terminal colour ps (10 foreground, 11 background) as 8-bit RGB; None if unanswered."""
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return None
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    tty.setcbreak(fd)
    try:
        sys.stdout.write(f"\x1b]{ps};?\x1b\\")
        sys.stdout.flush()
        reply = b""
        while not reply.endswith((b"\x07", b"\x1b\\")) and select.select([fd], [], [], 0.1)[0]:
            reply += os.read(fd, 64)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
    m = re.search(rb"rgb:([0-9a-fA-F]+)/([0-9a-fA-F]+)/([0-9a-fA-F]+)", reply)
    if not m:
        return None
    return tuple(int(c, 16) * 255 // (16 ** len(c) - 1) for c in m.groups())


def shade_codes() -> tuple[str, str, str]:
    """Background escapes: (row highlight, keyword highlight, current row when marked).

    The first two sit slightly off the terminal bg; the last is the midpoint between
    the terminal bg and fg."""
    bg = terminal_color(11)
    if bg is None:
        return "\x1b[48;5;236m", "\x1b[48;5;240m", "\x1b[48;5;236m"
    step = 20 if sum(bg) < 3 * 128 else -20
    r, g, b = (min(255, max(0, c + step)) for c in bg)
    r2, g2, b2 = (min(255, max(0, c + 2 * step)) for c in bg)
    fg = terminal_color(10)
    if fg is None:
        return f"\x1b[48;2;{r};{g};{b}m", f"\x1b[48;2;{r2};{g2};{b2}m", f"\x1b[48;2;{r};{g};{b}m"
    r3, g3, b3 = ((c + s) // 2 for c, s in zip(bg, fg))
    return (
        f"\x1b[48;2;{r};{g};{b}m",
        f"\x1b[48;2;{r2};{g2};{b2}m",
        f"\x1b[48;2;{r3};{g3};{b3}m",
    )


def find_hits(s: Session, rx: re.Pattern) -> list[Hit]:
    """Snippet, with the match span, of each distinct matching line in the session."""
    lines = [s.title] + [l for _, _, body in agent_of(s).transcript(s) for l in body.splitlines()]
    return list(dict.fromkeys(snippet(l.strip(), m) for l in lines if (m := rx.search(l.strip()))))


def confirm_remove(rows: list[Session], cwd: Path | None) -> str:
    """Confirm then remove rows; returns 'removed', or 'back' if Esc was pressed."""
    cw = cwd_width(rows, cwd)
    print(header(cw))
    for row in rows:
        print(format_row(row, cw))
    if not ask_enter(
        f"Remove {len(rows)} session(s) for {where(cwd)}? [Enter/Esc] "
    ):
        return "back"
    for row in rows:
        agent_of(row).remove(row)
    print(f"Removed {len(rows)} session(s).")
    return "removed"


def copy_to_clipboard(text: str) -> bool:
    """Put text on the system clipboard; True if a native tool (not just the terminal) took it.

    Prefers wl-copy/xclip/xsel, setting both CLIPBOARD and PRIMARY since
    Shift+Insert pastes either depending on the terminal. Falls back to OSC 52,
    which works over SSH but is ignored by some terminals (e.g. Konsole 23.08).
    """
    if os.environ.get("WAYLAND_DISPLAY") and shutil.which("wl-copy"):
        cmds = (["wl-copy"], ["wl-copy", "--primary"])
    elif os.environ.get("DISPLAY") and shutil.which("xclip"):
        cmds = (["xclip", "-selection", "clipboard"], ["xclip", "-selection", "primary"])
    elif os.environ.get("DISPLAY") and shutil.which("xsel"):
        cmds = (["xsel", "--clipboard", "--input"], ["xsel", "--primary", "--input"])
    else:
        cmds = ()
    native = False
    for cmd in cmds:
        try:
            subprocess.run(cmd, input=text.encode(), check=True, timeout=5)
            native = True
        except (OSError, subprocess.SubprocessError):
            continue
    if not native:
        sys.stdout.write(f"\x1b]52;c;{base64.b64encode(text.encode()).decode()}\x07")
        sys.stdout.flush()
    return native


_pending = b""  # input bytes cursor_row read while waiting for the terminal's reply


def read_byte(fd: int) -> bytes:
    global _pending
    if _pending:
        byte, _pending = _pending[:1], _pending[1:]
        return byte
    return os.read(fd, 1)


def cursor_row(fd: int) -> int | None:
    """The terminal's cursor row (1-based), asked for with DSR; None if it doesn't answer."""
    global _pending
    sys.stdout.write("\x1b[6n")
    sys.stdout.flush()
    reply = b""
    while len(reply) < 24 and select.select([fd], [], [], 0.2)[0]:
        reply += os.read(fd, 1)
        if re.search(rb"\x1b\[(\d+);\d+R", reply):
            break
    m = re.search(rb"\x1b\[(\d+);\d+R", reply)
    if m is None:
        _pending += reply  # keys typed while we waited: give them back
        return None
    _pending += reply[:m.start()] + reply[m.end():]
    return int(m.group(1))


def read_key(fd: int) -> str | tuple[int, int, int]:
    ch = read_byte(fd)
    if ch != b"\x1b":
        return ch.decode(errors="replace")
    # A bare Esc has nothing following it; keys arrive as CSI/SS3 sequences:
    # ESC [ A / ESC O A (up), ESC [ 1 ; 2 A (shift-up), ESC [ a (rxvt shift-up),
    # ESC [ C / ESC [ D (right/left), ESC [ Z (shift-tab), ESC [ 3 ~ (Delete),
    # ESC [ < button ; x ; y M (SGR mouse press).
    seq = b""
    while _pending or select.select([fd], [], [], 0.025)[0]:
        seq += read_byte(fd)
        if len(seq) > 1 and seq[-1:] in b"ABCDMmabZ~":
            break
    if not seq:
        return "esc"
    mouse = re.fullmatch(rb"\[<(\d+);(\d+);(\d+)M", seq)
    if mouse:
        return int(mouse.group(1)), int(mouse.group(2)), int(mouse.group(3))
    return {
        b"[A": "up", b"OA": "up", b"[B": "down", b"OB": "down",
        b"[C": "right", b"OC": "right", b"[D": "left", b"OD": "left",
        b"[1;2A": "shift-up", b"[1;2B": "shift-down",
        b"[a": "shift-up", b"[b": "shift-down",
        b"[Z": "shift-tab",
        b"[3~": "delete",
    }.get(seq, "")


def pick_sessions(
    rows: list[Session],
    cw: int,
    marks: list[int] | None = None,
    hits: dict[tuple[str, str], list[Hit]] | None = None,
    focus: Session | None = None,
    sort: tuple[str, bool] | None = None,
    can_back: bool = False,
) -> tuple[str, list[int] | list[Session] | Session | str | None, Session, tuple[str, bool]] | None:
    """Inline picker drawn below the cursor.

    hits maps (agent, id) to matched snippets; when given, snippets are shown
    under each session (all of them for the current or a marked row). focus is
    the session to highlight on start. sort is the (attribute, reverse) the list
    was last shown in; rows are re-sorted to it when given. can_back makes Esc
    back out even without snippets. Returns (action, payload, current, sort)
    where action is 'remove' (the marked row indexes, possibly empty) on
    Delete, 'submenu' (the marked sessions) on Enter when several are marked,
    'resume' (session) on Enter, 'view' (session) on v, 'search' (pattern) on
    / + Enter, 'back' (None) on Esc from a search page (or when can_back), or
    None on q/Esc at the top level."""
    sort_attr, reverse = sort or ("mtime", False)  # the list starts out oldest first
    if sort is not None:  # rows may not carry the order the caller was shown
        rows.sort(key=sort_key(sort_attr), reverse=reverse)
    fd = sys.stdin.fileno()
    out = sys.stdout
    term = shutil.get_terminal_size()
    width = term.columns - 1
    body = max(1, term.lines - 3)
    total = body + 2  # header + body + footer
    cur = top = 0
    marks = list(marks or [])  # row indexes
    if marks:  # resumed after Esc at the confirmation: start at the first mark
        cur = min(marks)
    if focus is not None:  # resumes after backing out of removal/search
        cur = next(
            (i for i, r in enumerate(rows) if (r.agent, r.id) == (focus.agent, focus.id)), cur
        )
    quit_hint = "quit:q back:Esc" if hits is not None or can_back else "quit:q/Esc"
    footer = (
        "move:j/k,↓/↑ search:/ page:Ctrl+f/b top/bottom:g/G title:h/l,←→/Tab sort:s toggle:Shift+j/k,Space"
        f" copy-id:y view:v delete:del goto/open:Enter {quit_hint}"
    )
    status = ""  # footer message, e.g. after yanking an id
    shift_dir: int | None = None  # direction of the current Shift+j/k run
    shade, match_shade, both_shade = shade_codes()
    spans = header_spans(cw)
    cwd_span = next(((start, end) for start, end, attr in spans if attr == "cwd"), None)

    def content(i: int) -> list[Hit]:
        """Matched snippets shown under row i: all when current or marked, else the first."""
        if hits is None:
            return []
        found = hits.get((rows[i].agent, rows[i].id), [])
        return found if i == cur or i in marks else found[:1]

    def height(i: int) -> int:
        return 1 + len(content(i))

    def toggle(i: int) -> None:
        if i in marks:
            marks.remove(i)
        else:
            marks.append(i)

    def sort_rows(attr: str) -> None:
        """Sort by attr, keeping marks and the cursor on the same sessions."""
        nonlocal cur, marks
        marked = [rows[i] for i in marks]
        here = rows[cur]
        rows.sort(key=sort_key(attr), reverse=reverse)
        marks = [i for i, r in enumerate(rows) if any(r is m for m in marked)]
        cur = next((i for i, r in enumerate(rows) if r is here), 0)

    def content_line(hit: Hit, current: bool, marked: bool) -> str:
        """One snippet line, with the matched keyword in a second highlight colour."""
        prefix = "        │ "
        text, start, end = hit
        text = text[:max(0, width - len(prefix))]
        start, end = min(start, len(text)), min(end, len(text))
        if start < end and (current or marked):
            if current and marked:
                back = both_shade
            elif current:
                back = "\x1b[7m"
            else:
                back = shade
            text = f"{text[:start]}\x1b[0m{match_shade}{text[start:end]}\x1b[0m{back}{text[end:]}"
        return prefix + text

    def frame(footer_line: str) -> list[tuple[int, bool]]:
        """Draw a frame; returns (row index, is the session row) for each body line."""
        nonlocal top
        if cur < top:
            top = cur
        while top < cur and sum(height(i) for i in range(top, cur + 1)) > body:
            top += 1
        lines = [f"\x1b[1m   {header(cw, sort_attr, reverse)}\x1b[0m"]
        row_map = []
        used = 0
        i = top
        while i < len(rows) and used < body:
            current = i == cur
            marked = i in marks
            entry = [f"   {format_row(rows[i], cw)}"[:width]] + [
                content_line(h, current, marked) for h in content(i)
            ]
            entry = entry[:body - used]
            for j, line in enumerate(entry):
                if current and marked:
                    line = f"{both_shade}{line}\x1b[0m"
                elif current:
                    line = f"\x1b[7m{line}\x1b[0m"
                elif marked:
                    line = f"{shade}{line}\x1b[0m"
                lines.append(line)
                row_map.append((i, j == 0))
            used += len(entry)
            i += 1
        lines.append(footer_line[:width])
        lines += [""] * (total - len(lines))
        out.write("".join(f"\r\x1b[K{line}\n" for line in lines) + f"\x1b[{total}A")
        out.flush()
        return row_map

    def bottom_top() -> int:
        """The lowest top can reach: the list's tail fills the body."""
        used, i = 0, len(rows)
        while i > 0 and used + height(i - 1) <= body:
            i -= 1
            used += height(i)
        return i

    def wheel(button: int, trackpad: bool) -> None:
        """Scroll one row per wheel notch (button 64 up, 65 down).

        A mouse notch drags the highlight and leaves the scrolling to frame(),
        which slides the list once the highlight would leave the body. A
        trackpad event pushes the list instead, the highlight keeping its row
        on screen, and the list stops dead at either end so the highlight
        never drifts there."""
        nonlocal cur, top
        step = -1 if button == 64 else 1
        if not trackpad:
            cur = min(max(cur + step, 0), len(rows) - 1)
        elif step < 0:
            if top > 0:  # top <= cur after frame(), so cur keeps its offset
                top -= 1
                cur -= 1
        elif top < bottom_top() and cur < len(rows) - 1:
            top += 1
            cur += 1

    def next_key(timeout: float | None = None) -> str | tuple[int, int, int] | None:
        """read_key, but returns 'resize' when a SIGWINCH arrives instead, and
        None when timeout seconds pass without input."""
        if _pending:
            return read_key(fd)
        ready = select.select([fd, resize_r], [], [], timeout)[0]
        if not ready:
            return None
        if fd in ready:
            return read_key(fd)
        try:  # one redraw per burst of resizes: drain the wakeup bytes
            while os.read(resize_r, 64):
                pass
        except BlockingIOError:
            pass
        return "resize"

    def resize() -> None:
        """Re-measure after a resize and drop the frame drawn at the old size."""
        nonlocal width, body, total, picker_top
        term = shutil.get_terminal_size()
        width, body = term.columns - 1, max(1, term.lines - 3)
        total = body + 2
        out.write("\x1b[J")  # the old frame may be wider or taller than the new one
        out.flush()
        if picker_top is not None:
            picker_top = cursor_row(fd)  # the frame moved: clicks need the new row

    def confirm_quit() -> bool:
        """Ask before leaving the whole menu: Enter quits (True); Esc or any
        other key stays put (False). Shown in the footer, matching the
        [Enter/Esc] confirm ask_enter/confirm_remove use elsewhere."""
        prompt = "Quit lmsessions? [Enter/Esc]"
        while True:
            frame(prompt)
            key = next_key()
            if key == "resize":
                resize()
                continue
            return key in ("\r", "\n")

    old = termios.tcgetattr(fd)
    tty.setcbreak(fd)
    # A resize must wake the blocked key read: Python retries the interrupted
    # read, so SIGWINCH writes a byte to a pipe and next_key() watches both.
    resize_r, resize_w = os.pipe()
    for pipe_fd in (resize_r, resize_w):
        os.set_blocking(pipe_fd, False)
    old_winch = signal.signal(signal.SIGWINCH, lambda *_: None)
    old_wakeup = signal.set_wakeup_fd(resize_w, warn_on_full_buffer=False)
    # Autowrap off: a line wider than the terminal would take two rows and
    # break the fixed cursor-up count, leaving stale lines behind. Hide the
    # cursor too: it would otherwise blink at the frame's top-left corner.
    out.write("\x1b[?25l\x1b[?7l" + "\n" * total + f"\x1b[{total}A")  # make room below the cursor
    out.flush()
    picker_top = None
    mouse = False
    try:
        # Clicks arrive with absolute coordinates, so remember the header row.
        picker_top = cursor_row(fd)
        if picker_top is not None:
            out.write("\x1b[?1000h\x1b[?1006h")  # report clicks in SGR form
            mouse = True
        held_wheel: int | None = None  # a wheel notch, held until we know its kind
        held_trackpad = False  # the held notch belongs to a run already judged a trackpad
        gap = 0.03  # how long to wait for a companion before calling a notch a mouse's
        while True:
            row_map = frame(status or footer)
            key = next_key(gap if held_wheel is not None else None)
            if key is None:  # no companion came: the held notch was a mouse wheel
                wheel(held_wheel, held_trackpad)
                held_wheel, held_trackpad = None, False
                continue
            if key == "resize":
                resize()
                continue
            status = ""
            if key not in ("J", "K", "shift-down", "shift-up"):
                shift_dir = None  # any other key ends the current shift run
            wheel_key = isinstance(key, tuple) and key[0] in (64, 65)
            if held_wheel is not None and not wheel_key:  # the run ended after all
                wheel(held_wheel, held_trackpad)
                held_wheel, held_trackpad = None, False
            if wheel_key:
                # A trackpad floods in wheel events a few ms apart where a mouse
                # wheel sends one notch at a time, so hold each notch for one
                # gap: a companion arriving first makes it a trackpad event, the
                # timeout makes it a mouse notch.
                if held_wheel is not None:
                    wheel(held_wheel, True)
                    held_trackpad = True
                held_wheel = key[0]
                continue
            if isinstance(key, tuple):
                button, x, y = key
                col = x - 1  # 0-based screen column; the rows start three chars in
                row = y - picker_top - 1 if picker_top is not None else -1
                hit = next((attr for start, end, attr in spans
                            if 3 + start <= col < 3 + end), None)
                if button == 0 and y == picker_top and hit:
                    if hit == sort_attr:
                        reverse = not reverse
                    else:
                        sort_attr, reverse = hit, False
                    sort_rows(hit)
                elif button == 0 and 0 <= row < len(row_map):
                    cur, on_session_row = row_map[row]
                    s = rows[cur]
                    if on_session_row and cwd_span and s.cwd and 3 + cwd_span[0] <= col < 3 + cwd_span[1]:
                        target = s.cwd
                    else:
                        target = str(s.path.parent)
                    status = f"Copied {target}" if copy_to_clipboard(target) else f"OSC 52 only: {target}"
                continue
            if key in ("j", "down"):
                cur = min(cur + 1, len(rows) - 1)
            elif key in ("k", "up"):
                cur = max(cur - 1, 0)
            elif key == "\x06":  # Ctrl+f
                cur = min(cur + body, len(rows) - 1)
            elif key == "\x02":  # Ctrl+b
                cur = max(cur - body, 0)
            elif key == "g":
                cur = 0
            elif key == "G":
                cur = len(rows) - 1
            elif key in ("\t", "shift-tab", "right", "l", "left", "h"):
                # Cycle the sort through the header columns, TITLE included.
                attrs = [attr for _, _, attr in spans]
                i = next((n for n, attr in enumerate(attrs) if attr == sort_attr), -1)
                step = -1 if key in ("left", "h", "shift-tab") else 1
                sort_attr = attrs[(i + step) % len(attrs)]
                sort_rows(sort_attr)
            elif key == "s":
                reverse = not reverse
                sort_rows(sort_attr)
            elif key in ("J", "K", "shift-down", "shift-up"):
                # Toggle the row you step onto, plus the row you are leaving
                # when the direction changes (or a run starts): holding the
                # key toggles a run of rows, reversing un-toggles it back.
                step = 1 if key in ("J", "shift-down") else -1
                nxt = min(max(cur + step, 0), len(rows) - 1)
                if step != shift_dir:
                    toggle(cur)
                if nxt != cur:
                    toggle(nxt)
                    cur = nxt
                shift_dir = step
            elif key == " ":
                toggle(cur)
            elif key == "y":
                sid = rows[cur].id
                status = f"Copied {sid}" if copy_to_clipboard(sid) else f"OSC 52 only: {sid}"
            elif key == "/":
                pattern = ""
                while True:
                    frame(f"/{pattern}")
                    key = next_key()
                    if key == "resize":
                        resize()
                        continue
                    if key in ("\r", "\n"):
                        if pattern:
                            return "search", pattern, rows[cur], (sort_attr, reverse)
                        break
                    if key in ("esc", "\x0f"):  # Ctrl+O
                        break
                    if key in ("\x7f", "\b"):
                        pattern = pattern[:-1]
                    elif key == "\x15":  # Ctrl+U
                        pattern = ""
                    elif isinstance(key, str) and len(key) == 1 and key.isprintable():
                        pattern += key
            elif key == "v":
                if agent_of(rows[cur]).viewable:
                    return "view", rows[cur], rows[cur], (sort_attr, reverse)
                status = f"The viewer does not support {rows[cur].agent} sessions yet"
            elif key == "delete":
                return "remove", marks, rows[cur], (sort_attr, reverse)
            elif key in ("\r", "\n"):
                if len(marks) > 1:  # a selection narrows the menu to just those rows
                    return (
                        "submenu", [rows[i] for i in sorted(marks)], rows[cur], (sort_attr, reverse)
                    )
                return "resume", rows[cur], rows[cur], (sort_attr, reverse)
            elif key == "esc" and (hits is not None or can_back):
                return "back", None, rows[cur], (sort_attr, reverse)
            elif key in ("q", "esc"):
                if confirm_quit():
                    return None
    except KeyboardInterrupt:
        return None
    finally:
        signal.set_wakeup_fd(old_wakeup)
        signal.signal(signal.SIGWINCH, old_winch)
        os.close(resize_r)
        os.close(resize_w)
        if mouse:
            out.write("\x1b[?1006l\x1b[?1000l")  # give mouse back to the terminal
        out.write("\r\x1b[J\x1b[?7h\x1b[?25h")  # erase the picker, restore autowrap and cursor
        out.flush()
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


def resume_session(s: Session) -> int:
    try:
        agent_of(s).resume(s)
    except OSError as e:
        print(f"Cannot resume {s.agent} session {s.id}: {e}", file=sys.stderr)
        return 1
    return 0


def ask_enter(prompt: str) -> bool:
    """Wait for Enter (True); Esc, Ctrl+O or Ctrl+C backs out (False)."""
    out = sys.stdout
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    tty.setcbreak(fd)
    try:
        out.write(prompt)
        out.flush()
        while True:
            key = read_key(fd)
            if key in ("\r", "\n"):
                return True
            if key in ("esc", "\x0f"):  # Ctrl+O
                return False
    except KeyboardInterrupt:
        return False
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        out.write("\r\x1b[K")
        out.flush()


def edit_view_options(options: ViewOptions, agent: str = "claude") -> ViewOptions | None:
    """Menu shown by v; Enter returns the options (the caller opens vim), Esc backs out.

    Space toggles checkboxes; type the API body size directly on its row."""
    opts = ViewOptions(
        options.max_messages, tuple(options.normal_parts), options.raw,
    )
    number = str(opts.max_messages)
    editing_number = False
    labels = normal_view_labels(agent)

    def rows() -> list[tuple[str, str, str]]:
        out = [("raw", f"[{'x' if opts.raw else ' '}] raw mode", "check")]
        if not opts.raw:
            if agent == "claude":
                out.append(
                    (
                        "limit",
                        f"API body messages: {number}  (-1 = all, 0 = none; 直接输入数字)",
                        "number",
                    )
                )
            for key, label in labels:
                out.append((key, f"[{'x' if key in opts.normal_parts else ' '}] {label}", "check"))
        return out

    sel = 0
    out = sys.stdout
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    tty.setcbreak(fd)
    try:
        while True:
            items = rows()
            sel = min(sel, len(items) - 1)
            lines = [f"View options · {agent} (Enter open vim, Esc back):"]
            for i, (_, text, _) in enumerate(items):
                prefix = "> " if i == sel else "  "
                text = f"\x1b[7m{text}\x1b[27m" if i == sel else text
                lines.append(prefix + text)
            if opts.raw:
                lines.append("仅模型输入原始文本及其 meta；每条消息显示一次。")
            lines.append("Space: toggle" + ("   数量行: 数字/-/Backspace (-1 或非负整数)"
                                            if agent == "claude" and not opts.raw else ""))
            height = len(lines)
            out.write(
                "\x1b[J" + "".join(f"\r\x1b[K{line}\n" for line in lines)
                + f"\x1b[{height}A"
            )
            out.flush()
            key = read_key(fd)
            if key in ("esc", "\x0f"):  # Ctrl+O
                return None
            name, _, kind = items[sel]
            if kind == "number":
                if key in tuple("0123456789-") or key in ("\x7f", "\b", "\x15"):
                    if key in ("\x7f", "\b"):
                        number = number[:-1]
                    elif key == "\x15":
                        number = ""
                    else:
                        number = (number if editing_number else "") + key
                    editing_number = True
                    continue
                if key in ("\r", "\n", "up", "k", "down", "j"):
                    if not re.fullmatch(r"-1|[0-9]+", number):
                        continue
                    opts.max_messages = int(number)
                    number = str(opts.max_messages)
                    editing_number = False
            if key in ("\r", "\n"):
                return opts
            if key in ("up", "k"):
                sel = (sel - 1) % len(items)
                continue
            if key in ("down", "j"):
                sel = (sel + 1) % len(items)
                continue
            if key not in ("left", "h", "right", "l", " "):
                continue
            step = -1 if key in ("left", "h") else 1 if key in ("right", "l") else 0
            if name == "raw":
                if key == " " or step:
                    opts.raw = not opts.raw
                    sel = 0
            elif key == " " and kind == "check":
                picked = list(opts.normal_parts)
                if name in picked:
                    picked.remove(name)
                else:
                    picked.append(name)
                opts.normal_parts = tuple(k for k in NORMAL_PARTS if k in picked)
    except KeyboardInterrupt:
        return None
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        out.write("\r\x1b[J")
        out.flush()


CLAUDE_VIEW_LINES = 300  # a longer tool output shows this many lines; the rest is spilled to a file
VIEW_ATTACHMENTS = {
    "instructions",
    "hook_additional_context",
    "edited_text_file",
    "file",
    "queued_command",
}


@dataclass
class ViewHeading:
    timestamp: str
    index: str
    kind: str
    text: str
    counts: tuple[int, int] | None


class ViewBuilder:
    """Viewer text plus the 1-based (start, end) line ranges to fold."""

    def __init__(self):
        self.lines: list[str] = []
        self.folds: list[tuple[int, int]] = []
        self.spills = 0
        self.counts: tuple[int, int] | None = None
        self.count_width = 1
        self.source_hints = {}
        self.headings: dict[int, ViewHeading] = {}

    def abstract(self, header: str) -> str:
        """Register a heading; layout fits its columns once every fold is known."""
        ts = ""
        match = re.match(r"^(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2})\s*", header)
        if match:
            ts, header = match.group(1), header[match.end():]
        header = header.strip()
        index = ""
        match = re.match(r"^(\[\d+\])\+?\s*", header)
        if match:
            index, header = match.group(1), header[match.end():]
        tag = ""
        if header.startswith("[subagent] "):
            tag, header = "[subagent] ", header[len("[subagent] "):]
        if header.startswith("✗ "):
            tag += "✗ "
            header = header[2:]
        match = re.match(
            r"^(CONTEXT SUMMARY|PROCEDURE|DEVELOPER|ASSISTANT|THINKING|ATTACHMENT|"
            r"SYSTEM|USER|TOOL|LOOP|API|MODEL INPUT|RESULT|CONTEXT|SUMMARY|MIXED)\b[: ]*", header, re.I,
        )
        kind = match.group(1).upper() if match else "NOTE"
        text = header[match.end():] if match else header
        if kind == "RESULT":
            kind = "TOOL"
            text = "result " + text
        self.headings[len(self.lines) + 1] = ViewHeading(ts, index, kind, tag + text, self.counts)
        return view_meta(header)

    def layout(self, raw: bool = False) -> None:
        """Fit columns to real values and indent only normal-view headings.

        Compute hierarchy from final fold ranges so hidden grouping options,
        nested request bodies and hoisted final replies all indent correctly.
        """
        rows = []
        ranges = iter(sorted(self.folds, key=lambda pair: (pair[0], -pair[1])))
        upcoming = next(ranges, None)
        ancestors = []
        for line, heading in sorted(self.headings.items()):
            while upcoming is not None and upcoming[0] < line:
                ancestors = [pair for pair in ancestors if pair[1] >= upcoming[0]]
                ancestors.append(upcoming)
                upcoming = next(ranges, None)
            ancestors = [pair for pair in ancestors if pair[1] >= line]
            in_loop = not raw and any(
                self.headings.get(a) and self.headings[a].kind == "LOOP" for a, _ in ancestors
            )
            counts = heading.counts if not in_loop else None
            fields = [f"USER[{counts[0]}]" if counts else "",
                      f"MSG[{counts[1]}]" if counts else "",
                      heading.index, heading.timestamp, heading.kind]
            rows.append((line, heading, fields, 0 if raw else len(ancestors)))
        widths = [max((len(fields[i]) for _, _, fields, _ in rows), default=0) for i in range(5)]
        for line, heading, fields, depth in rows:
            columns = " ".join(f"{value:<{width}}" for value, width in zip(fields, widths) if width)
            self.lines[line - 1] = "  " * depth + view_meta(columns + " " + heading.text)

    def section(self, header: str, body: "list[str] | ViewBuilder") -> None:
        start = len(self.lines) + 1
        self.lines.append(self.abstract(header))
        if isinstance(body, ViewBuilder):
            offset = len(self.lines)
            self.folds.extend((a + offset, b + offset) for a, b in body.folds)
            self.headings.update((line + offset, heading) for line, heading in body.headings.items())
            body = body.lines
        self.lines.extend(body)
        if body:
            self.folds.append((start, len(self.lines)))
        self.lines.append("")


def view_meta(text: str) -> str:
    """Mark viewer annotations without modifying conversation/request content."""
    return f"⟦meta⟧ {text}"


class Accumulation:
    """Observed context additions: initial user send is zero in both columns."""

    def __init__(self):
        self.user = -1
        self.total = -1

    @property
    def counts(self) -> tuple[int, int]:
        return max(0, self.user), max(0, self.total)

    def advance(self, user: bool = False) -> tuple[int, int]:
        if user:
            self.user += 1
        self.total += 1
        return self.counts


def record_ts(rec: dict) -> str:
    ts = rec.get("timestamp")
    return ts[:19].replace("T", " ") if isinstance(ts, str) else ""


def text_preview(text: str) -> str:
    """The first two sentences or 100 characters, whichever ends first, on one line."""
    flat = " ".join(text.split())
    end = len(flat)
    sentences = 0
    for i, char in enumerate(flat):
        if char in ".!?。！？":
            sentences += 1
            if sentences == 2:
                end = i + 1
                break
    end = min(end, 100)
    return flat[:end].rstrip() + ("…" if end < len(flat) else "")


def content_blocks(rec: dict) -> list[dict]:
    """The record's content blocks when content is a list (Claude's usual shape)."""
    message = rec.get("message")
    content = message.get("content") if isinstance(message, dict) else None
    return [b for b in content if isinstance(b, dict)] if isinstance(content, list) else []


def text_of(content) -> str:
    """Readable text of a tool_result content value (a string or a list of blocks)."""
    if isinstance(content, str):
        return content
    if not isinstance(content, list):
        return "" if content is None else str(content)
    parts = []
    for block in content:
        if not isinstance(block, dict):
            continue
        if block.get("type") == "text":
            parts.append(block.get("text", ""))
        elif block.get("type") == "image":
            parts.append("[image]")
        else:
            parts.append(json.dumps(block, ensure_ascii=False))
    return "\n".join(parts)


def structured_patch(tur: dict) -> str:
    """A unified diff from an Edit/Write toolUseResult, or ''."""
    patch = tur.get("structuredPatch")
    if not isinstance(patch, list) or not patch:
        return ""
    path = tur.get("filePath") or ""
    out = [f"--- {path}", f"+++ {path}"] if path else []
    for hunk in patch:
        if not isinstance(hunk, dict):
            continue
        out.append(
            f"@@ -{hunk.get('oldStart')},{hunk.get('oldLines')}"
            f" +{hunk.get('newStart')},{hunk.get('newLines')} @@"
        )
        out.extend(str(line) for line in hunk.get("lines") or [])
    return "\n".join(out)


def tool_text(rec: dict, block: dict) -> str:
    """Prefer the structured toolUseResult over the model-visible tool_result text."""
    fallback = text_of(block.get("content"))
    tur = rec.get("toolUseResult")
    if tur is None:
        return fallback
    if isinstance(tur, str):
        return tur
    if not isinstance(tur, dict):
        return fallback or json.dumps(tur, ensure_ascii=False)
    patch = structured_patch(tur)
    if patch:
        return patch
    if "stdout" in tur or "stderr" in tur:
        parts = []
        if tur.get("interrupted"):
            parts.append("[interrupted]")
        if tur.get("stderr"):
            parts.append(str(tur["stderr"]).rstrip())
        if tur.get("stdout"):
            parts.append(str(tur["stdout"]).rstrip())
        return "\n".join(parts) or fallback or "(no output)"
    if isinstance(tur.get("result"), str):
        return tur["result"]
    file = tur.get("file")
    if isinstance(file, dict) and isinstance(file.get("content"), str):
        return file["content"]
    return fallback or json.dumps(tur, ensure_ascii=False)


def input_lines(inp) -> list[str]:
    """A tool_use input as readable key/value lines, keeping multi-line strings multi-line."""
    if not isinstance(inp, dict) or not inp:
        return [view_meta("(none)")]
    out = []
    for key, value in inp.items():
        if isinstance(value, str) and "\n" in value:
            out.append(f"{key}:")
            out.extend(value.splitlines())
        else:
            out.append(f"{key}: {json.dumps(value, ensure_ascii=False)}")
    return out


def spill_lines(view: ViewBuilder, text: str, tmpdir: Path) -> list[str]:
    """The first CLAUDE_VIEW_LINES lines; a longer text is written whole to a file for gf."""
    lines = text.splitlines()
    if len(lines) <= CLAUDE_VIEW_LINES:
        return lines or [view_meta("(no output)")]
    view.spills += 1
    path = tmpdir / f"output-{view.spills:03d}.txt"
    path.write_text(text.rstrip("\n") + "\n", encoding="utf-8")
    return lines[:CLAUDE_VIEW_LINES] + [view_meta(f"full output ({len(lines)} lines): {path}")]


def message_section(view, ts: str, tag: str, label: str, text: str) -> None:
    """A USER/ASSISTANT/THINKING fold whose header previews the first two sentences."""
    view.section(f"{ts} {tag}{label}: {text_preview(text)}", text.splitlines())


def tool_section(view, ts: str, tag: str, name: str, inp: dict, output: str | None,
                 tmpdir: Path, failed: bool = False, denied: str | None = None,
                 local_output: bool = False, output_counts=None) -> None:
    """A tool call fold: its input, then the result (None when no result was logged)."""
    mark = "✗ " if failed or denied else ""
    header = f"{ts} {tag}{mark}ASSISTANT tool call: {tool_marker(name, inp).strip()}"
    body = [view_meta("input (assistant):")]
    body.extend(input_lines(inp))
    if output is None:
        body.append(view_meta("(no result)"))
    else:
        if denied:
            body.append(view_meta(f"denied: {denied}"))
        result = spill_lines(view, output, tmpdir)
        if local_output:
            result = [f"⟦local⟧ {line}" for line in result]
        content = ViewBuilder()
        content.count_width = view.count_width
        content.counts = output_counts if output_counts is not None else view.counts
        content.lines = body
        content.section("result (local toolUseResult; model-visible text may differ):"
                        if local_output else "result (tool):", result)
        body = content
    view.section(header, body)


def view_header(view, s: Session) -> None:
    title = " ".join((s.title or "").split()) or s.id
    view.lines.extend(
        [
            view_meta(title),
            view_meta(f"{s.agent} · {s.id} · {s.cwd}"),
            view_meta("fold: za/zo/zc or click the fold column · full output: gf on its path"),
            view_meta("⟦meta⟧ = viewer/log metadata; ⟦local⟧ = local tool detail, not the request body"),
            view_meta("request roles are API roles: user may include tool results/injected context"),
            "",
        ]
    )


def add_thinking(view, entry) -> None:
    body = entry["text"].splitlines() or [view_meta("(no text)")]
    if entry.get("metadata"):
        body = [view_meta(line) for line in entry["text"].splitlines()]
    view.section(
        f"{entry['ts']} {entry.get('tag', '')}ASSISTANT {entry['label']}",
        body,
    )


def attachment_text(rec: dict) -> str:
    rendered = rec.get("rendered")
    if isinstance(rendered, str):
        return rendered.strip()
    if isinstance(rendered, dict):
        rendered = [rendered]
    if not isinstance(rendered, list):
        return ""
    parts = []
    for item in rendered:
        if isinstance(item, dict) and isinstance(item.get("content"), str):
            parts.append(item["content"])
        elif isinstance(item, str):
            parts.append(item)
    return "\n".join(parts).strip()


def block_kind(block) -> str:
    """The selectable kind of a request content block."""
    kind = block.get("type") if isinstance(block, dict) else None
    return kind if kind in ("text", "thinking", "tool_use", "tool_result") else "other"


def content_source(role, content, record=None, hints=None) -> str:
    """Distinguish content provenance from the API's overloaded user role."""
    if role != "user":
        return role or "unknown"
    record = record or {}
    if record.get("isCompactSummary"):
        return "summary"
    if any(record.get(key) for key in ("isMeta", "synthetic", "isSynthetic")):
        return "context"
    if isinstance(content, list):
        sources = {content_source(role, block, record, hints) for block in content if isinstance(block, dict)}
        return next(iter(sources)) if len(sources) == 1 else "mixed" if sources else "user"
    if isinstance(content, dict):
        if content.get("type") == "tool_result":
            return "tool"
        return content_source(role, content.get("text", ""), record, hints)
    text = content if isinstance(content, str) else ""
    hint = hints.get(text, hints.get(text.strip(), set())) if hints else set()
    if len(hint) == 1:
        return next(iter(hint))
    if text.lstrip().startswith(CodexAgent.SYNTHETIC + ("<local-command", "<command-name", "<command-message")):
        return "context"
    if re.fullmatch(r"\s*<system-reminder>.*</system-reminder>\s*", text, re.S):
        return "context"
    return "user"


def source_category(source):
    return {"developer": "system", "context": "system", "summary": "system",
            "mixed": "system", "system": "system"}.get(source, source)


def message_lines(index: int, message: dict, marker: str = "", parts=None, hints=None) -> list[str]:
    """A full request message in readable form. parts filters block kinds (None = all)."""
    role = message.get("role") or "?"
    source = content_source(role, message.get("content"), hints=hints)
    content = message.get("content")
    body: list[str] = []
    if isinstance(content, str):
        if parts is None or "text" in parts:
            body.extend(content.splitlines() or [""])
    elif isinstance(content, list):
        for block in content:
            kind = block_kind(block)
            if parts is not None and kind not in parts:
                continue
            if not isinstance(block, dict):
                body.extend(str(block).splitlines())
            elif kind == "text":
                body.extend((block.get("text") or "").splitlines() or [""])
            elif kind == "thinking":
                body.append(view_meta("THINKING (assistant):"))
                body.extend((block.get("thinking") or block.get("text") or "").splitlines())
            elif kind == "tool_use":
                body.append(view_meta(f"TOOL_USE {block.get('name') or '?'} (assistant):"))
                body.extend(
                    json.dumps(block.get("input") or {}, ensure_ascii=False, indent=2).splitlines()
                )
            elif kind == "tool_result":
                body.append(view_meta(
                    f"TOOL_RESULT (tool, tool_use_id={block.get('tool_use_id') or '?'})"
                    + (" (error)" if block.get("is_error") else "") + ":"
                ))
                body.extend(text_of(block.get("content")).splitlines() or [""])
            else:
                body.append(view_meta(f"[{block.get('type') or 'block'}]"))
                body.extend(json.dumps(block, ensure_ascii=False, indent=2).splitlines())
    elif parts is None or "other" in parts:
        body.extend(str(content or "").splitlines() or [""])
    if parts is not None and content not in (None, "", []) and not body:
        return []  # every part of this message was deselected
    label = "" if index is None else f"[{index}]"  # None: the request's system prompt
    if role == "missing":
        body = [view_meta(line) for line in body]
    provenance = f" (API role={role})" if source != role else ""
    return [view_meta(f"{label}{marker} {source}{provenance}".strip())] + body


def request_message_section(view, index, message, marker="") -> None:
    """Give every request message an independently foldable, counted abstract."""
    lines = message_lines(index, message, marker, hints=view.source_hints)
    label = lines[0].removeprefix("⟦meta⟧ ")
    view.section(f"{label}: {text_preview(chr(10).join(lines[1:]))}", lines[1:])


@dataclass
class ModelInput:
    """One logged model-input text, plus display-only provenance."""
    role: str
    lines: list[str]
    timestamp: str
    counts: tuple[int, int]
    source: str


def input_content_lines(content) -> list[str]:
    """Preserve input text; non-text payloads get metadata, never a log dump."""
    if isinstance(content, str):
        return content.splitlines()
    if not isinstance(content, list):
        return []
    lines = []
    for block in content:
        if not isinstance(block, dict):
            continue
        kind = block.get("type")
        if kind in ("text", "input_text", "output_text"):
            text = block.get("text")
            if isinstance(text, str):
                lines.extend(text.splitlines())
        elif kind == "thinking":
            text = block.get("thinking")
            if isinstance(text, str):
                lines.append(view_meta("thinking (assistant context)"))
                lines.extend(text.splitlines())
        elif kind == "tool_use":
            lines.append(view_meta(f"tool_use {block.get('name') or '?'} id={block.get('id') or '?'}"))
            lines.extend(json.dumps(block.get("input") or {}, ensure_ascii=False, indent=2).splitlines())
        elif kind == "tool_result":
            lines.append(view_meta(f"tool_result id={block.get('tool_use_id') or '?'}"))
            lines.extend(input_content_lines(block.get("content")))
        # Images, signatures, encrypted reasoning and unknown blocks are not text.
    return lines


def render_model_inputs(view, inputs, missing_only=False, parts=None) -> None:
    """The same projection powers raw and fills any gaps in the normal view."""
    normal_text = "\n".join(line for line in view.lines if not line.startswith("⟦meta⟧ ")) if missing_only else ""
    content = ViewBuilder()
    content.count_width = view.count_width
    for index, message in enumerate(inputs):
        category = source_category(message.role)
        if parts is not None and category not in parts:
            continue
        # Normal mode can hide categories or abbreviate API bodies, but its
        # complete projection must still contain every text available in raw.
        text_lines = [line for line in message.lines if not line.startswith("⟦meta⟧ ")]
        text = "\n".join(text_lines)
        if not message.lines:
            continue
        content.counts = message.counts
        preview = text_preview(text)
        body = message.lines
        if missing_only and text and text in normal_text:
            body = [view_meta("正文已在上方展示；此处保留编号、来源及累计信息。")]
        content.section(f"{message.timestamp} [{index}] {message.role}: {preview}",
                        [view_meta(message.source)] + body)
    if content.lines:
        view.counts = None
        if missing_only:
            view.section("MODEL INPUT: 原始输入正文（每条消息一次；累计次数仅在 meta 中）", content)
        else:
            offset = len(view.lines)
            view.lines.extend(content.lines)
            view.folds.extend((a + offset, b + offset) for a, b in content.folds)
            view.headings.update((line + offset, heading) for line, heading in content.headings.items())
    elif not missing_only:
        view.section("MODEL INPUT", [view_meta("(no recoverable sent text)")])


def claude_message_hash(message: dict) -> str:
    """Claude Code's hash for a request message (the api-request-blob key)."""
    canonical = json.dumps(message, separators=(",", ":"), ensure_ascii=False, sort_keys=True)
    return hashlib.sha256(canonical.encode()).hexdigest()


def claude_request_indexes(records: list[dict]) -> tuple[dict, dict, dict]:
    """(blobs, shapes, requests) indexed by message hash, shape hash and request id."""
    blobs: dict[str, dict] = {}
    shapes: dict[str, dict] = {}
    requests: dict[str, dict] = {}
    for rec in records:
        kind = rec.get("type")
        if kind == "api-request-blob":
            if isinstance(rec.get("hash"), str) and isinstance(rec.get("message"), dict):
                blobs[rec["hash"]] = rec["message"]
        elif kind == "api-request-shape":
            if isinstance(rec.get("shapeHash"), str) and isinstance(rec.get("shape"), dict):
                shapes[rec["shapeHash"]] = rec["shape"]
        elif kind == "api-request":
            if isinstance(rec.get("id"), str):
                requests[rec["id"]] = rec
    return blobs, shapes, requests


def claude_rebuild_messages(records: list[dict], hashes: set[str]) -> dict[str, dict]:
    """Messages whose bodies the blob log omitted, rebuilt from the ordinary
    user/assistant records and checked against the requested hash.

    Claude Code splits one API message across several records (a response's
    thinking/text/tool_use blocks, a turn's tool results), and a user string
    becomes a text block, so every contiguous same-role run is a candidate."""
    pool = [
        rec for rec in records
        if isinstance(rec.get("message"), dict)
        and rec["message"].get("role") in ("user", "assistant")
        and rec["message"].get("content") is not None
    ]
    found: dict[str, dict] = {}
    for i, rec in enumerate(pool):
        role = rec["message"]["role"]
        blocks: list = []
        for other in pool[i:i + 64]:  # one API message can span many tool results
            if other["message"].get("role") != role:
                break
            content = other["message"].get("content")
            if isinstance(content, str):
                blocks.append({"type": "text", "text": content})
            elif isinstance(content, list):
                blocks.extend(content)
            else:
                break
            candidate = {"role": role, "content": list(blocks)}
            message_hash = claude_message_hash(candidate)
            if message_hash in hashes and message_hash not in found:
                found[message_hash] = candidate
            if len(found) == len(hashes):
                return found
    return found


def parse_tool_schema(schema):
    """A logged tool schema is a stringified dict; parse it back when possible."""
    if not isinstance(schema, str):
        return schema
    for parse in (json.loads, ast.literal_eval):
        try:
            return parse(schema)
        except (json.JSONDecodeError, ValueError, SyntaxError):
            pass
    return schema


@dataclass
class RequestBody:
    """One reconstructed API request: everything that was sent to the model."""
    params: dict
    system: list[dict]
    tools: list[dict]
    messages: list[dict]
    cache_control: list[dict]
    missing: list[str]  # hashes whose body could not be recovered

    def payload(self) -> dict:
        """The Messages API body. `betas` is a request option, not a body field."""
        body = {k: copy.deepcopy(v) for k, v in self.params.items() if k != "betas"}
        if self.system:
            body["system"] = copy.deepcopy(self.system)
        if self.tools:
            body["tools"] = copy.deepcopy(self.tools)
        body["messages"] = copy.deepcopy(self.messages)
        return body


def claude_sent_hashes(request: dict, requests: dict[str, dict]) -> list[str]:
    """The message hashes of one request: the last `keep` of its base chain + tail."""
    chain: list[dict] = []
    seen: set[str] = set()
    current: dict | None = request
    while isinstance(current, dict):
        request_id = current.get("id")
        if isinstance(request_id, str):
            if request_id in seen:
                break
            seen.add(request_id)
        chain.append(current)
        base = current.get("base")
        current = requests.get(base) if isinstance(base, str) else None
    chain.reverse()

    base_hashes = [
        h for req in chain[:-1] for h in (req.get("tail") or []) if isinstance(h, str)
    ]
    tail = [h for h in (request.get("tail") or []) if isinstance(h, str)]
    keep = request.get("keep")
    keep = keep if isinstance(keep, int) and keep >= 0 else len(base_hashes)
    return (base_hashes[-keep:] if keep else []) + tail


def claude_request_body(
    records: list[dict],
    request: dict,
    blobs: dict[str, dict] | None = None,
    shapes: dict[str, dict] | None = None,
    requests: dict[str, dict] | None = None,
    rebuilt: dict[str, dict] | None = None,
) -> RequestBody:
    """Reconstruct the complete body of one logged API request.

    A request is logged as a delta: params, a shape (system/tools) and message
    hashes in tail, with base pointing at the previous request. Walking that
    chain and keeping the last `keep` carried messages yields every hash sent.
    Bodies come from api-request-blob; the ones the log omitted are rebuilt from
    ordinary user/assistant records and verified against their hash. cacheControl
    paths are reattached to the blocks they mark. Callers rendering many requests
    should pass a shared `rebuilt` cache."""
    if blobs is None or shapes is None or requests is None:
        blobs, shapes, requests = claude_request_indexes(records)

    sent = claude_sent_hashes(request, requests)

    missing_hashes = {h for h in sent if h not in blobs}
    if missing_hashes:
        if rebuilt is None:
            rebuilt = claude_rebuild_messages(records, missing_hashes)
        else:
            needed = missing_hashes - set(rebuilt)
            if needed:
                rebuilt.update(claude_rebuild_messages(records, needed))
    else:
        rebuilt = rebuilt or {}

    messages = []
    missing = []
    for message_hash in sent:
        message = blobs.get(message_hash) or rebuilt.get(message_hash)
        if message is None:
            missing.append(message_hash)
            message = {
                "role": "missing",
                "content": [{"type": "text", "text": f"(message not found: {message_hash})"}],
            }
            messages.append(copy.deepcopy(message))
            continue
        message = copy.deepcopy(message)
        if isinstance(message.get("content"), str):  # the hash uses the text-block form
            message["content"] = [{"type": "text", "text": message["content"]}]
        messages.append(message)

    params = copy.deepcopy(request.get("params") or {})
    shape_hash = request.get("shapeHash")
    shape = shapes.get(shape_hash) if isinstance(shape_hash, str) else None
    shape = shape if isinstance(shape, dict) else {}
    system = copy.deepcopy(shape.get("system") or [])
    tools = copy.deepcopy(shape.get("tools") or [])
    for tool in tools:
        if isinstance(tool, dict) and isinstance(tool.get("input_schema"), str):
            tool["input_schema"] = parse_tool_schema(tool["input_schema"])

    cache_control = copy.deepcopy(request.get("cacheControl") or [])
    groups = {"system": system, "tools": tools, "messages": messages}
    for entry in cache_control:
        path = entry.get("path") if isinstance(entry, dict) else None
        if not (isinstance(path, list) and path and path[0] in groups):
            continue
        target = groups[path[0]]
        for key in path[1:]:
            if isinstance(target, list) and isinstance(key, int) and 0 <= key < len(target):
                target = target[key]
            elif isinstance(target, dict) and key in target:
                target = target[key]
            else:
                target = None
                break
        if isinstance(target, dict):
            target["cache_control"] = copy.deepcopy(entry.get("value") or {})
    return RequestBody(params, system, tools, messages, cache_control, missing)


def render_request(view, rec, records, blobs, shapes, by_id, rebuilt, options) -> None:
    """One folded section for an API request: params, shape and the body's last messages."""
    body = claude_request_body(records, rec, blobs, shapes, by_id, rebuilt)
    params = body.params
    base = rec.get("base")
    base = base if isinstance(base, str) else None
    lines = [view_meta("params (API configuration):")]
    lines.extend(view_meta(line) for line in json.dumps(params, ensure_ascii=False, indent=2).splitlines())
    shape_hash = rec.get("shapeHash")
    lines.append(view_meta(
        f"shape {(shape_hash or '')[:8]}: system={len(body.system)} tool(s)={len(body.tools)}"
    ))
    system_text = "\n".join(
        block.get("text", "") for block in body.system if isinstance(block, dict)
    )
    if body.tools:
        names = [tool.get("name") or "?" for tool in body.tools if isinstance(tool, dict)]
        lines.append(view_meta("tools: " + ", ".join(names)))
    if body.missing:
        lines.append(view_meta(f"missing bodies: {len(body.missing)}"))
    selected = [
        (i, message) for i, message in enumerate(body.messages)
        if message.get("role") in options.normal_parts or message.get("role") == "missing"
    ]
    # The system prompt is what the model reads first, so it heads the body and
    # counts as one of the entries the limit picks from the end.
    entries: list[tuple[int | None, dict]] = []
    if system_text.strip() and "system" in options.normal_parts:
        entries.append((None, {"role": "system", "content": body.system}))
    entries.extend(selected)
    limit = options.max_messages
    if limit == 0 or not entries:
        lines.append(view_meta("content: (none shown)"))
    else:
        shown = entries if limit < 0 else entries[-limit:]
        lines.append(view_meta(f"content ({len(entries)} messages):"))
        if len(shown) < len(entries):
            lines.append(view_meta("......"))
        content = ViewBuilder()
        content.counts, content.count_width = view.counts, view.count_width
        content.source_hints = view.source_hints
        content.lines = lines
        for index, message in shown:
            request_message_section(content, index, message)
        lines = content
    base_label = f" base={(base or '')[:8]}" if base else ""
    view.section(
        f"{record_ts(rec)} API request model={params.get('model', '?')}"
        f"{base_label} messages={len(body.messages)}",
        lines,
    )


def new_turn() -> dict:
    """One user turn: items before its first response, response loops, last text."""
    return {"user": None, "pre": [], "loops": [], "last_text": None}


class TurnBuilder:
    """Builds a turn from any agent's stream.

    A loop is one model response. Items added before the first response, or
    before a loop starts, go to `pre`; text items are remembered so
    final_text_for() can hoist the answer out of the procedure."""

    def __init__(self):
        self.turn = new_turn()
        self.loop: dict | None = None
        self.counts: tuple[int, int] | None = None

    def add_item(self, item: dict) -> None:
        item["counts"] = self.counts
        if self.loop is not None:
            self.loop["items"].append(item)
        else:
            self.turn["pre"].append(item)

    def add_note(self, header: str, body: list[str], category: str = "note",
                 metadata: bool = True) -> None:
        self.add_item(
            {"kind": "note", "category": category, "header": header,
             "body": body, "metadata": metadata}
        )

    def add_thinking(self, ts: str, tag: str, label: str, text: str,
                     metadata: bool = False) -> None:
        item = {"kind": "thinking", "ts": ts, "tag": tag, "label": label,
                "text": text, "metadata": metadata}
        self.add_item(item)

    def add_text(self, ts: str, tag: str, text: str) -> None:
        item = {"kind": "text", "ts": ts, "tag": tag, "text": text}
        self.add_item(item)
        self.turn["last_text"] = item

    def add_call(self, ts: str, tag: str, name: str, inp: dict, output: str | None,
                 failed: bool = False, denied: str | None = None,
                 local_output: bool = False, output_counts=None) -> None:
        item = {
            "kind": "call",
            "ts": ts,
            "tag": tag,
            "name": name,
            "input": inp,
            "output": output,
            "failed": failed,
            "denied": denied,
            "local_output": local_output,
            "output_counts": output_counts,
        }
        self.add_item(item)

    def start_loop(self, ts: str = "", request: dict | None = None) -> None:
        if self.loop is None or self.loop["items"]:
            self.loop = {"requests": [], "items": [], "ts": ts, "counts": self.counts}
            self.turn["loops"].append(self.loop)
        if request is not None:
            self.loop["requests"].append(request)

    def set_user(self, ts: str, tag: str, label: str, text: str) -> None:
        self.turn["user"] = {"ts": ts, "tag": tag, "label": label, "text": text,
                             "counts": self.counts}

    def reset(self) -> None:
        self.turn = new_turn()
        self.loop = None


def final_text_for(turn: dict) -> dict | None:
    """The last assistant text with no tool call or later loop after it."""
    last = turn["last_text"]
    if last is None:
        return None

    def call_after(items: list[dict]) -> bool:
        seen = False
        for item in items:
            if item is last:
                seen = True
            elif seen and item["kind"] == "call":
                return True
        return False

    if any(item is last for item in turn["pre"]):
        return None if turn["loops"] or call_after(turn["pre"]) else last
    for index, loop in enumerate(turn["loops"]):
        if any(item is last for item in loop["items"]):
            if call_after(loop["items"]):
                return None
            if any(later["requests"] or later["items"] for later in turn["loops"][index + 1:]):
                return None
            return last
    return None


def render_item(view, item, tmpdir, final, parts=None) -> None:
    """Render one loop item; the final assistant text is left for render_turn."""
    if item is final:
        return
    view.counts = item.get("counts")
    kind = item["kind"]
    if parts is not None:
        if kind == "thinking" and "thinking" not in parts:
            return
        if kind == "call" and "tool" not in parts:
            return
        if kind == "text" and "assistant" not in parts:
            return
        if kind == "note" and item.get("category", "note") not in parts:
            return
    if kind == "thinking":
        add_thinking(view, item)
    elif kind == "call":
        tool_section(
            view, item["ts"], item["tag"], item["name"], item["input"], item["output"],
            tmpdir, item["failed"], item["denied"], item["local_output"], item["output_counts"],
        )
    elif kind == "text":
        message_section(view, item["ts"], item["tag"], "ASSISTANT", item["text"])
    else:  # note
        body = item["body"]
        if item["metadata"]:
            body = [view_meta(line) for line in body]
        view.section(item["header"], body)


def render_loop(view, loop, tmpdir, final, draw_request=None, parts=None) -> None:
    """One model-response loop, folded as a block. parts filters section kinds."""
    requests = loop["requests"]
    items = loop["items"]
    show_loop = parts is None or "loop" in parts
    thinking = sum(1 for item in items if item["kind"] == "thinking")
    calls = sum(1 for item in items if item["kind"] == "call")
    texts = sum(1 for item in items if item["kind"] == "text")
    parts_list = []
    if requests:
        parts_list.append("API request" if len(requests) == 1 else f"{len(requests)} API requests")
    if thinking:
        parts_list.append(f"{thinking} thinking")
    if calls:
        parts_list.append(f"{calls} tool call{'s' if calls != 1 else ''}")
    if texts and not parts_list:
        parts_list.append(f"{texts} assistant text{'s' if texts != 1 else ''}")
    start = len(view.lines) + 1
    view.counts = loop.get("counts")
    if show_loop:
        view.lines.append(view.abstract(f"{loop['ts']} LOOP: " + (" · ".join(parts_list) or "items")))
    if draw_request is not None and (parts is None or "api" in parts):
        for rec in requests:
            draw_request(view, rec)
    for item in items:
        render_item(view, item, tmpdir, final, parts)
    if show_loop and len(view.lines) > start:
        view.folds.append((start, len(view.lines)))
    if show_loop:
        view.lines.append("")


def render_turn(view, turn, tmpdir, draw_request=None, parts=None) -> None:
    """USER, its repeated loops (one PROCEDURE fold), then the final ASSISTANT text.

    parts filters section kinds: user, assistant, thinking, tool, note,
    attachment, api, loop, procedure."""
    if (
        turn["user"] is None
        and not turn["pre"]
        and not turn["loops"]
        and turn["last_text"] is None
    ):
        return
    final = final_text_for(turn)
    # A final response that holds only that text has no procedure to show once
    # the text is hoisted, so it does not count as a loop.
    loops = [
        loop
        for loop in turn["loops"]
        if loop["requests"] or any(item is not final for item in loop["items"])
    ]
    user = turn["user"]
    if user is not None and (parts is None or "user" in parts):
        view.counts = user.get("counts")
        message_section(view, user["ts"], user["tag"], user["label"], user["text"])
    pre = turn["pre"]
    procedure = parts is None or "procedure" in parts
    if procedure and (len(loops) > 1 or (loops and pre)):
        start = len(view.lines) + 1
        count = len(loops)
        view.counts = loops[0].get("counts")
        view.lines.extend(
            [view.abstract(f"{loops[0]['ts']} PROCEDURE ({count} loop{'s' if count != 1 else ''})"), ""]
        )
        for item in pre:
            render_item(view, item, tmpdir, final, parts)
        for loop in loops:
            render_loop(view, loop, tmpdir, final, draw_request, parts)
        view.folds.append((start, len(view.lines)))
        view.lines.append("")
    else:
        for item in pre:
            render_item(view, item, tmpdir, final, parts)
        for loop in loops:
            render_loop(view, loop, tmpdir, final, draw_request, parts)
    if final is not None:
        render_item(view, final, tmpdir, None, parts)


def claude_active_uuids(records: list[dict]) -> set[str] | None:
    """UUIDs on the live branch.

    A rewind leaves the abandoned branch in the jsonl, but its records are not
    ancestors of the newest conversation record. Follow parentUuid back to the
    root, using logicalParentUuid to cross a compaction boundary."""
    by_uuid = {r["uuid"]: r for r in records if isinstance(r.get("uuid"), str)}
    conv = [
        (i, r)
        for i, r in enumerate(records)
        if isinstance(r.get("uuid"), str)
        and not r.get("isSidechain")
        and r.get("type") in ("user", "assistant", "system", "attachment")
    ]
    if not conv or not by_uuid:
        return None
    last_index, last = conv[-1]
    leaf = last["uuid"]
    prompt_index = None
    prompt_leaf = None
    for i, rec in enumerate(records):
        if rec.get("type") == "last-prompt" and isinstance(rec.get("leafUuid"), str):
            prompt_index, prompt_leaf = i, rec["leafUuid"]
    # A rewind without a new message makes last-prompt the newest record; its
    # leafUuid is then the live end, not the abandoned record after it.
    if prompt_index is not None and prompt_index > last_index and prompt_leaf in by_uuid:
        leaf = prompt_leaf
    active: set[str] = set()
    cur = leaf
    while cur in by_uuid and cur not in active:
        active.add(cur)
        rec = by_uuid[cur]
        cur = rec.get("parentUuid") or rec.get("logicalParentUuid")
    return active or None


def claude_active_requests(records: list[dict], active: set[str] | None) -> set[int]:
    """Indexes of api-request records that belong to the live branch.

    An api-request has no uuid; it is logged just before the conversation record
    it serves, so keep it when the next meaningful record is on the live branch."""
    if active is None:
        return {i for i, rec in enumerate(records) if rec.get("type") == "api-request"}
    next_conv: list[dict | None] = [None] * (len(records) + 1)
    following: dict | None = None
    for i in range(len(records) - 1, -1, -1):
        next_conv[i] = following
        rec = records[i]
        if not isinstance(rec.get("uuid"), str) or rec.get("isSidechain"):
            continue
        if rec.get("type") not in ("user", "assistant", "system", "attachment"):
            continue
        if rec.get("type") == "user":
            if rec.get("isMeta"):
                continue
            text = ClaudeAgent.user_text(rec.get("message") or {})
            if text.startswith(("<local-command", "<command-name", "<command-message")):
                continue
        following = rec
    live: set[int] = set()
    for i, rec in enumerate(records):
        if rec.get("type") != "api-request":
            continue
        following = next_conv[i]
        if following is None or following["uuid"] in active:
            live.add(i)
    return live


def claude_accumulations(records, live, blobs, shapes, requests_by_id, rebuilt,
                         tool_counts=None) -> dict[int, tuple[int, int]]:
    """Count context extensions, rather than retries of an identical body.

    API user roles also carry tools/injections; match text against real logged
    prompts to identify user additions. Blob-only logs fall back to text users.
    Hashes already seen stay old across compaction/cache-control changes."""
    prompts = {
        ClaudeAgent.user_text(rec.get("message") or {})
        for rec in records if rec.get("type") == "user"
        and not rec.get("isMeta") and not rec.get("isCompactSummary")
        and not rec.get("isSidechain")
        and content_source("user", (rec.get("message") or {}).get("content"), rec) == "user"
    }
    prompts = {text for text in prompts if text and not text.startswith(
        ("<local-command", "<command-name", "<command-message")
    )}
    counter = Accumulation()
    seen: Counter = Counter()
    logged_users = any(rec.get("type") == "user" for rec in records)
    result = {}
    for rec in live:
        sent = claude_sent_hashes(rec, requests_by_id)
        occurrences: Counter = Counter()
        new = set()
        for index, message_hash in enumerate(sent):
            occurrences[message_hash] += 1
            if occurrences[message_hash] > seen[message_hash]:
                new.add(index)
        if new or not result:
            body = claude_request_body(records, rec, blobs, shapes, requests_by_id, rebuilt)
            user = False
            for index, message in enumerate(body.messages):
                if index not in new or message.get("role") != "user":
                    continue
                text = ClaudeAgent.user_text(message)
                if text and (text in prompts if logged_users else not any(
                    block.get("type") == "tool_result"
                    for block in message.get("content") or [] if isinstance(block, dict)
                )):
                    user = True
            counter.advance(user=user)
            if tool_counts is not None:
                for index, message in enumerate(body.messages):
                    if index not in new:
                        continue
                    for block in message.get("content") or []:
                        if isinstance(block, dict) and block.get("type") == "tool_result":
                            tool_counts.setdefault(block.get("tool_use_id"), counter.counts)
        result[id(rec)] = counter.counts
        seen |= occurrences
    return result


def claude_source_hints(records):
    hints = {}
    for record in records:
        if record.get("type") == "user":
            message = record.get("message") or {}
            text = ClaudeAgent.user_text(message)
            if text:
                hints.setdefault(text, set()).add(content_source("user", message.get("content"), record))
    return hints


def claude_model_inputs(records, live, blobs, shapes, requests_by_id, rebuilt, counts):
    """Union of messages actually present in requests; each occurrence once.

    Identical *separate* user prompts remain separate occurrences. Resending a
    growing prefix only updates metadata on its existing entries.
    """
    inputs = []
    seen = {}
    hints = claude_source_hints(records)
    for request_index, rec in enumerate(live):
        sent = claude_sent_hashes(rec, requests_by_id)
        body = claude_request_body(records, rec, blobs, shapes, requests_by_id, rebuilt)
        entries = []
        if body.system:
            lines = input_content_lines(body.system)
            entries.append((("system", tuple(lines)), "system", lines))
        occurrences: Counter = Counter()
        for message_hash, message in zip(sent, body.messages):
            occurrences[message_hash] += 1
            if message.get("role") == "missing":
                continue  # An unrecovered body is not original model-input text.
            key = (message_hash, occurrences[message_hash])
            role = message.get("role") or "?"
            blocks = message.get("content")
            groups = []
            for block in blocks if isinstance(blocks, list) else [blocks]:
                source = content_source(role, block, hints=hints)
                lines = input_content_lines([block] if isinstance(block, dict) else block)
                if groups and groups[-1][0] == source:
                    groups[-1][1].extend(lines)
                else:
                    groups.append((source, lines))
            for part, (source, lines) in enumerate(groups):
                entries.append(((key, part), source, lines))
        for key, role, lines in entries:
            if not lines:
                continue
            if key not in seen:
                seen[key] = ModelInput(role, lines, record_ts(rec), counts[id(rec)], "")
                inputs.append(seen[key])
            entry = seen[key]
            entry.counts = counts[id(rec)]
            entry.source = (f"API input; content source={role}; "
                            f"latest request [{request_index}] id={rec.get('id') or '?'}")
    return inputs


def claude_view(s: Session, view: "ViewBuilder", tmpdir: Path, options: ViewOptions) -> None:
    """Render a Claude session into view.

    Shows user/assistant text, thinking, grouped tool calls with their results,
    system notes, selected injected attachments and API requests. Raw tool
    results, thinking and attachments are what transcript() drops. With
    options.raw, only the reconstructed API request messages are shown."""
    records = list(read_jsonl(s.path))
    active = claude_active_uuids(records)
    live_requests = claude_active_requests(records, active)

    def rewound(rec: dict) -> bool:
        uuid = rec.get("uuid")
        return (
            active is not None
            and isinstance(uuid, str)
            and not rec.get("isSidechain")
            and uuid not in active
        )

    blobs: dict[str, dict] = {}
    shapes: dict[str, dict] = {}
    requests_by_id: dict[str, dict] = {}
    results: dict[str, tuple[dict, dict]] = {}
    for i, rec in enumerate(records):
        kind = rec.get("type")
        if kind == "api-request-blob":
            if isinstance(rec.get("hash"), str) and isinstance(rec.get("message"), dict):
                blobs[rec["hash"]] = rec["message"]
        elif kind == "api-request-shape":
            if isinstance(rec.get("shapeHash"), str) and isinstance(rec.get("shape"), dict):
                shapes[rec["shapeHash"]] = rec["shape"]
        elif kind == "api-request":
            request_id = rec.get("id")
            if isinstance(request_id, str):
                requests_by_id[request_id] = rec
        elif kind == "user":
            if rewound(rec):
                continue
            for block in content_blocks(rec):
                if block.get("type") == "tool_result":
                    results[block.get("tool_use_id")] = (block, rec)

    live_records = [
        rec for i, rec in enumerate(records)
        if rec.get("type") == "api-request" and i in live_requests
    ]
    all_missing = {
        h for rec in live_records for h in claude_sent_hashes(rec, requests_by_id)
        if h not in blobs
    }
    rebuilt = claude_rebuild_messages(records, all_missing) if all_missing else {}

    tool_counts = {}
    counts = claude_accumulations(records, live_records, blobs, shapes, requests_by_id, rebuilt, tool_counts)
    view.count_width = len(str(max((max(pair) for pair in counts.values()), default=len(records))))
    view.source_hints = claude_source_hints(records)
    next_counts = {}
    upcoming = None
    for rec in reversed(records):
        if id(rec) in counts:
            upcoming = counts[id(rec)]
        next_counts[id(rec)] = upcoming

    view_header(view, s)
    view.lines.extend([
        view_meta("USER[n] 用户追加轮次；MSG[n] 含工具结果自动续发的追加轮次；初次均为 0"),
        "",
    ])
    inputs = claude_model_inputs(records, live_records, blobs, shapes, requests_by_id, rebuilt, counts)
    if options.raw:
        render_model_inputs(view, inputs)
        view.layout(raw=True)
        return
    builder = TurnBuilder()
    fallback = Accumulation()
    pending_result = False

    def draw_request(v, rec: dict) -> None:
        v.counts = counts[id(rec)]
        render_request(v, rec, records, blobs, shapes, requests_by_id, rebuilt, options)

    def add_call_item(block: dict, ts: str, tag: str) -> None:
        result, rec = results.get(block.get("id"), (None, None))
        inp = block.get("input")
        builder.add_call(
            ts,
            tag,
            block.get("name") or "?",
            inp if isinstance(inp, dict) else {"input": inp},
            tool_text(rec, result) if result is not None else None,
            bool(result and result.get("is_error")),
            rec.get("toolDenialKind") if rec else None,
            rec is not None and rec.get("toolUseResult") is not None,
            tool_counts.get(block.get("id")),
        )

    def flush_turn() -> None:
        render_turn(view, builder.turn, tmpdir, draw_request, set(options.normal_parts))
        builder.reset()

    for i, rec in enumerate(records):
        kind = rec.get("type")
        if kind == "api-request":
            if i in live_requests:
                builder.counts = counts[id(rec)]
                builder.start_loop(record_ts(rec), rec)
            continue
        if rewound(rec):
            continue
        ts = record_ts(rec)
        tag = "[subagent] " if rec.get("isSidechain") else ""
        if kind == "user":
            msg = rec.get("message")
            msg = msg if isinstance(msg, dict) else {}
            text = ClaudeAgent.user_text(msg)
            source = content_source("user", msg.get("content"), rec)
            if text and source != "user":
                builder.add_note(f"{ts} {tag}{source.upper()}: {text_preview(text)}", text.splitlines(),
                                 category="system", metadata=False)
                continue
            synthetic = text.startswith(
                ("<local-command", "<command-name", "<command-message")
            )
            if text and not synthetic:
                carried = None
                if builder.turn["loops"]:
                    trailing = builder.turn["loops"][-1]
                    last_ts = record_ts(trailing["requests"][-1]) if trailing["requests"] else ""
                    if not trailing["items"] and last_ts and last_ts == ts:
                        # The request for this user turn is logged just before it.
                        carried = builder.turn["loops"].pop()
                flush_turn()
                builder.counts = (counts[id(carried["requests"][-1])] if carried is not None
                                  else next_counts[id(rec)]) or fallback.advance(
                                      user=not rec.get("isCompactSummary")
                                  )
                label = "CONTEXT SUMMARY" if rec.get("isCompactSummary") else "USER"
                builder.set_user(ts, tag, label, text)
                if carried is not None:
                    for request in list(carried["requests"]):
                        builder.start_loop(record_ts(request), request)
            if not live_records and any(block.get("type") == "tool_result" for block in content_blocks(rec)):
                pending_result = True
            if rec.get("interruptedMessageId"):
                builder.add_note(f"{ts} {tag}user interrupted", [])
            continue
        if kind == "assistant":
            if not live_records and pending_result:
                builder.counts = fallback.advance()
                pending_result = False
            msg = rec.get("message")
            msg = msg if isinstance(msg, dict) else {}
            blocks = content_blocks(rec)
            if rec.get("isApiErrorMessage"):
                text = ClaudeAgent.user_text(msg) or json.dumps(msg, ensure_ascii=False)
                builder.add_note(f"{ts} {tag}API error", text.splitlines())
                continue
            for block in blocks:
                typ = block.get("type")
                if typ == "text":
                    text = (block.get("text") or "").strip()
                    if text:
                        builder.add_text(ts, tag, text)
                elif typ == "thinking":
                    text = (block.get("thinking") or "").strip()
                    label = "thinking"
                    if rec.get("thinkingDisplay") == "summarized":
                        label += " (summarized)"
                    builder.add_thinking(ts, tag, label, text,
                                         metadata=rec.get("thinkingDisplay") == "summarized")
                elif typ == "tool_use":
                    add_call_item(block, ts, tag)
                elif typ == "image":
                    builder.add_note(f"{ts} {tag}ASSISTANT image", [view_meta("[image]")], metadata=False)
                else:
                    builder.add_note(
                        f"{ts} {tag}ASSISTANT {typ or 'block'}",
                        [json.dumps(block, ensure_ascii=False)],
                        metadata=False,
                    )
            if not blocks:
                text = ClaudeAgent.user_text(msg).strip()
                if text:
                    builder.add_text(ts, tag, text)
            if rec.get("error") or rec.get("apiErrorStatus"):
                builder.add_note(
                    f"{ts} {tag}API error",
                    [str(rec.get("error") or rec.get("apiErrorStatus"))],
                )
            continue
        if kind == "system":
            subtype = rec.get("subtype")
            if subtype == "turn_duration":
                continue
            content = rec.get("content")
            if subtype == "compact_boundary":
                body = [str(content)] if content else []
                meta = rec.get("compactMetadata")
                if isinstance(meta, dict) and meta:
                    body.append(json.dumps(meta, ensure_ascii=False))
                builder.add_note(f"{ts} {tag}context compacted", body or ["Conversation compacted"])
            elif content:
                level = rec.get("level") or "info"
                labels = {
                    "away_summary": "away summary",
                    "local_command": "command",
                    "informational": "warning" if level == "warning" else f"info ({level})",
                    "bridge_status": "bridge",
                }
                label = labels.get(subtype, f"system/{subtype}")
                if subtype == "local_command":
                    match = re.search(r"<command-name>([^<]+)</command-name>", str(content))
                    if match:
                        label = f"command {match.group(1)}"
                builder.add_note(f"{ts} {tag}{label}", str(content).splitlines())
            continue
        if kind == "attachment":
            attachment = rec.get("attachment")
            if (
                not isinstance(attachment, dict)
                or attachment.get("type") not in VIEW_ATTACHMENTS
            ):
                continue
            text = attachment_text(rec)
            if text:
                builder.add_note(
                    f"{ts} {tag}attachment: {attachment.get('type')}",
                    text.splitlines(),
                    category="attachment",
                    metadata=False,
                )
            continue
    flush_turn()
    render_model_inputs(view, inputs, missing_only=True, parts=set(options.normal_parts))
    view.layout()


def parse_arguments(raw) -> dict:
    """A Codex function_call's JSON arguments as a dict; anything else is kept as `arguments`."""
    if isinstance(raw, dict):
        return raw
    try:
        value = json.loads(raw or "{}")
    except (json.JSONDecodeError, TypeError):
        return {"arguments": raw}
    return value if isinstance(value, dict) else {"arguments": value}


def codex_reasoning(payload: dict) -> str:
    """Readable reasoning: summary parts, or raw reasoning content when Codex logs it."""
    parts = []
    for key in ("summary", "content"):
        for block in payload.get(key) or []:
            if isinstance(block, dict) and isinstance(block.get("text"), str):
                if block["text"].strip():
                    parts.append(block["text"].strip())
    return "\n\n".join(parts)


def codex_accumulations(records) -> dict[int, tuple[int, int]]:
    """Infer sends from real prompts and batches of tool results, ignoring event copies."""
    modern = any(CodexAgent.modern_prompt(rec) for rec in records)
    counter = Accumulation()
    in_results = False
    counts = {}
    for rec in records:
        payload = rec.get("payload") or {}
        kind = payload.get("type")
        user = CodexAgent.modern_prompt(rec) if modern else CodexAgent.old_prompt(rec)
        if user and not user.startswith("<turn_aborted>"):
            counter.advance(user=True)
            in_results = False
        elif rec.get("type") == "response_item":
            if kind in ("function_call_output", "custom_tool_call_output"):
                if not in_results:
                    counter.advance()
                in_results = True
            elif kind in ("message", "reasoning", "function_call", "custom_tool_call", "web_search_call"):
                in_results = False
        counts[id(rec)] = counter.counts
    return counts


def opencode_accumulations(messages) -> list[tuple[int, int]]:
    """Each assistant row is a response; another response extends the context."""
    counter = Accumulation()
    responded = False
    counts = []
    for typ, data in messages:
        if typ == "user" and (data.get("text") or "").strip() and content_source("user", data.get("text"), data) == "user":
            counter.advance(user=True)
            responded = False
        elif typ == "assistant" and data.get("content"):
            if responded:
                counter.advance()
            responded = True
        counts.append(counter.counts)
    return counts


def codex_model_inputs(records, counts):
    """Explicit input records only; never infer a request from generated output.

    A tool result is included when the log shows the following model response,
    before a new user turn. Event copies, usage, summaries, turn/session metadata
    and unverified re-sends of assistant output are excluded.
    """
    continued = set()
    response = False
    for rec in reversed(records):
        if response:
            continued.add(id(rec))
        payload = rec.get("payload") or {}
        if rec.get("type") != "response_item":
            continue
        kind = payload.get("type")
        if kind in ("reasoning", "function_call", "custom_tool_call", "web_search_call") or (
            kind == "message" and payload.get("role") == "assistant"
        ):
            response = True
        elif kind == "message" and payload.get("role") == "user" and CodexAgent.modern_prompt(rec):
            response = False
    modern = any(CodexAgent.modern_prompt(rec) for rec in records)
    inputs = []
    for index, rec in enumerate(records):
        payload = rec.get("payload") or {}
        kind = payload.get("type")
        role = None
        lines = []
        if rec.get("type") == "response_item":
            if kind == "message" and payload.get("role") in ("user", "system", "developer"):
                role = content_source(payload["role"], payload.get("content"), payload)
                lines = input_content_lines(payload.get("content"))
            elif kind in ("function_call_output", "custom_tool_call_output") and id(rec) in continued:
                role = "tool"
                lines = input_content_lines(payload.get("output"))
        elif not modern and CodexAgent.old_prompt(rec):
            role = "user"
            lines = input_content_lines(payload.get("message"))
        if role is not None and lines:
            source = f"model input; record [{index}]"
            if role == "tool":
                source += f" call_id={payload.get('call_id') or '?'}"
            elif payload.get("role") and role != payload["role"]:
                source += f" API role={payload['role']}; content source={role}"
            inputs.append(ModelInput(role, lines, record_ts(rec), counts[id(rec)], source))
    return inputs


def opencode_model_inputs(messages, counts):
    """User text and tool results consumed by a recorded continuation.

    System/log rows and generated summaries/replies do not prove API input.
    """
    continued = set()
    response = False
    for index in range(len(messages) - 1, -1, -1):
        typ, data = messages[index]
        if response:
            continued.add(index)
        if typ == "assistant" and data.get("content"):
            response = True
        elif typ == "user" and (data.get("text") or "").strip():
            response = False
    inputs = []
    for index, (typ, data) in enumerate(messages):
        ts = OpenCodeAgent.timestamp(data.get("time") or {})
        if typ == "user":
            lines = input_content_lines(data.get("text"))
            if lines:
                role = content_source("user", data.get("text"), data)
                inputs.append(ModelInput(role, lines, ts, counts[index],
                                         f"model input; API role=user; content source={role}; message [{index}]"))
        elif typ == "assistant" and index in continued:
            for part in data.get("content") or []:
                if not isinstance(part, dict) or part.get("type") != "tool":
                    continue
                state = part.get("state") or {}
                lines = input_content_lines(state.get("content"))
                if lines:
                    next_index = next(i for i in range(index + 1, len(messages))
                                      if messages[i][0] == "assistant" and messages[i][1].get("content"))
                    inputs.append(ModelInput("tool", lines, ts, counts[next_index],
                                             f"model input; tool={part.get('name') or '?'} message [{index}]"))
    return inputs


def codex_view(s: Session, view: "ViewBuilder", tmpdir: Path,
               options: ViewOptions | None = None) -> None:
    """Render a Codex rollout: prompts, reasoning summaries, tool calls and replies.

    A model response is one loop: its reasoning, message and calls until the
    following tool outputs. Codex logs each prompt and assistant message twice,
    as a model-visible response_item and an event_msg copy; one kind is used,
    never both."""
    records = list(read_jsonl(s.path))
    options = options or ViewOptions()
    counts = codex_accumulations(records)
    inputs = codex_model_inputs(records, counts)
    view.count_width = len(str(max((max(pair) for pair in counts.values()), default=0)))
    view_header(view, s)
    view.lines.extend([view_meta("累加按日志中的用户输入与工具结果批次推算；重复 event 不增加计数。"), ""])
    if options.raw:
        render_model_inputs(view, inputs)
        view.layout(raw=True)
        return
    parts = set(options.normal_parts)
    modern = any(CodexAgent.modern_prompt(rec) for rec in records)
    outputs: dict[str, str] = {}
    output_counts = {}
    for rec in records:
        payload = rec.get("payload") or {}
        if rec.get("type") != "response_item":
            continue
        if payload.get("type") in ("function_call_output", "custom_tool_call_output"):
            output = payload.get("output")
            if isinstance(payload.get("call_id"), str):
                output_counts[payload["call_id"]] = counts[id(rec)]
                outputs[payload["call_id"]] = (
                    output if isinstance(output, str) else json.dumps(output, ensure_ascii=False)
                )

    builder = TurnBuilder()
    response_open = False

    def begin_response(ts: str) -> None:
        nonlocal response_open
        if not response_open:
            builder.start_loop(ts)
            response_open = True

    def finish_turn() -> None:
        nonlocal response_open
        render_turn(view, builder.turn, tmpdir, parts=parts)
        builder.reset()
        response_open = False

    def new_user(ts: str, text: str) -> None:
        finish_turn()
        builder.set_user(ts, "", "USER", text)

    for rec in records:
        builder.counts = counts[id(rec)]
        payload = rec.get("payload") or {}
        kind = payload.get("type")
        ts = record_ts(rec)
        if rec.get("type") == "response_item":
            if kind in ("function_call_output", "custom_tool_call_output"):
                response_open = False  # the response is done; the next item starts a new loop
            elif kind == "message":
                role = payload.get("role")
                if role == "user":
                    text = CodexAgent.modern_prompt(rec)
                    # <turn_aborted> is injected context; event_msg reports the interrupt.
                    if text and not text.startswith("<turn_aborted>"):
                        new_user(ts, text)
                    elif not text:
                        context = "".join(
                            block.get("text", "") for block in payload.get("content") or []
                            if isinstance(block, dict) and block.get("type") == "input_text"
                        )
                        if context:
                            source = content_source("user", payload.get("content"), payload)
                            builder.add_note(f"{ts} {source.upper()} (API role=user)", context.splitlines(),
                                             category="system", metadata=False)
                elif role in ("system", "developer"):
                    context = "\n".join(
                        block.get("text", "") for block in payload.get("content") or []
                        if isinstance(block, dict) and isinstance(block.get("text"), str)
                    )
                    if context:
                        builder.add_note(f"{ts} {role.upper()}", context.splitlines(),
                                         category="system", metadata=False)
                elif role == "assistant":
                    text = "\n".join(
                        block.get("text", "")
                        for block in payload.get("content") or []
                        if isinstance(block, dict) and block.get("type") == "output_text"
                    ).strip()
                    if text:
                        begin_response(ts)
                        builder.add_text(ts, "", text)
            elif kind == "reasoning":
                for source, label in (("summary", "REASONING SUMMARY"), ("content", "THINKING")):
                    text = codex_reasoning({source: payload.get(source)})
                    if text:
                        begin_response(ts)
                        builder.add_thinking(ts, "", label, text, metadata=source == "summary")
            elif kind == "function_call":
                begin_response(ts)
                builder.add_call(
                    ts,
                    "",
                    payload.get("name") or "?",
                    parse_arguments(payload.get("arguments")),
                    outputs.get(payload.get("call_id")),
                    output_counts=output_counts.get(payload.get("call_id")),
                )
            elif kind == "custom_tool_call":
                begin_response(ts)
                builder.add_call(
                    ts, "", payload.get("name") or "?",
                    {"input": payload.get("input")}, outputs.get(payload.get("call_id")),
                    output_counts=output_counts.get(payload.get("call_id")),
                )
            elif kind == "web_search_call":
                begin_response(ts)
                action = payload.get("action")
                builder.add_call(
                    ts, "", "web_search", action if isinstance(action, dict) else {}, None
                )
        elif rec.get("type") == "event_msg":
            if kind == "user_message" and not modern:
                text = CodexAgent.old_prompt(rec)
                if text:
                    new_user(ts, text)
            elif kind == "turn_aborted":
                reason = payload.get("reason") or "interrupted"
                builder.add_note(f"{ts} user interrupted ({reason})", [])
            elif kind in ("error", "stream_error"):
                text = payload.get("message")
                if text:
                    builder.add_note(f"{ts} {kind.replace('_', ' ')}", str(text).splitlines())
    finish_turn()
    render_model_inputs(view, inputs, missing_only=True, parts=parts)
    view.layout()


def opencode_view(agent: "OpenCodeAgent", s: Session, view: "ViewBuilder", tmpdir: Path,
                  options: ViewOptions | None = None) -> None:
    """Render an OpenCode session: message text, reasoning and tool calls.

    One assistant message is one response loop. A tool part carries its own
    input and result, so no separate pairing pass is needed."""
    options = options or ViewOptions()
    messages = agent.messages(s)
    counts = opencode_accumulations(messages)
    inputs = opencode_model_inputs(messages, counts)
    view.count_width = len(str(max((max(pair) for pair in counts), default=0)))
    view_header(view, s)
    view.lines.extend([view_meta("累加按已记录的用户消息和后续 assistant 响应推算。"), ""])
    if options.raw:
        render_model_inputs(view, inputs)
        view.layout(raw=True)
        return
    parts = set(options.normal_parts)
    builder = TurnBuilder()
    for message_index, ((typ, data), pair) in enumerate(zip(messages, counts)):
        builder.counts = pair
        ts = OpenCodeAgent.timestamp(data.get("time") or {})
        if typ == "user":
            text = (data.get("text") or "").strip()
            if text:
                source = content_source("user", data.get("text"), data)
                if source != "user":
                    builder.add_note(f"{ts} {source.upper()} (API role=user)", text.splitlines(),
                                     category="system", metadata=False)
                    continue
                render_turn(view, builder.turn, tmpdir, parts=parts)
                builder.reset()
                builder.set_user(ts, "", "USER", text)
        elif typ == "assistant":
            content_parts = [part for part in data.get("content") or [] if isinstance(part, dict)]
            if not content_parts:
                continue
            builder.start_loop(ts)
            for part in content_parts:
                part_ts = OpenCodeAgent.timestamp(part.get("time") or {}) or ts
                kind = part.get("type")
                if kind == "reasoning":
                    text = (part.get("text") or "").strip()
                    if text:
                        builder.add_thinking(part_ts, "", "THINKING", text)
                elif kind == "text":
                    text = (part.get("text") or "").strip()
                    if text:
                        builder.add_text(part_ts, "", text)
                elif kind == "tool":
                    state = part.get("state") or {}
                    inp = state.get("input") if isinstance(state.get("input"), dict) else {}
                    failed = state.get("status") == "error"
                    if failed:
                        error = state.get("error")
                        output = error.get("message") if isinstance(error, dict) else None
                    else:
                        output = text_of(state.get("content"))
                    next_pair = next((counts[i] for i in range(message_index + 1, len(messages))
                                      if messages[i][0] in ("assistant", "user")), None)
                    builder.add_call(part_ts, "", part.get("name") or "?", inp, output, failed,
                                     output_counts=next_pair)
        elif typ == "compaction":
            summary = (data.get("summary") or "").strip()
            builder.add_note(
                f"{ts} context compacted ({data.get('reason') or 'auto'})",
                summary.splitlines() or [view_meta("(no summary)")],
                category="compaction",
                metadata=False,
            )
        elif typ == "system":
            text = (data.get("text") or "").strip()
            if text:
                builder.add_note(f"{ts} SYSTEM: {text_preview(text)}", text.splitlines(), category="system")
        # idle and synthetic records carry no conversation text
    render_turn(view, builder.turn, tmpdir, parts=parts)
    render_model_inputs(view, inputs, missing_only=True, parts=parts)
    view.layout()


def vim_viewer_script(folds: list[tuple[int, int]]) -> str:
    """Vimscript that folds each range and starts with every fold closed.

    Manual folds must be made innermost-first: creating an outer range first
    makes Vim raise that whole fold's level for each range nested in it."""
    setup = [
        "set nomodeline",
        "set mouse=a",
        "setlocal foldmethod=manual",
        "setlocal foldenable",
        "setlocal foldminlines=0",
        "setlocal foldcolumn=1",
        "setlocal foldtext=getline(v:foldstart)",
        "setlocal nobuflisted",
        "setlocal noswapfile",
        "setlocal wrap",
        "setlocal linebreak",
    ]
    create = [
        f"{start},{end}fold"
        for start, end in sorted(folds, key=lambda fold: fold[1] - fold[0])
    ]
    finish = [
        "normal! zM",
        "setlocal nomodifiable",
        "setlocal readonly",
        "nnoremap <buffer> <silent> <2-LeftMouse> za",
    ]
    return "\n".join(setup + create + finish) + "\n"


def view_session(s: Session, options: ViewOptions | None = None) -> None:
    """Render a session and open it in vim with every section folded."""
    options = options or ViewOptions()
    vim = shutil.which("vim") or shutil.which("nvim")
    if vim is None:
        print("vim not found; cannot open the viewer", file=sys.stderr)
        return
    tmpdir = Path(tempfile.mkdtemp(prefix="lmsessions-"))
    try:
        view = ViewBuilder()
        try:
            agent_of(s).view(s, view, tmpdir, options)
        except OSError as e:  # the transcript vanished or the spill file cannot be written
            print(f"Cannot read {s.path}: {e}", file=sys.stderr)
            return
        name = re.sub(r"[^\w.-]", "_", s.id)
        content = tmpdir / f"{name}.txt"
        content.write_text("\n".join(view.lines) + "\n", encoding="utf-8")
        script = tmpdir / "view.vim"
        script.write_text(vim_viewer_script(view.folds), encoding="utf-8")
        # Switch modelines off after the vimrc and before :edit, so a transcript
        # line that happens to look like one cannot run as an option command.
        try:
            subprocess.run(
                [
                    vim,
                    "-N",
                    "--cmd",
                    "set nomodeline",
                    "-c",
                    "set nomodeline",
                    "-c",
                    f"edit {content}",
                    "-S",
                    str(script),
                ]
            )
        except OSError as e:
            print(f"Cannot run {vim}: {e}", file=sys.stderr)
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)


def interactive_menu(cwd: Path | None) -> int:
    if not sys.stdin.isatty():
        print("The interactive menu needs a terminal; use 'lmsessions ls' to list sessions.", file=sys.stderr)
        return 1
    rows = all_sessions(cwd)
    if not rows:
        print(f"No sessions for {where(cwd)}")
        return 0
    cw = cwd_width(rows, cwd)
    marks: list[int] = []
    hits: dict[tuple[str, str], list[Hit]] | None = None
    filters: list[re.Pattern] = []
    history: list[tuple[
        list[Session], dict[tuple[str, str], list[Hit]] | None, int, list[re.Pattern], list[int],
        list[Session] | None,
    ]] = []
    focus: Session | None = None
    sort: tuple[str, bool] | None = None  # kept across pages: backing out restores the order
    base: list[Session] | None = None  # a submenu's sessions; None = every session for cwd
    view_options = ViewOptions()  # v's settings; the pre-vim menu edits them

    def rebuild_rows() -> list[Session]:
        """The page's sessions, in the order rows are shown now; unseen ones last.

        A fresh all_sessions() is oldest-first, so re-sorting it by key can put
        ties in a different order than the list the user was looking at."""
        seen = {(s.agent, s.id): i for i, s in enumerate(rows)}
        pool = all_sessions(cwd) if base is None else base
        return sorted(pool, key=lambda s: seen.get((s.agent, s.id), len(seen)))

    def prune_pages(gone: set[tuple[str, str]]) -> None:
        """Drop the removed sessions from the history pages; drop pages left empty.

        The stack survives a removal, so Esc still walks back through every
        search and submenu page that led here. Marks keep their sessions."""
        kept = []
        for hrows, page_hits, _, page_filters, page_marks, page_base in history:
            marked = {(hrows[i].agent, hrows[i].id) for i in page_marks}
            hrows = [s for s in hrows if (s.agent, s.id) not in gone]
            if not hrows:  # nothing left to show on that page
                continue
            kept.append((
                hrows,
                None if page_hits is None else {
                    k: v for k, v in page_hits.items() if k not in gone
                },
                cwd_width(hrows, cwd),
                page_filters,
                [i for i, s in enumerate(hrows) if (s.agent, s.id) in marked],
                None if page_base is None else [
                    s for s in page_base if (s.agent, s.id) not in gone
                ],
            ))
        history[:] = kept

    while True:
        result = pick_sessions(rows, cw, marks, hits, focus, sort, can_back=base is not None)
        if result is None:
            print("Cancelled.")
            return 0
        kind, payload, focus, sort = result
        if kind == "back":  # Esc on a search or submenu page: back to the page opened from
            if history:
                rows, hits, cw, filters, marks, base = history.pop()
            else:  # no page left: back to the whole list, with filters and submenu scope dropped
                base = None
                rows = rebuild_rows()
                hits, filters, marks = None, [], []
                cw = cwd_width(rows, cwd)
                if not rows:
                    print(f"No sessions left for {where(cwd)}")
                    return 0
            continue
        if kind == "submenu":  # Enter with several marked: a menu of just those rows
            history.append((rows, hits, cw, list(filters), list(marks), base))
            base = list(payload)
            rows, hits, filters, marks = list(base), None, [], []
            cw = cwd_width(rows, cwd)
            continue
        if kind == "search":
            try:
                rx = re.compile(payload, re.IGNORECASE)
            except re.error as e:
                print(f"Bad pattern {payload!r}: {e}")
                continue
            found = [(s, h) for s in rows if (h := find_hits(s, rx))]
            if not found:
                print(f"No sessions match: {payload}")
                continue
            history.append((rows, hits, cw, list(filters), list(marks), base))
            filters = filters + [rx]
            rows = [s for s, _ in found]
            hits = {(s.agent, s.id): h for s, h in found}
            cw = cwd_width(rows, cwd)
            marks = []
            continue
        if kind == "view":
            changed = edit_view_options(view_options, payload.agent)
            if changed is None:  # Esc at the menu: back to the picker
                continue
            view_options = changed
            view_session(payload, view_options)
            continue
        if isinstance(payload, Session):
            return resume_session(payload)
        targets = [rows[i] for i in sorted(payload)] or [focus]
        blocked = next((s for s in targets if not agent_of(s).removable), None)
        if blocked:
            print(f"Removing {blocked.agent} sessions is not supported yet.")
            continue
        result = confirm_remove(targets, cwd)
        if result == "back":
            marks = payload  # Esc at the confirmation: back to the picker, selection kept
            continue
        # Removed: pick again from what is left instead of exiting.
        gone = {(s.agent, s.id) for s in targets}
        if base is not None:  # a submenu keeps its scope: drop what was just removed
            base = [s for s in base if (s.agent, s.id) not in gone]
        prune_pages(gone)  # Esc still walks back up through the stack
        here = next((i for i, s in enumerate(rows) if s is focus), 0)  # keep the highlight's row
        rows = [s for s in rebuild_rows() if all(find_hits(s, rx) for rx in filters)]
        hits = (
            {(s.agent, s.id): find_hits(s, filters[-1]) for s in rows} if filters else None
        )
        if not rows:
            if history:  # this page emptied: the page it came from still has sessions
                rows, hits, cw, filters, marks, base = history.pop()
                continue
            print("No matching sessions left." if filters else f"No sessions left for {where(cwd)}")
            return 0
        cw = cwd_width(rows, cwd)
        marks = []
        focus = rows[min(here, len(rows) - 1)]


def sql_name(name: str) -> str:
    return '"' + name.replace('"', '""') + '"'


def remote_destination(value: str):
    """scp-style host:path or ssh://user@host:port/path; local paths stay local."""
    if value.startswith("ssh://"):
        parsed = urlparse(value)
        if parsed.password is not None or not parsed.hostname or not parsed.path:
            raise ValueError("Use ssh://[user@]host[:port]/directory")
        host = parsed.hostname
        if ":" in host:
            host = f"[{host}]"
        host = (unquote(parsed.username) + "@" if parsed.username else "") + host
        port, directory = parsed.port, unquote(parsed.path)
    else:
        match = re.fullmatch(r"((?:[^/@\s:]+@)?\[[^\]]+\]|[^/\s:\[\]]+):(.+)", value)
        if not match:
            return None
        host, directory = match.groups()
        port = None
    if host.startswith("-") or not re.fullmatch(r"[\w.@\[\]:-]+", host):
        raise ValueError("Invalid SSH host")
    return host, port, directory


def encoded_sql(value):
    return {"bytes": base64.b64encode(value).decode()} if isinstance(value, bytes) else value


def decoded_sql(value):
    return base64.b64decode(value["bytes"], validate=True) if isinstance(value, dict) else value


def session_database(agent, session):
    """Export one session's rows, owned children and referenced shared metadata.

    Never ship an entire state database containing unrelated conversations.
    Shared dependencies (e.g. OpenCode projects) do not expand into sibling
    sessions. All reads use one SQLite snapshot.
    """
    root, key, ownership = {
        "codex": ("threads", "id", ("thread_id", "parent_thread_id", "child_thread_id")),
        "opencode": ("session_v2", "id", ("session_id",)),
        "agy": ("conversation_summaries", "conversation_id", ()),
    }[agent.name]
    conn = sqlite3.connect(agent.db.resolve().as_uri() + "?mode=ro", uri=True)
    try:
        conn.execute("BEGIN")
        schemas = dict(conn.execute("SELECT name, sql FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%' AND sql IS NOT NULL"))
        columns = {t: [r[1] for r in conn.execute(f"PRAGMA table_info({sql_name(t)})")] for t in schemas}
        relations = {}
        for table in schemas:
            groups = {}
            for fk in conn.execute(f"PRAGMA foreign_key_list({sql_name(table)})"):
                groups.setdefault((fk[0], fk[2]), []).append((fk[1], fk[3], fk[4]))
            relations[table] = [(parent, sorted(fields)) for (_, parent), fields in groups.items()]
        rows = {t: {} for t in schemas}

        def fetch(table, names, values, owned):
            if table not in columns or any(v is None for v in values):
                return
            query = ("SELECT " + ",".join(map(sql_name, columns[table])) + " FROM " + sql_name(table)
                     + " WHERE " + " AND ".join(sql_name(n) + " = ?" for n in names))
            for values in conn.execute(query, values):
                encoded = [encoded_sql(v) for v in values]
                identity = json.dumps(encoded, sort_keys=True)
                previous = rows[table].get(identity)
                rows[table][identity] = {"values": encoded, "owned": owned or bool(previous and previous["owned"])}

        fetch(root, [key], [session.id], True)
        if not rows[root]:
            raise ValueError("Session no longer exists")
        for table in schemas:
            if "migration" in table.lower() or table.lower() in ("alembic_version", "schema_version"):
                for values in conn.execute("SELECT " + ",".join(map(sql_name, columns[table])) + " FROM " + sql_name(table)):
                    encoded = [encoded_sql(v) for v in values]
                    rows[table][json.dumps(encoded, sort_keys=True)] = {"values": encoded, "owned": False}
            for column in ownership:
                if column in columns[table]:
                    fetch(table, [column], [session.id], True)
        # Follow child FKs only from owned rows, then follow parent dependencies.
        for children in (True, False):
            while True:
                before = sum(len(v) for v in rows.values())
                for child, links in relations.items():
                    for parent, fields in links:
                        if parent not in columns or any(not target for _, _, target in fields):
                            continue
                        if children:
                            if child == root:
                                continue
                            for row in list(rows[parent].values()):
                                if row["owned"]:
                                    values = [decoded_sql(row["values"][columns[parent].index(target)]) for _, _, target in fields]
                                    fetch(child, [name for _, name, _ in fields], values, True)
                        elif parent != root:
                            for row in list(rows[child].values()):
                                values = [decoded_sql(row["values"][columns[child].index(name)]) for _, name, _ in fields]
                                fetch(parent, [target for _, _, target in fields], values, False)
                if sum(len(v) for v in rows.values()) == before:
                    break
        objects = list(conn.execute("SELECT name, sql FROM sqlite_master WHERE type IN ('index','trigger','view') AND sql IS NOT NULL"))
        return {"root": root, "key": key, "schemas": schemas, "objects": objects,
                "user_version": conn.execute("PRAGMA user_version").fetchone()[0],
                "tables": {t: {"columns": columns[t], "rows": list(values.values())} for t, values in rows.items() if values}}
    finally:
        conn.close()


def session_export(session):
    agent = agent_of(session)
    result = {"agent": agent.name, "id": session.id, "cwd": session.cwd, "files": []}

    def file(path, slot, relative, database=False):
        if path.is_symlink():
            raise ValueError(f"Cannot migrate a symlink: {path}")
        stamp = path.stat()
        if database:
            with tempfile.TemporaryDirectory(prefix="lmsessions-snapshot-") as tmp:
                snapshot = Path(tmp) / "conversation.db"
                source = sqlite3.connect(path.resolve().as_uri() + "?mode=ro", uri=True)
                dest = sqlite3.connect(snapshot)
                try:
                    source.backup(dest)
                finally:
                    dest.close()
                    source.close()
                data = snapshot.read_bytes()
        else:
            data = path.read_bytes()
            current = path.stat()
            if (stamp.st_size, stamp.st_mtime_ns) != (current.st_size, current.st_mtime_ns):
                raise ValueError(f"Session file changed during export: {path}")
        result["files"].append({"slot": slot, "path": relative, "data": base64.b64encode(data).decode(),
                                "mode": stamp.st_mode & 0o777, "mtime_ns": stamp.st_mtime_ns})

    def tree(path, slot, prefix=""):
        if path.is_symlink():
            raise ValueError(f"Cannot migrate a symlink: {path}")
        if path.exists():
            for child in sorted(path.rglob("*")):
                if child.is_symlink():
                    raise ValueError(f"Cannot migrate a symlink: {child}")
                if child.is_file():
                    file(child, slot, prefix + child.relative_to(path).as_posix())

    if agent.name == "claude":
        file(session.path, "claude", session.id + ".jsonl")
        tree(session.path.parent / session.id, "claude", session.id + "/")
    else:
        result["database"] = session_database(agent, session)
        if agent.name == "codex":
            file(session.path, "rollout", "rollout.jsonl" + (".zst" if session.path.suffix == ".zst" else ""))
        elif agent.name == "agy":
            tree(agent.brain / session.id, "brain")
            conversation = agent.conversations / (session.id + ".db")
            if conversation.exists():
                file(conversation, "conversation", session.id + ".db", database=True)
            annotation = agent.home / "annotations" / (session.id + ".pbtxt")
            if annotation.exists():
                file(annotation, "annotation", annotation.name)
    return result


def export_digest(packet):
    return hashlib.sha256(json.dumps(packet, sort_keys=True, separators=(",", ":")).encode()).hexdigest()


def receive_sessions(payload):
    """SSH receiver: stage files, import native rows without overwriting sessions.

    Source deletion is exclusively the sender's responsibility after it checks
    this receipt. On a lost connection the sender retains its original data.
    """
    directory = Path(payload["directory"]).expanduser().resolve(strict=True)
    if not directory.is_dir():
        raise ValueError(f"Not a remote directory: {directory}")
    agents = {a.name: a for a in AGENTS}
    connections = {}
    created_databases = {}
    committed_databases = set()
    installed = []
    committed = False
    ids = set()
    imported = []
    try:
        for packet in payload["sessions"]:
            name, sid = packet["agent"], packet["id"]
            if not sid or sid in (".", "..") or "/" in sid or "\\" in sid or "\0" in sid:
                raise ValueError("Invalid session ID")
            if (name, sid) in ids:
                raise ValueError(f"Duplicate incoming session: {name}:{sid}")
            ids.add((name, sid))
            agent = agents[name]
            if name == "claude":
                projects = Path.home() / ".claude" / "projects"
                if any(projects.glob(f"*/{sid}.jsonl")):
                    raise ValueError(f"Remote session already exists: {name}:{sid}")
                roots = {"claude": projects / agent.project_name(directory)}
                main_path = roots["claude"] / (sid + ".jsonl")
            else:
                database = packet["database"]
                if name not in connections:
                    agent.db.parent.mkdir(parents=True, exist_ok=True)
                    fresh = not agent.db.exists()
                    if fresh:
                        created_databases[name] = agent.db
                    conn = sqlite3.connect(agent.db, timeout=10)
                    connections[name] = conn
                    conn.execute("PRAGMA foreign_keys = OFF")
                    conn.execute("BEGIN IMMEDIATE")
                    existing = {r[0] for r in conn.execute("SELECT name FROM sqlite_master WHERE type='table'")}
                    for table, ddl in database["schemas"].items():
                        if table not in existing:
                            conn.execute(ddl)
                            existing = {r[0] for r in conn.execute("SELECT name FROM sqlite_master WHERE type='table'")}
                    if fresh:
                        conn.execute(f"PRAGMA user_version = {int(database['user_version'])}")
                conn = connections[name]
                root, key = database["root"], database["key"]
                if conn.execute(f"SELECT 1 FROM {sql_name(root)} WHERE {sql_name(key)} = ?", (sid,)).fetchone():
                    raise ValueError(f"Remote session already exists: {name}:{sid}")
                # Session/message UUIDs keep their identity. Local integer row
                # IDs (notably Codex logs) can overlap on different machines;
                # remap collisions together with their declared child FKs.
                primary = {}
                remaps = {}
                for table, data in database["tables"].items():
                    info = list(conn.execute(f"PRAGMA table_info({sql_name(table)})"))
                    keys = [r for r in info if r[5]]
                    if table == root or len(keys) != 1 or keys[0][2].upper() not in ("INTEGER", "TEXT"):
                        continue
                    column = keys[0][1]
                    primary[table] = column
                    offset = data["columns"].index(column)
                    incoming = [row["values"][offset] for row in data["rows"] if row["owned"]]
                    integer = keys[0][2].upper() == "INTEGER"
                    incoming = [v for v in incoming if isinstance(v, int if integer else str)]
                    highest = 0
                    if integer:
                        highest = conn.execute(f"SELECT MAX({sql_name(column)}) FROM {sql_name(table)}").fetchone()[0] or 0
                        highest = max([highest] + incoming)
                    for value in incoming:
                        if conn.execute(f"SELECT 1 FROM {sql_name(table)} WHERE {sql_name(column)} = ?", (value,)).fetchone():
                            highest += 1
                            replacement = highest if integer else ((value.split("_", 1)[0] + "_" + uuid.uuid4().hex) if "_" in value else str(uuid.uuid4()))
                            remaps.setdefault(table, {})[value] = replacement
                if name == "codex":
                    roots = {"rollout": agent.db.parent / "sessions" / "imported" / sid}
                    main_path = roots["rollout"] / packet["files"][0]["path"]
                elif name == "opencode":
                    roots, main_path = {}, agent.db
                else:
                    roots = {"brain": agent.brain / sid, "conversation": agent.conversations,
                             "annotation": agent.home / "annotations"}
                    main_path = agent.log_path(sid)
                # Insert only exported session rows and shared dependencies.
                for table, data in database["tables"].items():
                    target_columns = {r[1] for r in conn.execute(f"PRAGMA table_info({sql_name(table)})")}
                    if not set(data["columns"]) <= target_columns:
                        raise ValueError(f"Incompatible remote schema: {name}.{table}")
                    for row in data["rows"]:
                        values = dict(zip(data["columns"], map(decoded_sql, row["values"])))
                        original_values = dict(values)
                        if row["owned"] and table in remaps:
                            column = primary[table]
                            values[column] = remaps[table].get(values[column], values[column])
                        for fk in conn.execute(f"PRAGMA foreign_key_list({sql_name(table)})"):
                            parent, column, target = fk[2], fk[3], fk[4]
                            if parent in remaps and (not target or target == primary[parent]) and column in values:
                                values[column] = remaps[parent].get(values[column], values[column])
                        replacements = {original_values[c]: v for c, v in values.items()
                                        if isinstance(original_values[c], (str, int)) and original_values[c] != v}
                        if replacements and isinstance(values.get("data"), str):
                            def identities(value):
                                if isinstance(value, dict):
                                    for field, content in value.items():
                                        if field in ("id", "messageID", "messageId", "message_id", "partID", "part_id", "log_id", "parentID", "parent_id") and isinstance(content, (str, int)):
                                            value[field] = replacements.get(content, content)
                                        elif field not in ("text", "input", "arguments", "output", "thinking"):
                                            identities(content)
                                elif isinstance(value, list):
                                    for content in value:
                                        identities(content)
                            try:
                                content = json.loads(values["data"])
                            except ValueError:
                                pass
                            else:
                                identities(content)
                                values["data"] = json.dumps(content, ensure_ascii=False)
                        if table == root:
                            if name == "codex":
                                values.update(cwd=str(directory), rollout_path=str(main_path))
                            elif name == "opencode":
                                values["directory"] = str(directory)
                            else:
                                uris = json.loads(values.get("workspace_uris") or "[]")
                                values["workspace_uris"] = json.dumps([directory.as_uri()] + uris[1:])
                        verb = "INSERT" if row["owned"] else "INSERT OR IGNORE"
                        conn.execute(verb + " INTO " + sql_name(table) + " (" + ",".join(map(sql_name, values))
                                     + ") VALUES (" + ",".join("?" for _ in values) + ")", tuple(values.values()))
            # Stage beside each destination, so exclusive hard-link installation
            # is atomic even when agent data and /tmp are different filesystems.
            for item in packet["files"]:
                relative = Path(item["path"])
                if relative.is_absolute() or ".." in relative.parts or "\0" in item["path"]:
                    raise ValueError("Invalid incoming file path")
                if name == "claude" and not (relative.parts[0] == sid or item["path"] == sid + ".jsonl"):
                    raise ValueError("Invalid Claude session file")
                dest = roots[item["slot"]] / relative
                dest.parent.mkdir(parents=True, exist_ok=True)
                fd, tmp = tempfile.mkstemp(prefix=".session-import-", dir=dest.parent)
                staged = Path(tmp)
                try:
                    with os.fdopen(fd, "wb") as stream:
                        stream.write(base64.b64decode(item["data"], validate=True))
                    os.chmod(staged, item["mode"] & 0o777)
                    os.utime(staged, ns=(item["mtime_ns"], item["mtime_ns"]))
                    if name == "claude" and dest == main_path:
                        agent.move(Session(name, sid, 0, 0, 0, "", staged, ""), directory)
                    os.link(staged, dest)  # Refuse to overwrite any remote file.
                    installed.append(dest)
                finally:
                    staged.unlink(missing_ok=True)
            imported.append((name, sid))
        # Add schema objects after inserting data; do not fire source triggers
        # retroactively or replace objects installed by another agent version.
        for packet in payload["sessions"]:
            name = packet["agent"]
            if name == "claude":
                continue
            conn = connections[name]
            existing = {r[0] for r in conn.execute("SELECT name FROM sqlite_master")}
            for obj_name, ddl in packet["database"]["objects"]:
                if obj_name not in existing:
                    conn.execute(ddl)
                    existing.add(obj_name)
        for name, conn in connections.items():
            conn.commit()
            committed = True
            committed_databases.add(name)
        visible = {(s.agent, s.id) for s in all_sessions(directory)}
        if not set(imported) <= visible:
            raise ValueError("Remote import did not appear in destination session listing")
        return {"receipts": [export_digest(packet) for packet in payload["sessions"]], "directory": str(directory)}
    except BaseException:
        for conn in connections.values():
            conn.rollback()
        # A post-commit failure can leave a valid remote copy; retain it and
        # keep the sender's source intact rather than removing committed data.
        if not committed:
            for path in reversed(installed):
                path.unlink(missing_ok=True)
        raise
    finally:
        for conn in connections.values():
            conn.close()
        for name, path in created_databases.items():
            if name not in committed_databases:
                for suffix in ("", "-wal", "-shm", "-journal"):
                    Path(str(path) + suffix).unlink(missing_ok=True)


def remove_exported_session(session, packet):
    """Delete only the acknowledged snapshot, keeping shared metadata intact."""
    agent = agent_of(session)
    if session.agent == "claude":
        if export_digest(session_export(session)) != export_digest(packet):
            raise ValueError(f"{session.id} changed during transfer; source retained")
        session.path.unlink()
        companion = session.path.parent / session.id
        if companion.exists():
            shutil.rmtree(companion)
        return
    conn = sqlite3.connect(agent.db, timeout=10)
    try:
        conn.execute("BEGIN IMMEDIATE")
        if export_digest(session_export(session)) != export_digest(packet):
            raise ValueError(f"{session.id} changed during transfer; source retained")
        for table, data in reversed(list(packet["database"]["tables"].items())):
            primary = [r[1] for r in sorted(conn.execute(f"PRAGMA table_info({sql_name(table)})"), key=lambda r: r[5]) if r[5]]
            for row in data["rows"]:
                if row["owned"]:
                    values = dict(zip(data["columns"], map(decoded_sql, row["values"])))
                    keys = primary or data["columns"]
                    conn.execute("DELETE FROM " + sql_name(table) + " WHERE "
                                 + " AND ".join(sql_name(c) + " IS ?" for c in keys),
                                 tuple(values[c] for c in keys))
        database = packet["database"]
        if conn.execute(f"SELECT 1 FROM {sql_name(database['root'])} WHERE {sql_name(database['key'])} = ?", (session.id,)).fetchone():
            raise ValueError("Source deletion did not complete; transaction rolled back")
        conn.commit()
    finally:
        conn.close()
    if session.agent == "codex":
        session.path.unlink(missing_ok=True)
    elif session.agent == "agy":
        if (agent.brain / session.id).exists():
            shutil.rmtree(agent.brain / session.id)
        for suffix in (".db", ".db-shm", ".db-wal"):
            (agent.conversations / (session.id + suffix)).unlink(missing_ok=True)
        (agent.home / "annotations" / (session.id + ".pbtxt")).unlink(missing_ok=True)


def clone_session(packet):
    """Allocate a local copy's identity without altering prompt/body text."""
    cloned = copy.deepcopy(packet)
    old = packet["id"]
    new = ("ses_" + uuid.uuid4().hex) if old.startswith("ses_") else str(uuid.uuid4())
    cloned["id"] = new
    names = {"session_id", "sessionId", "sessionID", "parentSessionId", "parent_session_id",
             "thread_id", "parent_thread_id", "child_thread_id", "conversation_id", "conversationId"}

    def metadata(value):
        if isinstance(value, dict):
            for key, item in value.items():
                if key in names and item == old:
                    value[key] = new
                elif key not in ("message", "content", "input", "arguments", "output", "text", "thinking") and isinstance(item, (dict, list)):
                    metadata(item)
            if value.get("type") == "session_meta" and isinstance(value.get("payload"), dict):
                if value["payload"].get("id") == old:
                    value["payload"]["id"] = new
        elif isinstance(value, list):
            for item in value:
                metadata(item)

    if "database" in cloned:
        db = cloned["database"]
        for table, data in db["tables"].items():
            for row in data["rows"]:
                if not row["owned"]:
                    continue
                for i, column in enumerate(data["columns"]):
                    value = row["values"][i]
                    if (column in names or (table == db["root"] and column == db["key"])) and value == old:
                        row["values"][i] = new
                    elif column == "data" and isinstance(value, str):
                        try:
                            content = json.loads(value)
                        except ValueError:
                            continue
                        metadata(content)
                        row["values"][i] = json.dumps(content, ensure_ascii=False)
    for item in cloned["files"]:
        item["path"] = "/".join(new + part[len(old):] if part == old or part.startswith(old + ".")
                                  else part for part in item["path"].split("/"))
        data = base64.b64decode(item["data"])
        compressed = item["path"].endswith(".jsonl.zst")
        if item["path"].endswith(".jsonl") or compressed:
            if compressed:
                if zstd is None:
                    raise ValueError("Copying a compressed Codex rollout requires zstd support")
                data = zstd.decompress(data)
            lines = []
            for line in data.splitlines(keepends=True):
                try:
                    record = json.loads(line)
                except (ValueError, UnicodeDecodeError):
                    lines.append(line)
                    continue
                metadata(record)
                lines.append((json.dumps(record, ensure_ascii=False) + "\n").encode())
            data = b"".join(lines)
            if compressed:
                data = zstd.compress(data)
        elif item["slot"] == "conversation":
            with tempfile.TemporaryDirectory(prefix="lmsessions-clone-") as tmp:
                path = Path(tmp) / "conversation.db"
                path.write_bytes(data)
                with sqlite3.connect(path) as conn:
                    for (table,) in conn.execute("SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'").fetchall():
                        for column in conn.execute(f"PRAGMA table_info({sql_name(table)})").fetchall():
                            if column[1] in names or column[1] == "id":
                                conn.execute(f"UPDATE {sql_name(table)} SET {sql_name(column[1])} = ? WHERE {sql_name(column[1])} = ?", (new, old))
                data = path.read_bytes()
        item["data"] = base64.b64encode(data).decode()
    return cloned


def move_remote(selected, destination, keep_source=False):
    host, port, directory = destination
    packets = [session_export(session) for session in selected]
    bootstrap = (
        "import json,sys; bundle=json.load(sys.stdin); ns={'__name__':'lmsessions_receiver'}; "
        "exec(compile(bundle['program'],'<lmsessions>','exec'),ns); "
        "print(json.dumps(ns['receive_sessions'](bundle['payload'])))"
    )
    command = ["ssh"] + (["-p", str(port)] if port else [])
    ssh_host = re.sub(r"^(.*@)?\[([^\]]+)\]$", lambda m: (m[1] or "") + m[2], host)
    command += ["--", ssh_host, "python3 -c " + shlex.quote(bootstrap)]
    bundle = {"program": Path(__file__).read_text(), "payload": {"directory": directory, "sessions": packets}}
    result = subprocess.run(command, input=json.dumps(bundle).encode(), stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if result.returncode:
        raise ValueError("Remote import failed; source sessions retained.\n" + result.stderr.decode(errors="replace").strip())
    try:
        receipt = json.loads(result.stdout)
    except ValueError:
        raise ValueError("Invalid remote receipt; source sessions retained") from None
    if not isinstance(receipt, dict) or receipt.get("receipts") != [export_digest(packet) for packet in packets]:
        raise ValueError("Invalid remote receipt; source sessions retained")
    if not keep_source:
        for session, packet in zip(selected, packets):
            if export_digest(session_export(session)) != export_digest(packet):
                raise ValueError(f"{session.agent}:{session.id} changed during transfer; source retained")
        for session, packet in zip(selected, packets):
            remove_exported_session(session, packet)
    action = "Copied" if keep_source else "Moved"
    print(f"{action} {len(selected)} session(s) to {host}:{receipt['directory']}")
    return 0


def move_sessions(source: str, directory, keep_source=False) -> int:
    """Reassign an exact session ID, or every session in one source directory."""
    try:
        remote = remote_destination(str(directory))
        if remote is None:
            directory = Path(directory).expanduser().resolve(strict=True)
            if not directory.is_dir():
                raise ValueError(f"Not a directory: {directory}")
        source_path = Path(source).expanduser()
        source_dir = source_path.resolve() if source_path.is_dir() else None
        sessions = all_sessions(None)
        if source_dir is not None:
            selected = [s for s in sessions if s.cwd and os.path.realpath(s.cwd) == str(source_dir)]
        else:
            agent, sep, sid = source.partition(":")
            if sep:
                selected = [s for s in sessions if s.agent == agent and s.id == sid]
            else:
                selected = [s for s in sessions if s.id == source]
            if len(selected) > 1:
                raise ValueError("Ambiguous session ID; use agent:session-id (" +
                                 ", ".join(f"{s.agent}:{s.id}" for s in selected) + ")")
        if not selected:
            raise ValueError(f"No sessions found for {source}")
        if remote is not None:
            return move_remote(selected, remote, keep_source)
        if keep_source:
            packets = [clone_session(session_export(session)) for session in selected]
            receive_sessions({"directory": str(directory), "sessions": packets})
            for session, packet in zip(selected, packets):
                print(f"Copied {session.agent}:{session.id} -> {packet['id']} ({directory})")
            return 0
    except (OSError, ValueError, sqlite3.Error) as e:
        print(f"Cannot move sessions: {e}", file=sys.stderr)
        return 1
    moved = unchanged = failed = 0
    for session in selected:
        if session.cwd and os.path.realpath(session.cwd) == str(directory):
            unchanged += 1
            continue
        try:
            agent_of(session).move(session, directory)
            moved += 1
        except (OSError, ValueError, sqlite3.Error) as e:
            failed += 1
            print(f"Cannot move {session.agent}:{session.id}: {e}", file=sys.stderr)
    print(f"Moved {moved} session(s) to {directory} ({unchanged} already there, {failed} failed)")
    return 1 if failed else 0


def main() -> int:
    parser = argparse.ArgumentParser(
        description="List, search, remove or resume "
        + "/".join(a.name for a in AGENTS)
        + " sessions; with no arguments, open the interactive menu "
        "(ls lists them; -a covers every directory).",
    )
    parser.add_argument(
        "-a",
        "--all",
        action="store_true",
        help="apply to sessions in every directory, not just $PWD",
    )
    commands = parser.add_subparsers(dest="command")
    listing = commands.add_parser("ls", help="list sessions for $PWD")
    listing.add_argument("-a", "--all", action="store_true", default=argparse.SUPPRESS,
                         help="list sessions in every directory")
    for name in ("mv", "cp"):
        transfer = commands.add_parser(name, help="move session workspaces" if name == "mv" else "copy sessions")
        transfer.add_argument("source", help="exact session ID (or agent:ID), or a source directory")
        transfer.add_argument("directory", nargs="?", default=str(Path.cwd()),
                              help="directory, [user@]host:path or ssh://[user@]host[:port]/path (default: current directory)")
        if name == "mv":
            transfer.add_argument("--keep-source", action="store_true", help="copy sessions (alias for cp)")
    args = parser.parse_args()
    if args.command in ("mv", "cp"):
        if args.all:
            parser.error("mv/cp cannot be combined with -a/--all")
        return move_sessions(args.source, args.directory, args.command == "cp" or args.keep_source)
    cwd = None if args.all else Path(os.getcwd()).resolve()
    return list_sessions(cwd) if args.command == "ls" else interactive_menu(cwd)


if __name__ == "__main__":
    sys.exit(main())
